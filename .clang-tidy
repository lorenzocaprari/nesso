---
# Disabled checks:
# Alias de-dup (primary stays enabled via another glob — do not delete these
# unless you also intend to turn the primary off):
#   -cppcoreguidelines-avoid-c-arrays              -> modernize-avoid-c-arrays
#   -cppcoreguidelines-avoid-magic-numbers        -> readability-magic-numbers (also listed)
#   -cppcoreguidelines-c-copy-assignment-signature -> misc-unconventional-assign-operator
#   -cppcoreguidelines-explicit-virtual-functions -> modernize-use-override
#   -cppcoreguidelines-macro-to-enum              -> modernize-macro-to-enum
#   -cppcoreguidelines-narrowing-conversions      -> bugprone-narrowing-conversions
#   -cppcoreguidelines-noexcept-destructor        -> performance-noexcept-destructor
#   -cppcoreguidelines-noexcept-move-operations   -> performance-noexcept-move-constructor
#   -cppcoreguidelines-noexcept-swap              -> performance-noexcept-swap
#   -cppcoreguidelines-non-private-member-variables-in-classes
#                                                 -> misc-non-private-member-variables-in-classes
#   -cppcoreguidelines-use-default-member-init    -> modernize-use-default-member-init
#   -google-readability-function-size             -> readability-function-size
#   -llvm-else-after-return                       -> readability-else-after-return
#   -llvm-qualified-auto                          -> readability-qualified-auto
# Policy / style (no primary elsewhere):
#   -google-readability-braces-around-statements  (fights clang-format Allman)
#   -google-readability-namespace-comments        (Google } // namespace style)
#   -llvm-header-guard                            (custom NESSO_*/PLATFORM_* guards)
#   -misc-use-anonymous-namespace                 (prefer static; see misc-use-internal-linkage)
# Enabled (not disabled): misc-include-cleaner
#   android-cloexec-*                             (POSIX O_CLOEXEC on open/pipe/fopen/socket)
#   modernize-use-trailing-return-type            (via modernize-*; classical returns are trailing)
#   -readability-magic-numbers                    (CLI/embed/scoring constants)
# clang-tidy 23 removed the hicpp module. The five names this file used to
# enable are gone; each replacement stays enabled through an existing glob,
# so the check is not dropped:
#   hicpp-exception-baseclass     -> bugprone-std-exception-baseclass     (bugprone-*)
#   hicpp-ignored-remove-result   -> bugprone-unused-return-value         (bugprone-*)
#   hicpp-multiway-paths-covered  -> bugprone-unhandled-code-paths        (bugprone-*)
#                                 -> readability-trivial-switch           (readability-*)
#   hicpp-no-assembler            -> portability-no-assembler              (portability-*)
#   hicpp-signed-bitwise          -> bugprone-signed-bitwise              (bugprone-*)
# clang-tidy 22 kept these cert names as aliases of checks the globs already
# enable. The alias names stay listed. Neither name is disabled:
#   cert-dcl50-cpp -> modernize-avoid-variadic-functions
#   cert-dcl58-cpp -> bugprone-std-namespace-modification
#   cert-env33-c   -> bugprone-command-processor
#   cert-err34-c   -> bugprone-unchecked-string-to-number-conversion
#   cert-err52-cpp -> modernize-avoid-setjmp-longjmp
#   cert-err58-cpp -> bugprone-throwing-static-initialization
#   cert-err60-cpp -> bugprone-exception-copy-constructor-throws
#   cert-flp30-c   -> bugprone-float-loop-counter
#   cert-mem57-cpp -> bugprone-default-operator-new-on-overaligned-type
#   cert-msc50-cpp -> misc-predictable-rand
#   cert-msc51-cpp -> bugprone-random-generator-seed
#   cert-oop57-cpp -> bugprone-raw-memory-call-on-non-trivial-type
#   cert-oop58-cpp -> bugprone-copy-constructor-mutates-argument
# clang-tidy 23 also keeps aliases (not disabled): cppcoreguidelines-explicit-constructor
# and google-explicit-constructor -> misc-explicit-constructor; performance-faster-string-find
# -> performance-prefer-single-char-overloads. New bugprone/modernize/performance/readability
# checks from 22 and 23 stay on through those globs, except:
#   -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access
#       New in clang-tidy 22. Flags every operator[]. Indexes here are already
#       bounded; .at() would throw, which these paths do not use.
#   -readability-trailing-comma
#       New in clang-tidy 23. clang-format is LLVM style and does not insert
#       trailing commas.
#   -llvm-use-ranges
#       New in clang-tidy 22. Suggests llvm:: range algorithms. This tree does
#       not use LLVM ADT.
# Irrelevant on this Linux CLI (never fire usefully):
#   -google-objc-*, -clang-analyzer-osx*, -clang-analyzer-optin.mpi*,
#   -clang-analyzer-optin.osx*, -clang-analyzer-fuchsia*, -clang-analyzer-webkit*
Checks: >
  -*,
  android-cloexec-*,
  bugprone-*,
  cert-dcl50-cpp,
  cert-dcl58-cpp,
  cert-env33-c,
  cert-err33-c,
  cert-err34-c,
  cert-err52-cpp,
  cert-err58-cpp,
  cert-err60-cpp,
  cert-flp30-c,
  cert-mem57-cpp,
  cert-msc50-cpp,
  cert-msc51-cpp,
  cert-oop57-cpp,
  cert-oop58-cpp,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  google-*,
  llvm-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -cppcoreguidelines-avoid-c-arrays,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-c-copy-assignment-signature,
  -cppcoreguidelines-explicit-virtual-functions,
  -cppcoreguidelines-macro-to-enum,
  -cppcoreguidelines-narrowing-conversions,
  -cppcoreguidelines-noexcept-destructor,
  -cppcoreguidelines-noexcept-move-operations,
  -cppcoreguidelines-noexcept-swap,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -cppcoreguidelines-use-default-member-init,
  -google-objc-*,
  -google-readability-braces-around-statements,
  -google-readability-function-size,
  -google-readability-namespace-comments,
  -llvm-else-after-return,
  -llvm-header-guard,
  -llvm-qualified-auto,
  -llvm-use-ranges,
  -misc-use-anonymous-namespace,
  -readability-magic-numbers,
  -readability-trailing-comma,
  -clang-analyzer-osx*,
  -clang-analyzer-optin.mpi*,
  -clang-analyzer-optin.osx*,
  -clang-analyzer-fuchsia*,
  -clang-analyzer-webkit*

WarningsAsErrors: '*'

HeaderFilterRegex: '(src|include|test)/.*'

FormatStyle: file

CheckOptions:
  # Inventory of system/third-party angle includes under src/ and test/.
  # GlobList is comma-separated (a semicolon is one literal pattern).
  # Add a header here when introducing a new system/third-party include.
  portability-restrict-system-includes.Includes: 'CLI/CLI.hpp,algorithm,archive.h,archive_entry.h,array,atomic,bit,bits/types/struct_rusage.h,catch2/catch_all.hpp,cerrno,charconv,chrono,clocale,cmath,concepts,condition_variable,cstddef,cstdint,cstdio,cstdlib,cstring,deque,exception,expected,experimental/simd,fcntl.h,filesystem,format,fstream,functional,immintrin.h,initializer_list,ios,iosfwd,iostream,istream,iterator,limits,linux/audit.h,linux/bpf_common.h,linux/filter.h,linux/prctl.h,linux/seccomp.h,map,memory,mutex,new,nlohmann/json.hpp,nlohmann/json_fwd.hpp,numeric,onnxruntime_c_api.h,onnxruntime_cxx_api.h,optional,ostream,print,psapi.h,random,ranges,set,span,sstream,stdexcept,streambuf,string,string_view,sys/ioctl.h,sys/mman.h,sys/prctl.h,sys/resource.h,sys/stat.h,sys/syscall.h,sys/wait.h,system_error,thread,type_traits,unistd.h,unordered_map,unordered_set,utility,variant,vector,windows.h,zconf.h,zlib.h'
  modernize-use-auto.MinTypeNameLength: '5'
  readability-identifier-naming.ClassCase: 'CamelCase'
  readability-identifier-naming.StructCase: 'CamelCase'
  readability-identifier-naming.EnumCase: 'CamelCase'
  readability-identifier-naming.EnumConstantCase: 'CamelCase'
  readability-identifier-naming.ConceptCase: 'CamelCase'
  readability-identifier-naming.TypeAliasCase: 'CamelCase'
  readability-identifier-naming.TypedefCase: 'CamelCase'
  readability-identifier-naming.NamespaceCase: 'lower_case'
  readability-identifier-naming.FunctionCase: 'CamelCase'
  readability-identifier-naming.MethodCase: 'CamelCase'
  readability-identifier-naming.VariableCase: 'lower_case'
  readability-identifier-naming.ParameterCase: 'lower_case'
  readability-identifier-naming.LocalVariableCase: 'lower_case'
  readability-identifier-naming.LocalConstantCase: 'lower_case'
  readability-identifier-naming.LocalConstexprVariableCase: 'lower_case'
  readability-identifier-naming.MemberCase: 'lower_case'
  readability-identifier-naming.PublicMemberCase: 'lower_case'
  readability-identifier-naming.PrivateMemberCase: 'lower_case'
  readability-identifier-naming.PrivateMemberSuffix: '_'
  readability-identifier-naming.ProtectedMemberCase: 'lower_case'
  readability-identifier-naming.ProtectedMemberSuffix: '_'
  readability-identifier-naming.GlobalConstantCase: 'UPPER_CASE'
  readability-identifier-naming.GlobalConstexprVariableCase: 'UPPER_CASE'
  readability-identifier-naming.ClassConstantCase: 'UPPER_CASE'
  readability-identifier-naming.StaticConstantCase: 'UPPER_CASE'
  readability-identifier-naming.StaticConstexprVariableCase: 'UPPER_CASE'
  readability-identifier-naming.MacroDefinitionCase: 'UPPER_CASE'
  readability-identifier-naming.TypeAliasIgnoredRegexp: '^is_transparent$'
  readability-identifier-naming.FunctionIgnoredRegexp: '^(main|LLVMFuzzerTestOneInput|swap|hash)$'
  readability-identifier-naming.MethodIgnoredRegexp: '^(begin|end|cbegin|cend|rbegin|rend|size|data|empty|clear|push_back|pop_back|swap|hash|underflow|overflow|sync|xsgetn|xsputn|showmanyc|seekoff|seekpos|setbuf|uflow|pbackfail)$'
  readability-identifier-naming.VirtualMethodIgnoredRegexp: '^(begin|end|cbegin|cend|rbegin|rend|size|data|empty|clear|push_back|pop_back|swap|hash|underflow|overflow|sync|xsgetn|xsputn|showmanyc|seekoff|seekpos|setbuf|uflow|pbackfail)$'
  modernize-use-concepts.AllowNullaryConcepts: true
  cppcoreguidelines-pro-type-vararg.AllowVaArgs: false
  cppcoreguidelines-pro-bounds-array-to-pointer-decay.AllowPtrToArrayDecays: false
  readability-function-cognitive-complexity.Threshold: '25'
  readability-function-size.LineThreshold: '100'
  readability-function-size.StatementThreshold: '100'
  readability-function-size.BranchThreshold: '20'
  readability-function-size.ParameterThreshold: '6'
  readability-function-size.NestingThreshold: '4'
  readability-function-size.VariableThreshold: '30'
  bugprone-easily-swappable-parameters.MinimumLength: '2'
  bugprone-easily-swappable-parameters.ModelImplicitConversions: 'false'
  readability-identifier-length.MinimumVariableNameLength: '3'
  readability-identifier-length.MinimumParameterNameLength: '3'
  readability-identifier-length.MinimumLoopCounterNameLength: '2'
  readability-identifier-length.IgnoredLoopCounterNames: '^[ijk]$'
  readability-identifier-length.IgnoredParameterNames: '^[ab]$'
  readability-identifier-length.IgnoredVariableNames: '^[a-h]$'
  # clang-tidy 23 names structured bindings separately from variables.
  # sha256.cpp binds the SHA-256 working words a through h.
  readability-identifier-length.IgnoredBindingNames: '^([a-h]|_)$'
  readability-identifier-length.IgnoredExceptionVariableNames: '^[e]$'
  cppcoreguidelines-macro-usage.AllowedRegexp: '^(NESSO_|ZLIB_CONST$)'
