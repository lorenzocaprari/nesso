---
# Disabled checks:
# Alias de-dup (primary stays enabled via another glob — do not delete these
# unless you also intend to turn the primary off):
#   -cppcoreguidelines-avoid-c-arrays              -> modernize-avoid-c-arrays
#   -cppcoreguidelines-avoid-magic-numbers        -> readability-magic-numbers (also listed)
#   -cppcoreguidelines-c-copy-assignment-signature -> misc-unconventional-assign-operator
#   -cppcoreguidelines-explicit-virtual-functions -> modernize-use-override
#   -cppcoreguidelines-macro-to-enum              -> modernize-macro-to-enum
#   -cppcoreguidelines-narrowing-conversions      -> bugprone-narrowing-conversions
#   -cppcoreguidelines-noexcept-destructor        -> performance-noexcept-destructor
#   -cppcoreguidelines-noexcept-move-operations   -> performance-noexcept-move-constructor
#   -cppcoreguidelines-noexcept-swap              -> performance-noexcept-swap
#   -cppcoreguidelines-non-private-member-variables-in-classes
#                                                 -> misc-non-private-member-variables-in-classes
#   -cppcoreguidelines-use-default-member-init    -> modernize-use-default-member-init
#   -google-readability-function-size             -> readability-function-size
#   -llvm-else-after-return                       -> readability-else-after-return
#   -llvm-qualified-auto                          -> readability-qualified-auto
# Policy / style (no primary elsewhere):
#   -google-readability-braces-around-statements  (fights clang-format Allman)
#   -google-readability-namespace-comments        (Google } // namespace style)
#   -llvm-header-guard                            (custom NESSO_*/PLATFORM_* guards)
#   -misc-include-cleaner                         (enable in a dedicated PR)
#   -misc-use-anonymous-namespace                 (prefer static; see misc-use-internal-linkage)
#   -modernize-use-trailing-return-type           (classical return types)
#   -readability-magic-numbers                    (CLI/embed/scoring constants)
# Irrelevant on this Linux CLI (never fire usefully):
#   -google-objc-*, -clang-analyzer-osx*, -clang-analyzer-optin.mpi*,
#   -clang-analyzer-optin.osx*, -clang-analyzer-fuchsia*, -clang-analyzer-webkit*
Checks: >
  -*,
  bugprone-*,
  cert-dcl50-cpp,
  cert-dcl58-cpp,
  cert-env33-c,
  cert-err33-c,
  cert-err34-c,
  cert-err52-cpp,
  cert-err58-cpp,
  cert-err60-cpp,
  cert-flp30-c,
  cert-mem57-cpp,
  cert-msc50-cpp,
  cert-msc51-cpp,
  cert-oop57-cpp,
  cert-oop58-cpp,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  google-*,
  hicpp-exception-baseclass,
  hicpp-ignored-remove-result,
  hicpp-multiway-paths-covered,
  hicpp-no-assembler,
  hicpp-signed-bitwise,
  llvm-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -cppcoreguidelines-avoid-c-arrays,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-c-copy-assignment-signature,
  -cppcoreguidelines-explicit-virtual-functions,
  -cppcoreguidelines-macro-to-enum,
  -cppcoreguidelines-narrowing-conversions,
  -cppcoreguidelines-noexcept-destructor,
  -cppcoreguidelines-noexcept-move-operations,
  -cppcoreguidelines-noexcept-swap,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -cppcoreguidelines-use-default-member-init,
  -google-objc-*,
  -google-readability-braces-around-statements,
  -google-readability-function-size,
  -google-readability-namespace-comments,
  -llvm-else-after-return,
  -llvm-header-guard,
  -llvm-qualified-auto,
  -misc-include-cleaner,
  -misc-use-anonymous-namespace,
  -modernize-use-trailing-return-type,
  -readability-magic-numbers,
  -clang-analyzer-osx*,
  -clang-analyzer-optin.mpi*,
  -clang-analyzer-optin.osx*,
  -clang-analyzer-fuchsia*,
  -clang-analyzer-webkit*

WarningsAsErrors: '*'

HeaderFilterRegex: '(src|include|test)/.*'

FormatStyle: file

CheckOptions:
  modernize-use-auto.MinTypeNameLength: '5'
  readability-identifier-naming.ClassCase: 'CamelCase'
  readability-identifier-naming.VariableCase: 'camelBack'
  readability-identifier-naming.FunctionCase: 'camelBack'
  readability-identifier-naming.GlobalConstantCase: 'UPPER_CASE'
  modernize-use-concepts.AllowNullaryConcepts: true
  cppcoreguidelines-pro-type-vararg.AllowVaArgs: false
  cppcoreguidelines-pro-bounds-array-to-pointer-decay.AllowPtrToArrayDecays: false
  readability-function-cognitive-complexity.Threshold: '25'
  readability-function-size.LineThreshold: '100'
  readability-function-size.StatementThreshold: '100'
  readability-function-size.BranchThreshold: '20'
  readability-function-size.ParameterThreshold: '6'
  readability-function-size.NestingThreshold: '4'
  readability-function-size.VariableThreshold: '30'
  bugprone-easily-swappable-parameters.MinimumLength: '2'
  bugprone-easily-swappable-parameters.ModelImplicitConversions: 'false'
  readability-identifier-length.MinimumVariableNameLength: '3'
  readability-identifier-length.MinimumParameterNameLength: '3'
  readability-identifier-length.MinimumLoopCounterNameLength: '2'
  readability-identifier-length.IgnoredLoopCounterNames: '^[ijk]$'
  readability-identifier-length.IgnoredParameterNames: '^[ab]$'
  readability-identifier-length.IgnoredVariableNames: '^[a-h]$'
  readability-identifier-length.IgnoredExceptionVariableNames: '^[e]$'
  cppcoreguidelines-macro-usage.AllowedRegexp: '^(NESSO_|ZLIB_CONST$)'
