# Runtime image: no compiler. Build with --build-arg BUILD_IMAGE=<nesso-build-env>.
# BUILD_IMAGE is the CI-published nesso-build-env tag (deps-<content hash>).
# It is not an upstream image and has no stable digest to pin.
ARG BUILD_IMAGE
FROM ${BUILD_IMAGE} AS build

# Commit timestamp from the caller. BuildKit also reads this name. An empty
# value fails scripts/build-release-binary instead of inventing a clock.
ARG SOURCE_DATE_EPOCH
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}
ENV NESSO_REPRODUCIBLE=1
ENV LC_ALL=C
ENV TZ=UTC

# /nesso-src is not a prefix of the toolchain paths. /src is a suffix of
# /usr/src, which the leak check would then flag.
WORKDIR /nesso-src
COPY . .
RUN ./scripts/build-release-binary /opt/nesso/bin/nesso \
    && ./scripts/fetch-model /opt/nesso/models

FROM ubuntu:26.04@sha256:f144425ff09be612d6d9ad965196e9cdc23dae1f42110a8a11a3e9a8198759f7

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libstdc++6 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /opt/nesso/bin/nesso /usr/local/bin/nesso
COPY --from=build /opt/nesso/models /usr/share/nesso

ENV NESSO_MODEL_DIR=/usr/share/nesso

ENTRYPOINT ["nesso"]
