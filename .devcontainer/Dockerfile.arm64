# Native arm64 build-env. Kept separate from Dockerfile so the amd64
# image name and deps-<hash> tag stay unchanged.
# Build only on arm64 (ubuntu-24.04-arm). The host profile is
# conan/profiles/gcc-26-armv8; the x86-64 profile will not compile here.
#
# Clang, AFL, and the x86_64 compiler-rt symlinks are omitted. This image
# only has to configure, build, and run the Release tests.

FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    wget curl git python3-pip \
    cmake ninja-build \
    gcc-15 g++-15 \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-15 100 \
    && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-15 100

RUN pip install conan --break-system-packages \
    && rm -rf /root/.cache/pip

# GitHub Actions container jobs override HOME, so the cache lives at CONAN_HOME.
ENV CONAN_HOME=/opt/conan2

WORKDIR /tmp/nesso
COPY conanfile.py /tmp/nesso/conanfile.py
COPY conan.lock /tmp/nesso/conan.lock
COPY conan/profiles/gcc-26-armv8 /tmp/nesso/conan/profiles/gcc-26-armv8
RUN conan profile detect --force \
    && conan remote add conancenter https://center2.conan.io --force \
    && conan install . -pr:h=conan/profiles/gcc-26-armv8 -pr:b=default --lockfile=conan.lock --build=missing \
    && conan cache clean "*" --build --source --download --temp \
    && rm -rf /tmp/nesso /tmp/* /var/tmp/*
WORKDIR /

# After the Conan install. A change to ccache, Go, stress-ng, or zstd must
# not rebuild that layer. GitHub Actions sets HOME to /github/home, so the
# godog module cache cannot live under /root.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ccache \
    golang-go \
    stress-ng \
    zstd \
    && rm -rf /var/lib/apt/lists/*

ENV GOPATH=/opt/go
ENV GOMODCACHE=/opt/go/pkg/mod
COPY test/functional/go.mod test/functional/go.sum /tmp/nesso-go/
RUN cd /tmp/nesso-go \
    && GOTOOLCHAIN=local GOPROXY=https://proxy.golang.org,direct go mod download \
    && chmod -R a+rwX /opt/go \
    && rm -rf /tmp/nesso-go

LABEL org.opencontainers.image.source=https://github.com/lorenzocaprari/nesso
