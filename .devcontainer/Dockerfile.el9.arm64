# EL9 arm64 build-env. Kept separate from Dockerfile.el9 so each arch
# pins its own base digest and CMake tarball. The image name is
# nesso-build-env-el9. The tag appends -arm64.
# Build only on arm64 (ubuntu-24.04-arm). The host profile is
# conan/profiles/gcc-26-el9-armv8.

FROM rockylinux:9@sha256:370b6bd1851d5023c5c673535c85cdc5c1d8a59416ad83380a8db7ce3691bd45

# CRB has ninja-build. The toolset NEVRA is pinned; other packages follow
# the mirror the way the Ubuntu image follows apt. The base image ships
# curl-minimal, and the curl package conflicts with it. git pulls
# perl-interpreter only; OpenSSL's Configure needs FindBin from the perl
# metapackage. /usr/bin/python3
# stays 3.9 so dnf keeps working. /usr/local/bin/python3 is 3.12.
RUN dnf -y install dnf-plugins-core \
    && dnf config-manager --set-enabled crb \
    && dnf -y install \
      ca-certificates \
      git \
      make \
      perl \
      python3.12 \
      python3.12-pip \
      ninja-build \
      gcc-toolset-15-gcc-15.2.1-7.1.el9_8 \
      gcc-toolset-15-gcc-c++-15.2.1-7.1.el9_8 \
    && dnf clean all \
    && rm -rf /var/cache/dnf \
    && ln -sfn /usr/bin/python3.12 /usr/local/bin/python3

# Non-login shells (Docker RUN, GitHub Actions) do not source
# /opt/rh/gcc-toolset-15/enable. PATH is enough for the compiler. That
# script also sets LD_LIBRARY_PATH, which would shadow system libraries
# for later dnf runs. aarch64 still uses lib64. The toolset libstdc++ is
# a linker script, so the built binary still needs the system libstdc++.so.6.
ENV PATH=/opt/rh/gcc-toolset-15/root/usr/bin:${PATH}
ENV PKG_CONFIG_PATH=/opt/rh/gcc-toolset-15/root/usr/lib64/pkgconfig
ENV CC=/opt/rh/gcc-toolset-15/root/usr/bin/gcc
ENV CXX=/opt/rh/gcc-toolset-15/root/usr/bin/g++

RUN rpm -q --qf '%{VERSION}-%{RELEASE}\n' gcc-toolset-15-gcc | grep -qx '15.2.1-7.1.el9_8' \
    && g++ -dumpversion | grep -qx 15 \
    && python3 -c 'import sys; assert sys.version_info[:2] >= (3, 10), sys.version'

# EL9 ships CMake 3.31. This project requires 4.2.
RUN curl -fsSL -o /tmp/cmake.tgz \
      https://github.com/Kitware/CMake/releases/download/v4.4.5/cmake-4.4.5-linux-aarch64.tar.gz \
    && echo '301d5063ab259577c1b57ce5490b1aab9ea5c56dc4c822f73499553dab94925f  /tmp/cmake.tgz' | sha256sum -c - \
    && tar -C /usr/local --strip-components=1 -xzf /tmp/cmake.tgz \
    && rm -f /tmp/cmake.tgz \
    && cmake --version | head -n 1 | grep -q '4.4.5'

# Install Conan 2 and pre-commit. Hashes are required; Dependabot updates them.
COPY .devcontainer/requirements.txt /tmp/nesso-pip-requirements.txt
# RHEL marks this Python as externally managed. --break-system-packages
# installs the hashed set over that policy. The wheels include cp312.
RUN python3.12 -m pip install --require-hashes --break-system-packages \
      -r /tmp/nesso-pip-requirements.txt \
    && rm -rf /root/.cache/pip /tmp/nesso-pip-requirements.txt \
    && command -v conan

# GitHub Actions container jobs override HOME, so the cache lives at CONAN_HOME.
# This cache is this image's only. It is not the Ubuntu image's /opt/conan2.
ENV CONAN_HOME=/opt/conan2

WORKDIR /tmp/nesso
COPY conanfile.py /tmp/nesso/conanfile.py
COPY conan.lock /tmp/nesso/conan.lock
COPY conan/profiles/gcc-26-el9-armv8 /tmp/nesso/conan/profiles/gcc-26-el9-armv8
RUN conan profile detect --force \
    && conan remote add conancenter https://center2.conan.io --force \
    && conan install . -pr:h=conan/profiles/gcc-26-el9-armv8 -pr:b=default --lockfile=conan.lock --build=missing \
    && conan cache clean "*" --build --source --download --temp \
    && rm -rf /tmp/nesso /tmp/* /var/tmp/*
WORKDIR /

# After the Conan install. A change to ccache, Go, or zstd must not rebuild
# that layer. ccache is in EPEL. GitHub Actions sets HOME to /github/home,
# so the godog module cache cannot live under /root.
RUN dnf -y install epel-release \
    && dnf -y install \
    ccache \
    golang \
    zstd \
    && dnf clean all \
    && rm -rf /var/cache/dnf

ENV GOPATH=/opt/go
ENV GOMODCACHE=/opt/go/pkg/mod
COPY test/functional/go.mod test/functional/go.sum /tmp/nesso-go/
RUN cd /tmp/nesso-go \
    && GOTOOLCHAIN=local GOPROXY=https://proxy.golang.org,direct go mod download \
    && chmod -R a+rwX /opt/go \
    && rm -rf /tmp/nesso-go

LABEL org.opencontainers.image.source=https://github.com/lorenzocaprari/nesso
