#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

ver="$(python3 - "${ROOT}" <<'PY'
import re
import sys
from pathlib import Path

root = Path(sys.argv[1])
text = (root / "conanfile.py").read_text()
match = re.search(r'^    version = "([0-9]+\.[0-9]+\.[0-9]+)"', text, re.M)
if match is None:
    sys.exit("error: could not parse version from conanfile.py")
print(match.group(1))
PY
)"

if [[ $# -ge 1 && "${1}" != "${ver}" ]]; then
  echo "error: expected version ${1}, conanfile.py has ${ver}" >&2
  exit 1
fi
echo "${ver}"
