#!/usr/bin/env python3
"""Gate a real-log bench result.

Peak RSS is a hard failure when any timed command exceeds 1.5 GiB times
(1 + the RSS tolerance). Wall time is compared with the median of earlier
results (--history: the previous nightly's real-log JSON, or {"runs": [...]})
and only warns. Only results for the same corpus, prefix length, thread
count, and command are compared. A missing history warns and does not fail.
"""

import argparse
import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
RSS_BUDGET_BYTES = 1536 * 1024 * 1024
HISTORY_WINDOW = 20


def load_json(path: Path) -> dict:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise SystemExit(f"error: cannot read {path}: {exc}") from exc


def resolve_tolerance(explicit: float | None, env_name: str) -> float:
    raw = None if explicit is None else str(explicit)
    if raw is None:
        raw = os.environ.get(env_name, "0.15")
    try:
        value = float(raw)
    except ValueError as exc:
        raise SystemExit(f"error: invalid tolerance: {exc}") from exc
    if value < 0:
        raise SystemExit(f"error: invalid tolerance: {raw}")
    return value


def metric_name(case: dict, command: dict) -> str:
    label = str(command.get("name", "command"))
    if label == "search" and command.get("mode") == "dense":
        label = "search-dense"
    return f"real-log/{case.get('corpus')}/lines-{case.get('lines')}/threads-{case.get('threads')}/{label}/wall"


def median(values: list[float]) -> float:
    ordered = sorted(values)
    count = len(ordered)
    mid = count // 2
    if count % 2 == 1:
        return ordered[mid]
    return (ordered[mid - 1] + ordered[mid]) / 2.0


def rss_ceiling(tolerance: float) -> float:
    return RSS_BUDGET_BYTES * (1.0 + tolerance)


def rss_errors(payload: dict, tolerance: float) -> list[str]:
    ceiling = rss_ceiling(tolerance)
    errors = []
    for case in payload.get("cases", []):
        if not isinstance(case, dict):
            continue
        for command in case.get("commands", []):
            if not isinstance(command, dict):
                continue
            label = metric_name(case, command)
            peak = command.get("peakRssBytes")
            if isinstance(peak, bool) or not isinstance(peak, (int, float)):
                errors.append(f"error: {label} missing peak RSS")
                continue
            if peak > ceiling:
                errors.append(f"error: {label} peak RSS {int(peak)} bytes exceeds {int(ceiling)} bytes")
    return errors


def _append_wall(series: dict[str, list[float]], name: str, value: object) -> None:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return
    series.setdefault(name, []).append(float(value))


def walls_from_runs(runs: list) -> dict[str, list[float]]:
    series: dict[str, list[float]] = {}
    for payload in runs:
        if not isinstance(payload, dict):
            continue
        for case in payload.get("cases", []):
            if not isinstance(case, dict):
                continue
            for command in case.get("commands", []):
                if not isinstance(command, dict):
                    continue
                _append_wall(series, metric_name(case, command), command.get("wallSeconds"))
    return series


def load_history(path: Path | None) -> dict[str, list[float]] | None:
    if path is None or not path.is_file():
        return None
    payload = load_json(path)
    if not isinstance(payload, dict):
        raise SystemExit("error: history must be a JSON object")
    if "runs" in payload:
        runs = payload["runs"]
        if not isinstance(runs, list):
            raise SystemExit("error: history runs must be a list")
        return walls_from_runs(runs)
    if "cases" in payload:
        return walls_from_runs([payload])
    raise SystemExit("error: history must be a real-log result or {\"runs\": [...]}")


def speed_warnings(payload: dict, series: dict[str, list[float]] | None, tolerance: float) -> list[str]:
    if not series:
        return ["warning: no previous result; speed comparison skipped"]
    warnings = []
    for case in payload.get("cases", []):
        if not isinstance(case, dict):
            continue
        for command in case.get("commands", []):
            if not isinstance(command, dict):
                continue
            key = metric_name(case, command)
            samples = series.get(key, [])[-HISTORY_WINDOW:]
            wall = command.get("wallSeconds")
            if not samples:
                warnings.append(f"warning: {key}: no history")
                continue
            if isinstance(wall, bool) or not isinstance(wall, (int, float)):
                warnings.append(f"warning: {key}: missing wall time")
                continue
            mid = median(samples)
            if mid > 0 and wall > mid * (1.0 + tolerance):
                warnings.append(
                    f"warning: {key} wall {wall}s is above the median {mid}s of {len(samples)} earlier result(s)"
                )
    return warnings


def append_summary(text: str) -> None:
    path = os.environ.get("GITHUB_STEP_SUMMARY")
    if not path or not text:
        return
    with open(path, "a", encoding="utf-8") as handle:
        handle.write(text)
        if not text.endswith("\n"):
            handle.write("\n")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--result", type=Path, required=True, help="real-log bench JSON")
    parser.add_argument("--history", type=Path, help='Earlier real-log result JSON, or {"runs": [...]}')
    parser.add_argument("--rss-tolerance", type=float, default=None, help="Fractional peak-RSS increase over 1.5 GiB")
    parser.add_argument("--wall-tolerance", type=float, default=None, help="Fractional wall increase over the median")
    args = parser.parse_args(argv)
    payload = load_json(args.result)
    rss_tolerance = resolve_tolerance(args.rss_tolerance, "NESSO_BENCH_RSS_TOLERANCE")
    wall_tolerance = resolve_tolerance(args.wall_tolerance, "NESSO_BENCH_WALL_TOLERANCE")
    series = load_history(args.history)
    errors = rss_errors(payload, rss_tolerance)
    warnings = speed_warnings(payload, series, wall_tolerance)
    lines = warnings + errors
    if lines:
        print("\n".join(lines))
    append_summary("\n".join(["### Real-log benchmark", ""] + [f"- {line}" for line in lines]))
    for error in errors:
        print(error, file=sys.stderr)
    return 1 if errors else 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except SystemExit as exc:
        code = exc.code
        if isinstance(code, str):
            print(code, file=sys.stderr)
            raise SystemExit(1) from exc
        raise
