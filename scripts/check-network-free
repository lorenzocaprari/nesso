#!/usr/bin/env python3
"""Fail when an ELF binary links networking code.

nesso reads local files and does not open a connection. libcurl and
OpenSSL are in the Conan graph through date, and the release binary
does not link them. This check keeps it that way.

Usage: check-network-free BINARY. Exit 0 when nothing below matches, 1
when something does (every offender is named), 2 on a usage, allow-list,
or tool error. A missing readelf, nm, or strings is an error, not a pass.

  * readelf -d NEEDED entries whose soname is a denied library
  * undefined dynamic symbols from nm -D --undefined-only, except names
    listed in check-network-free.allow (NESSO_NETWORK_ALLOW overrides it)
  * defined text symbols (nm, including the dynamic table) whose names
    start with curl_, Curl_, SSL_, OPENSSL_, or EVP_
  * the strings markers libcurl/ and 'OpenSSL ', which survive a strip
"""

import os
import re
import subprocess
import sys
from pathlib import Path

DENY_LIBRARIES = frozenset(
    {
        "libcares",
        "libcrypto",
        "libcurl",
        "libgnutls",
        "libgrpc",
        "libidn2",
        "libldap",
        "libnghttp2",
        "libnghttp3",
        "libngtcp2",
        "libpsl",
        "libresolv",
        "libssh",
        "libssh2",
        "libssl",
        "libzmq",
    }
)
DENY_SYMBOLS = frozenset(
    {
        "accept",
        "accept4",
        "bind",
        "connect",
        "getaddrinfo",
        "gethostbyaddr",
        "gethostbyname",
        "gethostbyname_r",
        "getnameinfo",
        "listen",
        "recvfrom",
        "recvmsg",
        "res_query",
        "res_search",
        "sendmsg",
        "sendto",
        "socket",
        "socketpair",
    }
)
STATIC_PREFIXES = ("curl_", "Curl_", "SSL_", "OPENSSL_", "EVP_")
STRING_MARKERS = ("libcurl/", "OpenSSL ")
NEEDED = re.compile(r"\(NEEDED\)\s+Shared library: \[([^\]]+)\]")
SYMBOL = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")


def tool(argv: list[str]) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(argv, capture_output=True, text=True, check=False)
    except FileNotFoundError:
        raise OSError(f"{argv[0]}: command not found") from None


def symbol_base(name: str) -> str:
    return name.split("@", 1)[0]


def parse_nm(stdout: str) -> list[tuple[str, str]]:
    rows = []
    for line in stdout.splitlines():
        if not line.strip():
            continue
        parts = line.split()
        if len(parts) < 2 or len(parts[1]) != 1 or not parts[1].isalpha():
            raise OSError(f"nm: cannot parse {line.strip()!r}")
        rows.append((symbol_base(parts[0]), parts[1]))
    return rows


def nm_rows(binary: str, args: list[str], *, stripped_ok: bool) -> list[tuple[str, str]]:
    result = tool(["nm", *args, "--format=posix", binary])
    if result.returncode != 0:
        detail = result.stderr.strip()
        if stripped_ok and "no symbols" in detail.lower() and not result.stdout.strip():
            return []
        raise OSError(detail or f"nm {' '.join(args)} failed")
    return parse_nm(result.stdout)


def needed_libraries(binary: str) -> list[str]:
    result = tool(["readelf", "-d", binary])
    if result.returncode != 0:
        raise OSError(result.stderr.strip() or "readelf -d failed")
    found = []
    for line in result.stdout.splitlines():
        if "(NEEDED)" not in line:
            continue
        match = NEEDED.search(line)
        if not match:
            raise OSError(f"readelf: cannot parse NEEDED line: {line.strip()}")
        found.append(match.group(1))
    return found


def denied_library(soname: str) -> bool:
    stem = soname.split(".so", 1)[0]
    for name in DENY_LIBRARIES:
        if stem == name:
            return True
        if stem.startswith(name) and not stem[len(name)].isalnum():
            return True
    return False


def allow_path() -> Path:
    override = os.environ.get("NESSO_NETWORK_ALLOW")
    if override:
        return Path(override)
    return Path(__file__).resolve().with_name("check-network-free.allow")


def load_allow(path: Path) -> set[str]:
    if not path.is_file():
        raise OSError(f"allow list not found: {path}")
    allowed = set()
    for lineno, line in enumerate(path.read_text().splitlines(), 1):
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        if "#" not in stripped:
            raise OSError(f"{path}:{lineno}: symbol is missing a reason comment")
        symbol, reason = stripped.split("#", 1)
        symbol = symbol_base(symbol.strip())
        if not reason.strip():
            raise OSError(f"{path}:{lineno}: symbol is missing a reason comment")
        if SYMBOL.fullmatch(symbol) is None:
            raise OSError(f"{path}:{lineno}: invalid symbol {symbol!r}")
        allowed.add(symbol)
    return allowed


def version_markers(binary: str) -> list[str]:
    result = tool(["strings", "-a", binary])
    if result.returncode != 0:
        raise OSError(result.stderr.strip() or "strings -a failed")
    return [marker for marker in STRING_MARKERS if marker in result.stdout]


def problems(binary: str, allowed: set[str]) -> list[str]:
    found = []
    for soname in needed_libraries(binary):
        if denied_library(soname):
            found.append(f"NEEDED {soname}")
    imports = []
    for name, kind in nm_rows(binary, ["-D", "--undefined-only"], stripped_ok=False):
        if kind in {"U", "w"} and name in DENY_SYMBOLS and name not in allowed:
            imports.append(name)
    for name in sorted(set(imports)):
        found.append(f"imports {name}")
    defined = []
    for args, stripped_ok in (
        (["--defined-only"], True),
        (["-D", "--defined-only"], False),
    ):
        for name, kind in nm_rows(binary, args, stripped_ok=stripped_ok):
            if kind in {"T", "t"} and name.startswith(STATIC_PREFIXES):
                defined.append(name)
    for name in sorted(set(defined)):
        found.append(f"defines {name}")
    for marker in version_markers(binary):
        found.append(f"contains {marker!r}")
    return found


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        print("usage: check-network-free BINARY", file=sys.stderr)
        return 2
    binary = argv[1]
    try:
        found = problems(binary, load_allow(allow_path()))
    except OSError as error:
        print(f"error: {error}", file=sys.stderr)
        return 2
    for item in found:
        print(f"error: {binary} {item}", file=sys.stderr)
    return 1 if found else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
