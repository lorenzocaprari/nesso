#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 3 || $# -gt 4 ]]; then
  echo "usage: package-deb VERSION BINARY MODEL_DIR [OUT_DIR]" >&2
  echo "       DOC_DIR (default: BINARY's directory/doc) holds copyright and THIRD_PARTY_NOTICES" >&2
  exit 2
fi

VERSION="$1"
BINARY="$2"
MODEL_DIR="$3"
OUT_DIR="${4:-.}"
# scripts/build-release-binary writes the notices to doc/ next to the binary.
DOC_DIR="${DOC_DIR:-$(dirname "${BINARY}")/doc}"

if [[ ! "${VERSION}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "error: VERSION must be X.Y.Z, got ${VERSION}" >&2
  exit 2
fi
if [[ ! -f "${BINARY}" ]]; then
  echo "error: binary not found: ${BINARY}" >&2
  exit 2
fi
if [[ ! -f "${MODEL_DIR}/vocab.txt" || ! -f "${MODEL_DIR}/model.onnx" ]]; then
  echo "error: ${MODEL_DIR} must contain vocab.txt and model.onnx" >&2
  exit 2
fi

# Highest GLIBC_ version the binary references. dpkg-shlibdeps only knows the
# host libc symbols file, which does not list versions newer than the runner.
libc6_min_version() {
  local binary="$1"
  if ! command -v objdump >/dev/null 2>&1; then
    echo "error: objdump is required to derive the libc6 dependency" >&2
    return 1
  fi
  local dump
  if ! dump="$(objdump -T "${binary}")"; then
    echo "error: objdump failed for ${binary}" >&2
    return 1
  fi
  local symbols
  symbols="$(printf '%s\n' "${dump}" | grep -oE 'GLIBC_[0-9]+(\.[0-9]+)+' || true)"
  if [[ -z "${symbols}" ]]; then
    echo "error: no GLIBC_ symbol versions in ${binary}" >&2
    return 1
  fi
  local libc_min
  libc_min="$(printf '%s\n' "${symbols}" | sed 's/^GLIBC_//' | sort -Vu | tail -n1)"
  if [[ ! "${libc_min}" =~ ^[0-9]+(\.[0-9]+)+$ ]]; then
    echo "error: refused libc version '${libc_min}'" >&2
    return 1
  fi
  printf '%s\n' "${libc_min}"
}

# Debian architecture follows the binary, not the host. e_machine is the ELF
# field at byte 18. A host `dpkg --print-architecture` would mislabel a
# cross-built binary and the arm64 package tests.
deb_architecture() {
  local binary="$1"
  if ! command -v od >/dev/null 2>&1; then
    echo "error: od is required to read the ELF machine" >&2
    return 1
  fi
  local magic
  magic="$(od -An -t x1 -N 4 -- "${binary}" | tr -d '[:space:]')"
  if [[ "${magic}" != "7f454c46" ]]; then
    echo "error: ${binary} is not an ELF file" >&2
    return 1
  fi
  local class data
  class="$(od -An -t u1 -j 4 -N 1 -- "${binary}" | tr -d '[:space:]')"
  data="$(od -An -t u1 -j 5 -N 1 -- "${binary}" | tr -d '[:space:]')"
  if [[ "${class}" != "2" || "${data}" != "1" ]]; then
    echo "error: ${binary} is not a little-endian ELF64" >&2
    return 1
  fi
  local lo hi machine
  lo="$(od -An -t u1 -j 18 -N 1 -- "${binary}" | tr -d '[:space:]')"
  hi="$(od -An -t u1 -j 19 -N 1 -- "${binary}" | tr -d '[:space:]')"
  machine=$((10#${lo} + 10#${hi} * 256))
  case "${machine}" in
    62) printf '%s\n' amd64 ;;
    183) printf '%s\n' arm64 ;;
    *)
      echo "error: unsupported ELF e_machine ${machine} in ${binary}" >&2
      return 1
      ;;
  esac
}

DEB_ARCH="$(deb_architecture "${BINARY}")"
LIBC_MIN="$(libc6_min_version "${BINARY}")"

# Unset means "this clock". Two packages then differ. Callers that compare
# bytes, including the release workflow, pass the commit timestamp.
if [[ -n "${SOURCE_DATE_EPOCH:-}" ]]; then
  if [[ ! "${SOURCE_DATE_EPOCH}" =~ ^[0-9]+$ ]]; then
    echo "error: SOURCE_DATE_EPOCH must be a unix timestamp, got ${SOURCE_DATE_EPOCH}" >&2
    exit 2
  fi
else
  SOURCE_DATE_EPOCH="$(date +%s)"
fi
export SOURCE_DATE_EPOCH
export TZ=UTC
export LC_ALL=C
umask 022

if [[ ! -s "${DOC_DIR}/copyright" || ! -s "${DOC_DIR}/THIRD_PARTY_NOTICES" ]]; then
  echo "error: ${DOC_DIR} must contain copyright and THIRD_PARTY_NOTICES (scripts/third-party-notices)" >&2
  exit 2
fi

WORKDIR="$(mktemp -d)"
trap 'rm -rf "${WORKDIR}"' EXIT

PKG="${WORKDIR}/nesso"
install -D -m 0755 "${BINARY}" "${PKG}/usr/bin/nesso"
install -D -m 0644 "${MODEL_DIR}/vocab.txt" "${PKG}/usr/share/nesso/vocab.txt"
install -D -m 0644 "${MODEL_DIR}/model.onnx" "${PKG}/usr/share/nesso/model.onnx"
# Debian policy 12.5: copyright carries every notice, because minimized
# images keep only /usr/share/doc/*/copyright. THIRD_PARTY_NOTICES is the
# same third-party text on its own.
install -D -m 0644 "${DOC_DIR}/copyright" "${PKG}/usr/share/doc/nesso/copyright"
install -D -m 0644 "${DOC_DIR}/THIRD_PARTY_NOTICES" "${PKG}/usr/share/doc/nesso/THIRD_PARTY_NOTICES"
mkdir -p "${PKG}/DEBIAN"

cat >"${PKG}/DEBIAN/control" <<EOF
Package: nesso
Version: ${VERSION}
Section: utils
Priority: optional
Architecture: ${DEB_ARCH}
Depends: libc6 (>= ${LIBC_MIN}), libstdc++6, libgomp1
Maintainer: Lorenzo Caprari <lorenzocaprari@users.noreply.github.com>
Description: Local semantic search for unstructured text
 Nesso is a Linux CLI that searches .log, .json, and .jsonl files by meaning
 using a local ONNX MiniLM model.
EOF

chmod 0755 "${PKG}" "${PKG}/DEBIAN" "${PKG}/usr" "${PKG}/usr/bin" "${PKG}/usr/share" "${PKG}/usr/share/nesso" \
  "${PKG}/usr/share/doc" "${PKG}/usr/share/doc/nesso"
chmod 0755 "${PKG}/usr/bin/nesso"
chmod 0644 "${PKG}/DEBIAN/control" "${PKG}/usr/share/nesso/vocab.txt" "${PKG}/usr/share/nesso/model.onnx" \
  "${PKG}/usr/share/doc/nesso/copyright" "${PKG}/usr/share/doc/nesso/THIRD_PARTY_NOTICES"
# dpkg-deb clamps only mtimes newer than SOURCE_DATE_EPOCH. A model file
# older than the commit would keep its download time and the archive would
# change between builds.
find "${PKG}" -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +

mkdir -p "${OUT_DIR}"
OUT_DEB="$(cd "${OUT_DIR}" && pwd)/nesso_${VERSION}_${DEB_ARCH}.deb"
dpkg-deb \
  --root-owner-group \
  --uniform-compression \
  --threads-max=1 \
  -Zzstd \
  -z19 \
  --build "${PKG}" "${OUT_DEB}"
echo "${OUT_DEB}"
