#!/usr/bin/env python3
"""Write a synthetic application log for the README demo.

The seed and line count are fixed so `docs/assets/demo.tape` can rebuild
`app.log`. Every line is invented here. The query "the disk is full" and
its words are rejected so a plain grep of that query stays empty.
"""

from __future__ import annotations

import argparse
import random
import re
import sys
from pathlib import Path


SEED = 7
LINE_COUNT = 5000
QUERY_WORDS = frozenset({"the", "disk", "is", "full"})
ENOSPC = "write /var/lib/app/queue.db: No space left on device"
WORD = re.compile(r"[A-Za-z]+")
HOSTS = ("web-01", "web-02", "api-01", "worker-01")
MESSAGES = (
    "accepted connection from 10.{a}.{b}.{c}",
    "request completed in {ms} ms",
    "health check ok",
    "rotated log to /var/log/app/app.log.{n}",
    "cache refresh finished for user {n}",
    "listen on 10.0.0.8:8080",
    "worker {n} idle",
)


def positive(value: str) -> int:
    try:
        parsed = int(value)
    except ValueError as error:
        raise argparse.ArgumentTypeError("must be a positive integer") from error
    if parsed < 1:
        raise argparse.ArgumentTypeError("must be a positive integer")
    return parsed


def query_words_in(line: str) -> set[str]:
    return {word.lower() for word in WORD.findall(line)} & QUERY_WORDS


def render_lines(seed: int = SEED, count: int = LINE_COUNT) -> list[str]:
    rng = random.Random(seed)
    enospc_at = {index for index in range(count) if rng.randrange(40) == 0}
    needed = min(3, count)
    if len(enospc_at) < needed:
        pool = [index for index in range(count) if index not in enospc_at]
        rng.shuffle(pool)
        enospc_at.update(pool[: needed - len(enospc_at)])

    lines: list[str] = []
    for index in range(count):
        day = rng.randint(1, 28)
        hour = rng.randint(0, 23)
        minute = rng.randint(0, 59)
        second = rng.randint(0, 59)
        host = rng.choice(HOSTS)
        pid = rng.randint(1000, 9999)
        if index in enospc_at:
            message = ENOSPC
        else:
            message = rng.choice(MESSAGES).format(
                a=rng.randint(0, 255),
                b=rng.randint(0, 255),
                c=rng.randint(1, 254),
                ms=rng.randint(1, 900),
                n=rng.randint(1, 5000),
            )
        line = f"Oct {day:2d} {hour:02d}:{minute:02d}:{second:02d} {host} app[{pid}]: {message}"
        found = query_words_in(line)
        if found:
            listed = ", ".join(sorted(found))
            raise ValueError(f"generated line contains query words ({listed}): {line}")
        lines.append(line)
    return lines


def render_text(seed: int = SEED, count: int = LINE_COUNT) -> str:
    return "".join(f"{line}\n" for line in render_lines(seed, count))


def arguments(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Write a synthetic log for the nesso demo.")
    parser.add_argument("--seed", type=int, default=SEED, help=f"RNG seed (default: {SEED})")
    parser.add_argument(
        "--lines",
        type=positive,
        default=LINE_COUNT,
        help=f"Number of log lines (default: {LINE_COUNT})",
    )
    parser.add_argument("-o", "--output", type=Path, help="Write here instead of stdout")
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    options = arguments(argv)
    try:
        text = render_text(options.seed, options.lines)
    except ValueError as error:
        print(f"error: {error}", file=sys.stderr)
        return 2
    if options.output is None:
        sys.stdout.write(text)
        return 0
    if options.output.parent != Path(".") and not options.output.parent.is_dir():
        print(f"error: directory does not exist: {options.output.parent}", file=sys.stderr)
        return 2
    options.output.write_text(text, encoding="utf-8", newline="\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
