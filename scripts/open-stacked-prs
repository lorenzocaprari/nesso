#!/usr/bin/env bash
set -euo pipefail

REPO="${1:-lorenzocaprari/nesso}"

if ! gh auth status >/dev/null 2>&1; then
  echo "error: run 'gh auth login' first" >&2
  exit 2
fi

BASES=(
  main
  nesso/pr-01-rebrand
  nesso/pr-03-dot-product
  nesso/pr-04-l2-squared
  nesso/pr-05-avx2-distance
  nesso/pr-06-topk-helper
  nesso/pr-07-vector-index
  nesso/pr-08-fetch-model
  nesso/pr-09-tokenizer
  nesso/pr-10-onnx-embedder
  nesso/pr-11-log-chunker
  nesso/pr-12-cli-refactor
)
HEADS=(
  nesso/pr-01-rebrand
  nesso/pr-03-dot-product
  nesso/pr-04-l2-squared
  nesso/pr-05-avx2-distance
  nesso/pr-06-topk-helper
  nesso/pr-07-vector-index
  nesso/pr-08-fetch-model
  nesso/pr-09-tokenizer
  nesso/pr-10-onnx-embedder
  nesso/pr-11-log-chunker
  nesso/pr-12-cli-refactor
  nesso/pr-13-grep
)
TITLES=(
  "docs: rebrand public surface to Nesso"
  "feat: add DistanceMetrics::dotProduct scalar kernel"
  "feat: add DistanceMetrics::l2SquaredDistance scalar kernel"
  "feat: add AVX2 float distance kernels with scalar oracle tests"
  "refactor: extract shared selectTopKInPlace helper"
  "feat: add in-memory VectorIndex with LogChunk metadata"
  "chore: harden fetch-model and coverage reporting"
  "feat: add WordPieceTokenizer for MiniLM vocab files"
  "feat: add OnnxEmbedder with embed and embedBatch"
  "feat: add LogChunker for .log, .json, and .jsonl files"
  "refactor: extract init/index/search handlers from main.cpp"
  "feat: add semantic grep subcommand and integration test"
)

for i in "${!HEADS[@]}"; do
  n=$(printf '%02d' $((i + 1)))
  if gh pr view --repo "${REPO}" --head "${HEADS[$i]}" >/dev/null 2>&1; then
    echo "PR ${n} already exists for ${HEADS[$i]}"
    gh pr view --repo "${REPO}" --head "${HEADS[$i]}" --json url -q .url
    continue
  fi

  url=$(gh pr create \
    --repo "${REPO}" \
    --base "${BASES[$i]}" \
    --head "${HEADS[$i]}" \
    --title "${TITLES[$i]}" \
    --body "$(cat <<EOF
## Summary
Stacked PR ${n}/12 in the Nesso roadmap. Single-commit diff against \`${BASES[$i]}\`.

## Test plan
- [ ] \`bash scripts/lint\`
- [ ] \`conan build . -pr:h ./conan/profiles/gcc-26-debug -pr:b default --lockfile=conan.lock --build=missing\`
- [ ] \`ctest --test-dir build/Debug --output-on-failure\`
- [ ] \`./scripts/code-coverage conan/profiles/code-coverage\`
EOF
)")
  echo "PR ${n}: ${url}"
done
