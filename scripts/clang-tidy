#!/usr/bin/env bash
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Prefer an explicit compile DB (e.g. a clang-26 configure in build/Clang) when set.
if [ -n "${NESSO_CLANG_TIDY_BUILD_DIR:-}" ]; then
    BUILD_DIR="$NESSO_CLANG_TIDY_BUILD_DIR"
elif [ -f "$PROJECT_ROOT/build/Release/compile_commands.json" ]; then
    BUILD_DIR="$PROJECT_ROOT/build/Release"
elif [ -f "$PROJECT_ROOT/build/Debug/compile_commands.json" ]; then
    BUILD_DIR="$PROJECT_ROOT/build/Debug"
else
    echo "clang-tidy: compile_commands.json not found." >&2
    echo "Build once, or set NESSO_CLANG_TIDY_BUILD_DIR to a directory that has it." >&2
    echo "Optional Clang-parity pass: conan build with clang-26 into a separate build dir," >&2
    echo "then NESSO_CLANG_TIDY_BUILD_DIR=build/Clang bash scripts/clang-tidy" >&2
    exit 1
fi

if [ ! -f "$BUILD_DIR/compile_commands.json" ]; then
    echo "clang-tidy: missing $BUILD_DIR/compile_commands.json" >&2
    exit 1
fi

echo "clang-tidy: using build directory: $BUILD_DIR"

# Drop flags the Clang driver rejects, and Clang @*.modmap response files that
# only exist after a real build (configure-only DBs reference them otherwise).
# The GCC build still passes the -W* options; nesso sets SCAN_FOR_MODULES off.
sed -i \
  -e 's/ -fmodules-ts//g' \
  -e 's/ -fmodule-mapper=[^ ]*//g' \
  -e 's/ -fdeps-format=[^ ]*//g' \
  -e 's/ @[^ ]*\.modmap//g' \
  -e 's/ -Wduplicated-cond//g' \
  -e 's/ -Wduplicated-branches//g' \
  -e 's/ -Wlogical-op//g' \
  -e 's/ -Wuseless-cast//g' \
  "$BUILD_DIR/compile_commands.json"

# HeaderFilterRegex already covers (src|include|test). Analyze first-party
# translation units under both trees; Catch2 headers stay out via SystemHeaders.
FILE_REGEX='(src|test)/.*'

# With NESSO_CLANG_TIDY_CACHE set, skip units whose clean result is cached.
# The key covers the preprocessed source with comments, the compile arguments,
# the clang-tidy version and every .clang-tidy file (scripts/ci clang-tidy-cache).
if [ -n "${NESSO_CLANG_TIDY_CACHE:-}" ]; then
    tidy_bin="$(command -v clang-tidy-23 || command -v clang-tidy || true)"
    if [ -z "$tidy_bin" ]; then
        echo "clang-tidy: clang-tidy-23 or clang-tidy not found" >&2
        exit 1
    fi
    cache_dir="$(realpath -m "$NESSO_CLANG_TIDY_CACHE")"
    echo "clang-tidy: cached run with $tidy_bin, cache $cache_dir"
    go run -C "$PROJECT_ROOT/scripts/ci" . clang-tidy-cache \
        -root "$PROJECT_ROOT" -p "$(realpath "$BUILD_DIR")" -cache-dir "$cache_dir" \
        -clang-tidy "$tidy_bin" -j "$(nproc)" -files "$FILE_REGEX"
    echo "clang-tidy: check completed."
    exit 0
fi

if command -v run-clang-tidy &> /dev/null; then
    echo "clang-tidy: running parallel analysis with run-clang-tidy..."
    run-clang-tidy -p "$BUILD_DIR" -j"$(nproc)" "$FILE_REGEX"
else
    echo "clang-tidy: run-clang-tidy not found, falling back to xargs..."
    find "$PROJECT_ROOT/src" "$PROJECT_ROOT/test" -type f \( -name "*.cpp" -o -name "*.cc" -o -name "*.cxx" \) -print0 | \
    xargs -0 -P "$(nproc)" -I {} clang-tidy -p "$BUILD_DIR" --quiet {}
fi

echo "clang-tidy: check completed."
