#!/usr/bin/env bash
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ -f "$PROJECT_ROOT/build/Release/compile_commands.json" ]; then
    BUILD_DIR="$PROJECT_ROOT/build/Release"
elif [ -f "$PROJECT_ROOT/build/Debug/compile_commands.json" ]; then
    BUILD_DIR="$PROJECT_ROOT/build/Debug"
else
    echo "clang-tidy: compile_commands.json not found." >&2
    exit 1
fi

echo "clang-tidy: using build directory: $BUILD_DIR"

# GCC module flags and the GCC-only nesso_options warnings are not Clang options.
# clang-tidy reports those as errors and stops. The GCC build still passes them.
sed -i \
  -e 's/ -fmodules-ts//g' \
  -e 's/ -fmodule-mapper=[^ ]*//g' \
  -e 's/ -fdeps-format=[^ ]*//g' \
  -e 's/ -Wduplicated-cond//g' \
  -e 's/ -Wduplicated-branches//g' \
  -e 's/ -Wlogical-op//g' \
  -e 's/ -Wuseless-cast//g' \
  "$BUILD_DIR/compile_commands.json"

if command -v run-clang-tidy &> /dev/null; then
    echo "clang-tidy: running parallel analysis with run-clang-tidy..."
    run-clang-tidy -p "$BUILD_DIR" -j"$(nproc)" "src/.*"
else
    echo "clang-tidy: run-clang-tidy not found, falling back to xargs..."
    find "$PROJECT_ROOT/src" -type f \( -name "*.cpp" -o -name "*.cc" -o -name "*.cxx" \) -print0 | \
    xargs -0 -P "$(nproc)" -I {} clang-tidy -p "$BUILD_DIR" --quiet {}
fi

echo "clang-tidy: check completed."
