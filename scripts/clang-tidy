#!/usr/bin/env bash
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Determine build directory: prefer Release, fall back to Debug
BUILD_DIR=""
if [ -f "$PROJECT_ROOT/build/Release/compile_commands.json" ]; then
    BUILD_DIR="build/Release"
elif [ -f "$PROJECT_ROOT/build/Debug/compile_commands.json" ]; then
    BUILD_DIR="build/Debug"
else
    echo "Error: compile_commands.json not found in build/Release or build/Debug"
    echo "Make sure to build the project first to generate compile_commands.json"
    exit 1
fi

# Find C/C++ source files in src/
SOURCE_FILES=$(find "$PROJECT_ROOT/src" -name "*.cpp" -o -name "*.c" -o -name "*.cc" -o -name "*.cxx")

if [ -z "$SOURCE_FILES" ]; then
    echo "No C/C++ source files found in src/"
    exit 0
fi

echo "Running clang-tidy on source files..."
cd "$PROJECT_ROOT"
clang-tidy -p "$BUILD_DIR" $SOURCE_FILES

echo "clang-tidy check completed."
