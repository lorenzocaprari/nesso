#!/usr/bin/env python3
"""Record the CPU and the kernels a Pipeline eval run selects.

The Pipeline eval-retrieval job scores two binaries on one runner. This
writes the CPU model and the kernels that runner selects, so a later
mismatch is visible in the job summary and in the eval-pipeline artifact.

distanceKernel matches nesso's SelectDistanceKernel. scalar and avx2 are
the NESSO_FORCE_KERNEL values. avx2 requires AVX2 and FMA. An unset,
empty, or any other value keeps automatic selection.

int8Kernel is the ONNX Runtime 1.18 int8 GEMM kernel after nesso refuses
AMX tile data: avx512-vnni when that flag is present, else avx2, else
scalar. A CPU without those flags is recorded as scalar. The refusal is
what keeps AMX from being the kernel; a failed refusal prints the
existing stderr warning and is not re-probed here.

    scripts/eval-host --out build/eval/current/host.json
    scripts/eval-host --summary --host build/eval/current/host.json
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path
from typing import Any


def cpu_model(text: str) -> str:
    for line in text.splitlines():
        if line.lower().startswith("model name"):
            return line.split(":", 1)[1].strip()
    return "unknown"


def flag_set(text: str) -> set[str]:
    for line in text.splitlines():
        if line.lower().startswith("flags"):
            return set(line.split(":", 1)[1].split())
    return set()


def distance_kernel(flags: set[str], forced: str | None) -> str:
    avx2_fma = "avx2" in flags and "fma" in flags
    if forced == "scalar":
        return "scalar"
    if forced == "avx2":
        return "avx2" if avx2_fma else "scalar"
    if avx2_fma:
        return "avx2"
    return "scalar"


def int8_kernel(flags: set[str]) -> str:
    if "avx512vnni" in flags:
        return "avx512-vnni"
    if "avx2" in flags:
        return "avx2"
    return "scalar"


def host_from_cpuinfo(text: str, forced: str | None) -> dict[str, str]:
    flags = flag_set(text)
    return {
        "cpuModel": cpu_model(text),
        "distanceKernel": distance_kernel(flags, forced),
        "int8Kernel": int8_kernel(flags),
    }


def summary_line(host: dict[str, Any]) -> str:
    try:
        cpu = host["cpuModel"]
        distance = host["distanceKernel"]
        int8 = host["int8Kernel"]
    except KeyError as exc:
        raise SystemExit(f"error: host record is missing {exc.args[0]}") from exc
    return f"CPU {cpu}; distance kernel {distance}; int8 kernel {int8}."


def probe(cpuinfo: Path | None) -> dict[str, str]:
    if cpuinfo is None:
        path = Path("/proc/cpuinfo")
        text = path.read_text(encoding="utf-8", errors="replace") if path.is_file() else ""
    else:
        text = cpuinfo.read_text(encoding="utf-8", errors="replace")
    forced = os.environ.get("NESSO_FORCE_KERNEL")
    return host_from_cpuinfo(text, forced)


def load_host(path: Path) -> dict[str, Any]:
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        raise SystemExit(f"error: {path} is not JSON: {exc}") from exc
    if not isinstance(payload, dict):
        raise SystemExit(f"error: {path} is not a host record")
    return payload


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Record the eval runner's CPU and kernels.")
    parser.add_argument("--cpuinfo", type=Path, help="read this cpuinfo instead of /proc/cpuinfo")
    parser.add_argument("--host", type=Path, help="print a record already written")
    parser.add_argument("--out", type=Path, help="write the JSON record here")
    parser.add_argument("--summary", action="store_true", help="print one summary line")
    args = parser.parse_args(argv)

    if args.host is not None and args.cpuinfo is not None:
        raise SystemExit("error: --host and --cpuinfo are mutually exclusive")
    host = load_host(args.host) if args.host is not None else probe(args.cpuinfo)
    # summary_line checks the keys before anything is written.
    line = summary_line(host)
    if args.out is not None:
        args.out.parent.mkdir(parents=True, exist_ok=True)
        args.out.write_text(json.dumps(host, indent=2) + "\n", encoding="utf-8")
    if args.summary:
        print(line)
    else:
        print(json.dumps(host, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main())
