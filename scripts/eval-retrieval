#!/usr/bin/env python3
"""Score nesso search ranking against labelled Loghub queries.

Indexes each selected Loghub 2k sample once, runs every query with
`nesso search --json -k 10` for each requested mode, and reports recall@10,
MRR, and nDCG@10. Relevance is a set of lines: the listed LineIds, or every
line whose EventId is listed. Report-only: exit 0 for any scores; non-zero
only on errors.
"""

from __future__ import annotations

import argparse
import csv
import json
import math
import os
import statistics
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
BENCH_DIR = ROOT / "build" / "bench"
QUERIES_DIR = ROOT / "test" / "eval" / "queries"
DEFAULT_QUERIES = QUERIES_DIR / "hdfs_2k.jsonl"
DEFAULT_LOG = BENCH_DIR / "HDFS_2k.log"
DEFAULT_STRUCTURED = BENCH_DIR / "HDFS_2k.log_structured.csv"
DEFAULT_MODES = ("auto", "hybrid", "dense", "lexical")
VALID_CLASSES = frozenset({"exact_id", "paraphrase", "cause"})
K = 10
FLOAT_DIGITS = 6
SCHEMA_VERSION = 3
TOKEN_CHARS = frozenset("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_")
ALL_2K = "all-2k"


@dataclass(frozen=True)
class DatasetSpec:
    name: str
    log_name: str
    queries_name: str

    @property
    def log_path(self) -> Path:
        return BENCH_DIR / self.log_name

    @property
    def structured_path(self) -> Path:
        return BENCH_DIR / f"{self.log_name}_structured.csv"

    @property
    def queries_path(self) -> Path:
        return QUERIES_DIR / self.queries_name

    @property
    def corpus_name(self) -> str:
        return self.name.replace("-", "_") + ".nesso"


DATASETS_2K: dict[str, DatasetSpec] = {
    "hdfs-2k": DatasetSpec("hdfs-2k", "HDFS_2k.log", "hdfs_2k.jsonl"),
    "bgl-2k": DatasetSpec("bgl-2k", "BGL_2k.log", "bgl_2k.jsonl"),
    "thunderbird-2k": DatasetSpec("thunderbird-2k", "Thunderbird_2k.log", "thunderbird_2k.jsonl"),
    "openssh-2k": DatasetSpec("openssh-2k", "OpenSSH_2k.log", "openssh_2k.jsonl"),
    "linux-2k": DatasetSpec("linux-2k", "Linux_2k.log", "linux_2k.jsonl"),
}


@dataclass(frozen=True)
class Query:
    id: str
    class_name: str
    query: str
    relevant_lines: frozenset[int] | None
    relevant_events: frozenset[str] | None


@dataclass(frozen=True)
class Metrics:
    recall_at_10: float
    mrr: float
    ndcg_at_10: float


def round_metric(value: float) -> float:
    return round(value, FLOAT_DIGITS)


def resolve_binary(explicit: str | None) -> Path:
    if explicit:
        path = Path(explicit)
        if not path.is_file():
            raise SystemExit(f"error: nesso binary not found: {path}")
        return path
    env = os.environ.get("NESSO_BINARY")
    if env:
        path = Path(env)
        if not path.is_file():
            raise SystemExit(f"error: nesso binary not found: {path}")
        return path
    for relative in (
        "build/Release/src/nesso",
        "build/Release/nesso",
        "build/Debug/src/nesso",
        "build/Debug/nesso",
    ):
        candidate = ROOT / relative
        if candidate.is_file():
            return candidate
    raise SystemExit("error: nesso binary not found; pass --binary or set NESSO_BINARY")


def resolve_model_dir(explicit: str | None) -> Path:
    if explicit:
        return Path(explicit)
    env = os.environ.get("NESSO_MODEL_DIR")
    if env:
        return Path(env)
    return ROOT / "models"


def _positive_line_ids(path: Path, lineno: int, raw: object) -> frozenset[int]:
    if not isinstance(raw, list) or not raw:
        raise SystemExit(f"error: {path}:{lineno}: relevant_lines must be a non-empty list of line ids")
    line_ids: list[int] = []
    for item in raw:
        if isinstance(item, bool) or not isinstance(item, int) or item < 1:
            raise SystemExit(f"error: {path}:{lineno}: relevant_lines must be positive integers")
        line_ids.append(item)
    return frozenset(line_ids)


def _event_ids(path: Path, lineno: int, raw: object) -> frozenset[str]:
    if not isinstance(raw, list) or not raw or not all(isinstance(item, str) and item for item in raw):
        raise SystemExit(f"error: {path}:{lineno}: relevant_events must be a non-empty string list")
    return frozenset(raw)


def load_queries(path: Path) -> list[Query]:
    if not path.is_file():
        raise SystemExit(f"error: query file not found: {path}")
    queries: list[Query] = []
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as exc:
        raise SystemExit(f"error: cannot read {path}: {exc}") from exc
    for lineno, raw in enumerate(text.splitlines(), start=1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        try:
            payload = json.loads(line)
        except json.JSONDecodeError as exc:
            raise SystemExit(f"error: {path}:{lineno}: invalid JSON: {exc}") from exc
        if not isinstance(payload, dict):
            raise SystemExit(f"error: {path}:{lineno}: query must be a JSON object")
        query_id = payload.get("id")
        class_name = payload.get("class")
        query_text = payload.get("query")
        if not isinstance(query_id, str) or not query_id:
            raise SystemExit(f"error: {path}:{lineno}: missing id")
        if class_name not in VALID_CLASSES:
            raise SystemExit(
                f"error: {path}:{lineno}: class must be one of {sorted(VALID_CLASSES)}"
            )
        if not isinstance(query_text, str) or not query_text:
            raise SystemExit(f"error: {path}:{lineno}: missing query")
        if "relevant" in payload:
            raise SystemExit(
                f"error: {path}:{lineno}: unknown key 'relevant'; use relevant_lines or relevant_events"
            )
        has_lines = "relevant_lines" in payload
        has_events = "relevant_events" in payload
        if has_lines == has_events:
            raise SystemExit(
                f"error: {path}:{lineno}: query must set exactly one of relevant_lines or relevant_events"
            )
        relevant_lines = _positive_line_ids(path, lineno, payload["relevant_lines"]) if has_lines else None
        relevant_events = _event_ids(path, lineno, payload["relevant_events"]) if has_events else None
        queries.append(
            Query(
                id=query_id,
                class_name=class_name,
                query=query_text,
                relevant_lines=relevant_lines,
                relevant_events=relevant_events,
            )
        )
    if not queries:
        raise SystemExit(f"error: {path}: no queries")
    return queries


def contains_whole_token(text: str, query: str) -> bool:
    if not query:
        return False
    start = 0
    while True:
        index = text.find(query, start)
        if index < 0:
            return False
        before_ok = index == 0 or text[index - 1] not in TOKEN_CHARS
        end = index + len(query)
        after_ok = end == len(text) or text[end] not in TOKEN_CHARS
        if before_ok and after_ok:
            return True
        start = index + 1


def read_log_lines(log_path: Path) -> list[str]:
    try:
        return log_path.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        raise SystemExit(f"error: cannot read {log_path}: {exc}") from exc


def validate_relevant_lines(queries: list[Query], log_path: Path, lines: list[str] | None = None) -> None:
    if lines is None:
        lines = read_log_lines(log_path)
    for query in queries:
        if query.relevant_lines is None:
            continue
        for line_id in sorted(query.relevant_lines):
            if line_id > len(lines):
                raise SystemExit(
                    f"error: query {query.id}: line {line_id} does not exist in {log_path} "
                    f"(query {query.query!r})"
                )
            if not contains_whole_token(lines[line_id - 1], query.query):
                raise SystemExit(
                    f"error: query {query.id}: line {line_id} does not contain {query.query!r} as a whole token"
                )


def load_event_ids(path: Path) -> dict[int, str]:
    if not path.is_file():
        raise SystemExit(f"error: structured CSV not found: {path}")
    mapping: dict[int, str] = {}
    try:
        with path.open(encoding="utf-8", newline="") as handle:
            reader = csv.DictReader(handle)
            if reader.fieldnames is None or "LineId" not in reader.fieldnames or "EventId" not in reader.fieldnames:
                raise SystemExit(f"error: {path}: missing LineId or EventId column")
            for row in reader:
                try:
                    line_id = int(row["LineId"])
                except (KeyError, TypeError, ValueError) as exc:
                    raise SystemExit(f"error: {path}: invalid LineId") from exc
                event_id = row.get("EventId")
                if not isinstance(event_id, str) or not event_id.strip():
                    raise SystemExit(f"error: {path}: missing EventId for LineId {line_id}")
                mapping[line_id] = event_id.strip()
    except OSError as exc:
        raise SystemExit(f"error: cannot read {path}: {exc}") from exc
    if not mapping:
        raise SystemExit(f"error: {path}: no rows")
    return mapping


def assert_line_id_alignment(log_path: Path, event_by_line: dict[int, str], lines: list[str] | None = None) -> None:
    if lines is None:
        lines = read_log_lines(log_path)
    line_count = len(lines)
    if len(event_by_line) != line_count:
        raise SystemExit(
            f"error: structured CSV row count {len(event_by_line)} does not match "
            f"log line count {line_count} for {log_path}"
        )
    expected = set(range(1, line_count + 1))
    actual = set(event_by_line)
    if actual != expected:
        raise SystemExit(
            f"error: structured CSV LineIds for {log_path} must be 1..{line_count} "
            f"(missing {sorted(expected - actual)[:5]}, extra {sorted(actual - expected)[:5]})"
        )


def relevant_set(query: Query, event_by_line: dict[int, str]) -> frozenset[int]:
    if query.relevant_lines is not None:
        return query.relevant_lines
    events = query.relevant_events
    if events is None:
        raise SystemExit(f"error: query {query.id} has no relevance labels")
    return frozenset(line_id for line_id, event_id in event_by_line.items() if event_id in events)


def recall_at_k(ranked_lines: list[int], relevant: frozenset[int], k: int = K) -> float:
    if not relevant:
        return 0.0
    found = {line_id for line_id in ranked_lines[:k] if line_id in relevant}
    return len(found) / min(k, len(relevant))


def mrr(ranked_lines: list[int], relevant: frozenset[int]) -> float:
    for index, line_id in enumerate(ranked_lines, start=1):
        if line_id in relevant:
            return 1.0 / index
    return 0.0


def dcg_at_k(gains: list[float], k: int = K) -> float:
    total = 0.0
    for index, gain in enumerate(gains[:k], start=1):
        total += gain / math.log2(index + 1)
    return total


def ndcg_at_k(ranked_lines: list[int], relevant: frozenset[int], k: int = K) -> float:
    gains = [1.0 if line_id in relevant else 0.0 for line_id in ranked_lines[:k]]
    ideal_hits = min(k, len(relevant))
    ideal = dcg_at_k([1.0] * ideal_hits, k)
    if ideal == 0.0:
        return 0.0
    return dcg_at_k(gains, k) / ideal


def score_ranking(ranked_lines: list[int], relevant: frozenset[int], k: int = K) -> Metrics:
    return Metrics(
        recall_at_10=recall_at_k(ranked_lines, relevant, k),
        mrr=mrr(ranked_lines, relevant),
        ndcg_at_10=ndcg_at_k(ranked_lines, relevant, k),
    )


def parse_search_json(stdout: str) -> list[dict]:
    hits: list[dict] = []
    for lineno, raw in enumerate(stdout.splitlines(), start=1):
        line = raw.strip()
        if not line:
            continue
        try:
            payload = json.loads(line)
        except json.JSONDecodeError as exc:
            raise SystemExit(f"error: unparseable search JSON on line {lineno}: {exc}") from exc
        if not isinstance(payload, dict):
            raise SystemExit(f"error: search JSON line {lineno} is not an object")
        if "line" not in payload:
            raise SystemExit(f"error: search JSON line {lineno} missing line")
        hits.append(payload)
    hits.sort(key=lambda item: int(item.get("rank", len(hits) + 1)))
    return hits


def lines_for_hits(hits: list[dict]) -> list[int]:
    ranked: list[int] = []
    for hit in hits[:K]:
        try:
            line_id = int(hit["line"])
        except (TypeError, ValueError) as exc:
            raise SystemExit(f"error: invalid line in search hit: {hit.get('line')!r}") from exc
        ranked.append(line_id)
    return ranked


def run_command(
    command: list[str],
    *,
    label: str,
    ok_codes: frozenset[int] = frozenset({0}),
) -> subprocess.CompletedProcess[str]:
    try:
        completed = subprocess.run(
            command,
            capture_output=True,
            text=True,
            check=False,
        )
    except OSError as exc:
        raise SystemExit(f"error: failed to run {label}: {exc}") from exc
    if completed.returncode not in ok_codes:
        detail = completed.stderr.strip() or completed.stdout.strip() or f"exit {completed.returncode}"
        raise SystemExit(f"error: {label} failed: {detail}")
    return completed


def run_checked(command: list[str], *, label: str) -> subprocess.CompletedProcess[str]:
    return run_command(command, label=label, ok_codes=frozenset({0}))


def mean_metrics(items: list[Metrics]) -> Metrics:
    if not items:
        return Metrics(0.0, 0.0, 0.0)
    return Metrics(
        recall_at_10=statistics.fmean(item.recall_at_10 for item in items),
        mrr=statistics.fmean(item.mrr for item in items),
        ndcg_at_10=statistics.fmean(item.ndcg_at_10 for item in items),
    )


def metrics_dict(metrics: Metrics) -> dict[str, float]:
    return {
        "mrr": round_metric(metrics.mrr),
        "ndcg_at_10": round_metric(metrics.ndcg_at_10),
        "recall_at_10": round_metric(metrics.recall_at_10),
    }


def format_mode_table(modes: list[dict]) -> str:
    headers = ("mode", "class", "n", "recall@10", "MRR", "nDCG@10")
    rows: list[tuple[str, str, str, str, str, str]] = []
    for mode in modes:
        mode_name = mode["mode"]
        for bucket in mode["by_class"]:
            metrics = bucket["metrics"]
            rows.append(
                (
                    mode_name,
                    bucket["class"],
                    str(bucket["n"]),
                    f"{metrics['recall_at_10']:0.6f}",
                    f"{metrics['mrr']:0.6f}",
                    f"{metrics['ndcg_at_10']:0.6f}",
                )
            )
        overall = mode["overall"]["metrics"]
        rows.append(
            (
                mode_name,
                "overall",
                str(mode["overall"]["n"]),
                f"{overall['recall_at_10']:0.6f}",
                f"{overall['mrr']:0.6f}",
                f"{overall['ndcg_at_10']:0.6f}",
            )
        )
    widths = [len(header) for header in headers]
    for row in rows:
        for index, cell in enumerate(row):
            widths[index] = max(widths[index], len(cell))
    lines = [
        "  ".join(header.ljust(widths[index]) for index, header in enumerate(headers)),
        "  ".join("-" * widths[index] for index in range(len(headers))),
    ]
    for row in rows:
        lines.append("  ".join(cell.ljust(widths[index]) for index, cell in enumerate(row)))
    return "\n".join(lines)


def format_report(payload: dict) -> str:
    sections: list[str] = []
    for dataset in payload["datasets"]:
        sections.append(f"=== {dataset['dataset']} ===")
        sections.append(format_mode_table(dataset["modes"]))
    sections.append("=== overall ===")
    sections.append(format_mode_table(payload["overall"]["modes"]))
    return "\n".join(sections)


def parse_datasets(raw: str | None) -> list[DatasetSpec] | None:
    if raw is None:
        return None
    parts = [part.strip() for part in raw.split(",") if part.strip()]
    if not parts:
        raise SystemExit("error: --dataset must list at least one dataset")
    names: list[str] = []
    for part in parts:
        if part == ALL_2K:
            names.extend(DATASETS_2K)
            continue
        if part not in DATASETS_2K:
            raise SystemExit(
                f"error: unknown dataset {part!r}; expected one of "
                f"{sorted(DATASETS_2K) + [ALL_2K]}"
            )
        names.append(part)
    # Preserve order, drop duplicates.
    seen: set[str] = set()
    ordered: list[DatasetSpec] = []
    for name in names:
        if name in seen:
            continue
        seen.add(name)
        ordered.append(DATASETS_2K[name])
    return ordered


def ensure_inputs(
    log_path: Path,
    structured_path: Path,
    *,
    fetch_dataset: str | None = None,
) -> None:
    if log_path.is_file() and structured_path.is_file():
        return
    fetch = ROOT / "scripts" / "fetch-loghub"
    if fetch_dataset is not None:
        if not fetch.is_file():
            raise SystemExit(f"error: missing log or structured CSV and {fetch} is absent")
        run_checked([sys.executable, str(fetch), "--dataset", fetch_dataset], label="fetch-loghub")
        if not log_path.is_file():
            raise SystemExit(f"error: log still missing after fetch-loghub: {log_path}")
        if not structured_path.is_file():
            raise SystemExit(f"error: structured CSV still missing after fetch-loghub: {structured_path}")
        return
    if log_path != DEFAULT_LOG or structured_path != DEFAULT_STRUCTURED:
        missing = []
        if not log_path.is_file():
            missing.append(str(log_path))
        if not structured_path.is_file():
            missing.append(str(structured_path))
        raise SystemExit(
            "error: missing input file(s): "
            + ", ".join(missing)
            + "; pass existing paths or use the default build/bench locations"
        )
    if not fetch.is_file():
        raise SystemExit(f"error: missing log or structured CSV and {fetch} is absent")
    run_checked([sys.executable, str(fetch), "--dataset", "hdfs-2k"], label="fetch-loghub")
    if not log_path.is_file():
        raise SystemExit(f"error: log still missing after fetch-loghub: {log_path}")
    if not structured_path.is_file():
        raise SystemExit(f"error: structured CSV still missing after fetch-loghub: {structured_path}")


def evaluate_modes(
    *,
    binary: Path,
    model_dir: Path,
    queries: list[Query],
    event_by_line: dict[int, str],
    log_path: Path,
    modes: list[str],
    corpus: Path,
) -> list[dict]:
    run_checked(
        [
            str(binary),
            "index",
            "-o",
            str(corpus),
            str(log_path),
            "--model-dir",
            str(model_dir),
        ],
        label="nesso index",
    )
    resolved = [(query, relevant_set(query, event_by_line)) for query in queries]
    mode_results = []
    for mode in modes:
        per_query: list[dict] = []
        by_class: dict[str, list[Metrics]] = {name: [] for name in sorted(VALID_CLASSES)}
        all_metrics: list[Metrics] = []
        for query, relevant in resolved:
            # Exit 1 is "no matches"; that is a valid empty ranking for metrics.
            completed = run_command(
                [
                    str(binary),
                    "search",
                    query.query,
                    "-i",
                    str(corpus),
                    "--json",
                    "-k",
                    str(K),
                    "--mode",
                    mode,
                    "--model-dir",
                    str(model_dir),
                ],
                label=f"nesso search ({mode}/{query.id})",
                ok_codes=frozenset({0, 1}),
            )
            hits = parse_search_json(completed.stdout)
            ranked = lines_for_hits(hits)
            metrics = score_ranking(ranked, relevant)
            all_metrics.append(metrics)
            by_class[query.class_name].append(metrics)
            per_query.append(
                {
                    "class": query.class_name,
                    "id": query.id,
                    "metrics": metrics_dict(metrics),
                    "ranked_lines": ranked,
                }
            )
        class_rows = []
        for class_name in sorted(VALID_CLASSES):
            items = by_class[class_name]
            class_rows.append(
                {
                    "class": class_name,
                    "metrics": metrics_dict(mean_metrics(items)),
                    "n": len(items),
                }
            )
        mode_results.append(
            {
                "by_class": class_rows,
                "mode": mode,
                "overall": {
                    "metrics": metrics_dict(mean_metrics(all_metrics)),
                    "n": len(all_metrics),
                },
                "queries": per_query,
            }
        )
    return mode_results


def aggregate_overall(dataset_results: list[dict], modes: list[str]) -> dict:
    mode_rows: list[dict] = []
    total_queries = sum(item["query_count"] for item in dataset_results)
    for mode_name in modes:
        by_class: dict[str, list[Metrics]] = {name: [] for name in sorted(VALID_CLASSES)}
        all_metrics: list[Metrics] = []
        for dataset in dataset_results:
            mode_payload = next(item for item in dataset["modes"] if item["mode"] == mode_name)
            for query in mode_payload["queries"]:
                metrics = Metrics(
                    recall_at_10=query["metrics"]["recall_at_10"],
                    mrr=query["metrics"]["mrr"],
                    ndcg_at_10=query["metrics"]["ndcg_at_10"],
                )
                all_metrics.append(metrics)
                by_class[query["class"]].append(metrics)
        class_rows = []
        for class_name in sorted(VALID_CLASSES):
            items = by_class[class_name]
            class_rows.append(
                {
                    "class": class_name,
                    "metrics": metrics_dict(mean_metrics(items)),
                    "n": len(items),
                }
            )
        mode_rows.append(
            {
                "by_class": class_rows,
                "mode": mode_name,
                "overall": {
                    "metrics": metrics_dict(mean_metrics(all_metrics)),
                    "n": len(all_metrics),
                },
            }
        )
    return {"modes": mode_rows, "query_count": total_queries}


def evaluate_dataset(
    *,
    binary: Path,
    model_dir: Path,
    queries: list[Query],
    event_by_line: dict[int, str],
    log_path: Path,
    modes: list[str],
    workdir: Path,
    corpus_name: str,
    dataset_name: str,
) -> dict:
    workdir.mkdir(parents=True, exist_ok=True)
    modes_payload = evaluate_modes(
        binary=binary,
        model_dir=model_dir,
        queries=queries,
        event_by_line=event_by_line,
        log_path=log_path,
        modes=modes,
        corpus=workdir / corpus_name,
    )
    return {
        "dataset": dataset_name,
        "modes": modes_payload,
        "query_count": len(queries),
    }


def parse_modes(raw: str) -> list[str]:
    modes = [part.strip() for part in raw.split(",") if part.strip()]
    if not modes:
        raise SystemExit("error: --modes must list at least one mode")
    allowed = set(DEFAULT_MODES)
    for mode in modes:
        if mode not in allowed:
            raise SystemExit(f"error: unknown mode {mode!r}; expected one of {sorted(allowed)}")
    return modes


def main(argv: list[str] | None = None) -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--out", type=Path, required=True, help="Deterministic JSON report path")
    parser.add_argument(
        "--dataset",
        default=None,
        help="Comma-separated 2k datasets or all-2k (maps log, CSV, and query file)",
    )
    parser.add_argument("--queries", type=Path, default=DEFAULT_QUERIES, help="JSONL query set")
    parser.add_argument("--log", type=Path, default=DEFAULT_LOG, help="Loghub 2k log path")
    parser.add_argument(
        "--structured",
        type=Path,
        default=DEFAULT_STRUCTURED,
        help="Loghub 2k structured CSV path",
    )
    parser.add_argument(
        "--modes",
        default=",".join(DEFAULT_MODES),
        help="Comma-separated search modes (default: auto,hybrid,dense,lexical)",
    )
    parser.add_argument("--binary", default=None, help="Path to the nesso executable")
    parser.add_argument("--model-dir", default=None, help="Directory with model.onnx and vocab.txt")
    parser.add_argument(
        "--workdir",
        type=Path,
        default=ROOT / "build" / "eval",
        help="Directory for the temporary corpus",
    )
    parser.add_argument(
        "--skip-fetch",
        action="store_true",
        help="Do not call fetch-loghub when inputs are missing",
    )
    args = parser.parse_args(argv)
    binary = resolve_binary(args.binary)
    model_dir = resolve_model_dir(args.model_dir)
    modes = parse_modes(args.modes)
    dataset_specs = parse_datasets(args.dataset)

    dataset_results: list[dict] = []
    if dataset_specs is None:
        queries = load_queries(args.queries)
        if not args.skip_fetch:
            ensure_inputs(args.log, args.structured)
        elif not args.log.is_file() or not args.structured.is_file():
            raise SystemExit("error: --log and --structured must exist when --skip-fetch is set")
        lines = read_log_lines(args.log)
        event_by_line = load_event_ids(args.structured)
        assert_line_id_alignment(args.log, event_by_line, lines)
        validate_relevant_lines(queries, args.log, lines)
        dataset_results.append(
            evaluate_dataset(
                binary=binary,
                model_dir=model_dir,
                queries=queries,
                event_by_line=event_by_line,
                log_path=args.log,
                modes=modes,
                workdir=args.workdir,
                corpus_name="hdfs_2k.nesso",
                dataset_name="hdfs-2k",
            )
        )
    else:
        for spec in dataset_specs:
            if not args.skip_fetch:
                ensure_inputs(spec.log_path, spec.structured_path, fetch_dataset=spec.name)
            elif not spec.log_path.is_file() or not spec.structured_path.is_file():
                raise SystemExit(
                    f"error: --log and --structured must exist when --skip-fetch is set "
                    f"({spec.log_path}, {spec.structured_path})"
                )
            queries = load_queries(spec.queries_path)
            lines = read_log_lines(spec.log_path)
            event_by_line = load_event_ids(spec.structured_path)
            assert_line_id_alignment(spec.log_path, event_by_line, lines)
            validate_relevant_lines(queries, spec.log_path, lines)
            dataset_results.append(
                evaluate_dataset(
                    binary=binary,
                    model_dir=model_dir,
                    queries=queries,
                    event_by_line=event_by_line,
                    log_path=spec.log_path,
                    modes=modes,
                    workdir=args.workdir,
                    corpus_name=spec.corpus_name,
                    dataset_name=spec.name,
                )
            )

    overall = aggregate_overall(dataset_results, modes)
    payload = {
        "datasets": dataset_results,
        "k": K,
        "overall": overall,
        "schema_version": SCHEMA_VERSION,
    }
    encoded = json.dumps(payload, sort_keys=True, separators=(",", ":")) + "\n"
    args.out.parent.mkdir(parents=True, exist_ok=True)
    args.out.write_text(encoded, encoding="utf-8")
    print(format_report(payload))
    print(f"wrote {args.out}")


if __name__ == "__main__":
    try:
        main()
    except SystemExit as exc:
        code = exc.code
        if isinstance(code, str):
            print(code, file=sys.stderr)
            raise SystemExit(1) from exc
        raise
