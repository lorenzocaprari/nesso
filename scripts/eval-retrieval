@dataclass(frozen=True)
class Query:
    id: str
    class_name: str
    query: str
    relevant_lines: frozenset[int] | None
    relevant_events: frozenset[str] | None


@dataclass(frozen=True)
class Metrics:
    recall_at_10: float
    mrr: float
    ndcg_at_10: float


class RankEngine(Protocol):
    name: str

    def availability(self) -> tuple[bool, str]:
        """(True, "") if usable; (False, reason) if skipped."""

    def prepare(self, log_path: Path, lines: list[str], workdir: Path) -> None:
        """Per-dataset setup."""

    def rank(self, query: str, *, k: int = K) -> list[int]:
        """Up to k distinct 1-based line ids, best-first."""


def round_metric(value: float) -> float:
    return round(value, FLOAT_DIGITS)


def median_value(values: list[float] | list[int]) -> float | None:
    if not values:
        return None
    return round_metric(float(statistics.median(values)))


def percentile_p95(values: list[float]) -> float | None:
    """Nearest-rank 95th percentile: index = ceil(0.95 * n) - 1."""
    if not values:
        return None
    ordered = sorted(values)
    index = max(0, math.ceil(0.95 * len(ordered)) - 1)
    return round_metric(ordered[index])


def index_to_log_ratio(index_bytes: int | None, log_bytes: int) -> float | None:
    if index_bytes is None:
        return None
    if log_bytes <= 0:
        raise SystemExit("error: log bytes must be positive for index ratio")
    return round_metric(index_bytes / float(log_bytes))


def directory_size_bytes(path: Path) -> int:
    if path.is_file():
        return path.stat().st_size
    if not path.exists():
        return 0
    total = 0
    for root, _dirs, files in os.walk(path):
        for name in files:
            total += (Path(root) / name).stat().st_size
    return total


def format_measure_none(value: float | int | None) -> str:
    if value is None:
        return "none"
    if isinstance(value, float):
        return f"{value:0.6f}"
    return str(value)


def gnu_time_binary() -> str:
    return os.environ.get("NESSO_BENCH_TIME", "/usr/bin/time")


def read_gnu_time(time_path: Path) -> tuple[float | None, int | None]:
    if not time_path.is_file():
        return None, None
    for line in reversed(time_path.read_text(encoding="utf-8", errors="replace").splitlines()):
        parts = line.split()
        if len(parts) < 2:
            continue
        try:
            return float(parts[0]), int(parts[1]) * 1024
        except ValueError:
            continue
    return None, None


def parse_cpu_model(text: str) -> str:
    for line in text.splitlines():
        if line.lower().startswith("model name"):
            return line.split(":", 1)[1].strip()
    return "unknown"


def cpu_model() -> str:
    path = Path("/proc/cpuinfo")
    if not path.is_file():
        return "unknown"
    return parse_cpu_model(path.read_text(encoding="utf-8", errors="replace"))


def logical_cpus() -> int:
    try:
        return int(subprocess.check_output(["nproc"], text=True).strip())
    except (OSError, subprocess.CalledProcessError, ValueError) as exc:
        raise SystemExit(f"error: nproc failed: {exc}") from exc


def threads_setting() -> str | None:
    value = os.environ.get("NESSO_THREADS")
    if value is None or value == "":
        return None
    return value


def execute_timed(
    argv: list[str],
    time_path: Path,
    *,
    timeout: float | None = None,
    env: dict[str, str] | None = None,
) -> dict[str, Any]:
    command = [gnu_time_binary(), "-f", "%e %M", "-o", str(time_path), *argv]
    started = time.perf_counter()
    merged = os.environ.copy()
    if env:
        merged.update(env)
    process = subprocess.Popen(
        command,
        env=merged,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        start_new_session=True,
    )
    try:
        stdout, stderr_bytes = process.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        os.killpg(process.pid, signal.SIGKILL)
        process.communicate()
        return {
            "exitCode": None,
            "stdout": "",
            "stderr": "",
            "wallSeconds": round(time.perf_counter() - started, 6),
            "peakRssBytes": None,
            "error": f"timed out after {timeout}s",
        }
    wall_seconds, peak_rss_bytes = read_gnu_time(time_path)
    if wall_seconds is None:
        wall_seconds = time.perf_counter() - started
    return {
        "exitCode": process.returncode,
        "stdout": stdout.decode("utf-8", "replace"),
        "stderr": stderr_bytes.decode("utf-8", "replace"),
        "wallSeconds": round(wall_seconds, 6),
        "peakRssBytes": peak_rss_bytes,
        "error": None,
    }


def load_diy_faiss_module() -> Any:
    """Load bench/competitors/diy_faiss.py only for diy-faiss and opensearch-knn."""
    if not DIY_FAISS_MODULE.is_file():
        raise SystemExit(f"error: missing diy-faiss module: {DIY_FAISS_MODULE}")
    spec = importlib.util.spec_from_file_location("nesso_diy_faiss", DIY_FAISS_MODULE)
    if spec is None or spec.loader is None:
        raise SystemExit(f"error: cannot load diy-faiss module: {DIY_FAISS_MODULE}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


def query_tokens(query: str) -> list[str]:
    return [tok for tok in query.split() if tok]


def resolve_binary(explicit: str | None) -> Path:
    if explicit:
        path = Path(explicit)
        if not path.is_file():
            raise SystemExit(f"error: nesso binary not found: {path}")
        return path
    env = os.environ.get("NESSO_BINARY")
    if env:
        path = Path(env)
        if not path.is_file():
            raise SystemExit(f"error: nesso binary not found: {path}")
        return path
    for relative in (
        "build/Release/src/nesso",
        "build/Release/nesso",
        "build/Debug/src/nesso",
        "build/Debug/nesso",
    ):
        candidate = ROOT / relative
        if candidate.is_file():
            return candidate
    raise SystemExit("error: nesso binary not found; pass --binary or set NESSO_BINARY")


def resolve_model_dir(explicit: str | None) -> Path:
    if explicit:
        return Path(explicit)
    env = os.environ.get("NESSO_MODEL_DIR")
    if env:
        return Path(env)
    return ROOT / "models"


def _positive_line_ids(path: Path, lineno: int, raw: object) -> frozenset[int]:
    if not isinstance(raw, list) or not raw:
        raise SystemExit(f"error: {path}:{lineno}: relevant_lines must be a non-empty list of line ids")
    line_ids: list[int] = []
    for item in raw:
        if isinstance(item, bool) or not isinstance(item, int) or item < 1:
            raise SystemExit(f"error: {path}:{lineno}: relevant_lines must be positive integers")
        line_ids.append(item)
    return frozenset(line_ids)


def _event_ids(path: Path, lineno: int, raw: object) -> frozenset[str]:
    if not isinstance(raw, list) or not raw or not all(isinstance(item, str) and item for item in raw):
        raise SystemExit(f"error: {path}:{lineno}: relevant_events must be a non-empty string list")
    return frozenset(raw)


def load_queries(path: Path) -> list[Query]:
    if not path.is_file():
        raise SystemExit(f"error: query file not found: {path}")
    queries: list[Query] = []
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as exc:
        raise SystemExit(f"error: cannot read {path}: {exc}") from exc
    for lineno, raw in enumerate(text.splitlines(), start=1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        try:
            payload = json.loads(line)
        except json.JSONDecodeError as exc:
            raise SystemExit(f"error: {path}:{lineno}: invalid JSON: {exc}") from exc
        if not isinstance(payload, dict):
            raise SystemExit(f"error: {path}:{lineno}: query must be a JSON object")
        query_id = payload.get("id")
        class_name = payload.get("class")
        query_text = payload.get("query")
        if not isinstance(query_id, str) or not query_id:
            raise SystemExit(f"error: {path}:{lineno}: missing id")
        if class_name not in VALID_CLASSES:
            raise SystemExit(
                f"error: {path}:{lineno}: class must be one of {sorted(VALID_CLASSES)}"
            )
        if not isinstance(query_text, str) or not query_text:
            raise SystemExit(f"error: {path}:{lineno}: missing query")
        if "relevant" in payload:
            raise SystemExit(
                f"error: {path}:{lineno}: unknown key 'relevant'; use relevant_lines or relevant_events"
            )
        has_lines = "relevant_lines" in payload
        has_events = "relevant_events" in payload
        if has_lines == has_events:
            raise SystemExit(
                f"error: {path}:{lineno}: query must set exactly one of relevant_lines or relevant_events"
            )
        relevant_lines = _positive_line_ids(path, lineno, payload["relevant_lines"]) if has_lines else None
        relevant_events = _event_ids(path, lineno, payload["relevant_events"]) if has_events else None
        queries.append(
            Query(
                id=query_id,
                class_name=class_name,
                query=query_text,
                relevant_lines=relevant_lines,
                relevant_events=relevant_events,
            )
        )
    if not queries:
        raise SystemExit(f"error: {path}: no queries")
    return queries


def contains_whole_token(text: str, query: str) -> bool:
    if not query:
        return False
    start = 0
    while True:
        index = text.find(query, start)
        if index < 0:
            return False
        before_ok = index == 0 or text[index - 1] not in TOKEN_CHARS
        end = index + len(query)
        after_ok = end == len(text) or text[end] not in TOKEN_CHARS
        if before_ok and after_ok:
            return True
        start = index + 1


def read_log_lines(log_path: Path) -> list[str]:
    try:
        return log_path.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        raise SystemExit(f"error: cannot read {log_path}: {exc}") from exc


def validate_relevant_lines(queries: list[Query], log_path: Path, lines: list[str] | None = None) -> None:
    if lines is None:
        lines = read_log_lines(log_path)
    for query in queries:
        if query.relevant_lines is None:
            continue
        for line_id in sorted(query.relevant_lines):
            if line_id > len(lines):
                raise SystemExit(
                    f"error: query {query.id}: line {line_id} does not exist in {log_path} "
                    f"(query {query.query!r})"
                )
            if not contains_whole_token(lines[line_id - 1], query.query):
                raise SystemExit(
                    f"error: query {query.id}: line {line_id} does not contain {query.query!r} as a whole token"
                )


def load_event_ids(path: Path) -> dict[int, str]:
    if not path.is_file():
        raise SystemExit(f"error: structured CSV not found: {path}")
    mapping: dict[int, str] = {}
    try:
        with path.open(encoding="utf-8", newline="") as handle:
            reader = csv.DictReader(handle)
            if reader.fieldnames is None or "LineId" not in reader.fieldnames or "EventId" not in reader.fieldnames:
                raise SystemExit(f"error: {path}: missing LineId or EventId column")
            for row in reader:
                try:
                    line_id = int(row["LineId"])
                except (KeyError, TypeError, ValueError) as exc:
                    raise SystemExit(f"error: {path}: invalid LineId") from exc
                event_id = row.get("EventId")
                if not isinstance(event_id, str) or not event_id.strip():
                    raise SystemExit(f"error: {path}: missing EventId for LineId {line_id}")
                mapping[line_id] = event_id.strip()
    except OSError as exc:
        raise SystemExit(f"error: cannot read {path}: {exc}") from exc
    if not mapping:
        raise SystemExit(f"error: {path}: no rows")
    return mapping


def assert_line_id_alignment(log_path: Path, event_by_line: dict[int, str], lines: list[str] | None = None) -> None:
    if lines is None:
        lines = read_log_lines(log_path)
    line_count = len(lines)
    if len(event_by_line) != line_count:
        raise SystemExit(
            f"error: structured CSV row count {len(event_by_line)} does not match "
            f"log line count {line_count} for {log_path}"
        )
    expected = set(range(1, line_count + 1))
    actual = set(event_by_line)
    if actual != expected:
        raise SystemExit(
            f"error: structured CSV LineIds for {log_path} must be 1..{line_count} "
            f"(missing {sorted(expected - actual)[:5]}, extra {sorted(actual - expected)[:5]})"
        )


def relevant_set(query: Query, event_by_line: dict[int, str]) -> frozenset[int]:
    if query.relevant_lines is not None:
        return query.relevant_lines
    events = query.relevant_events
    if events is None:
        raise SystemExit(f"error: query {query.id} has no relevance labels")
    return frozenset(line_id for line_id, event_id in event_by_line.items() if event_id in events)


def recall_at_k(ranked_lines: list[int], relevant: frozenset[int], k: int = K) -> float:
    if not relevant:
        return 0.0
    found = {line_id for line_id in ranked_lines[:k] if line_id in relevant}
    return len(found) / min(k, len(relevant))


def mrr(ranked_lines: list[int], relevant: frozenset[int]) -> float:
    for index, line_id in enumerate(ranked_lines, start=1):
        if line_id in relevant:
            return 1.0 / index
    return 0.0


def dcg_at_k(gains: list[float], k: int = K) -> float:
    total = 0.0
    for index, gain in enumerate(gains[:k], start=1):
        total += gain / math.log2(index + 1)
    return total


def ndcg_at_k(ranked_lines: list[int], relevant: frozenset[int], k: int = K) -> float:
    gains = [1.0 if line_id in relevant else 0.0 for line_id in ranked_lines[:k]]
    ideal_hits = min(k, len(relevant))
    ideal = dcg_at_k([1.0] * ideal_hits, k)
    if ideal == 0.0:
        return 0.0
    return dcg_at_k(gains, k) / ideal


def score_ranking(ranked_lines: list[int], relevant: frozenset[int], k: int = K) -> Metrics:
    return Metrics(
        recall_at_10=recall_at_k(ranked_lines, relevant, k),
        mrr=mrr(ranked_lines, relevant),
        ndcg_at_10=ndcg_at_k(ranked_lines, relevant, k),
    )


def parse_search_json(stdout: str) -> list[dict]:
    hits: list[dict] = []
    for lineno, raw in enumerate(stdout.splitlines(), start=1):
        line = raw.strip()
        if not line:
            continue
        try:
            payload = json.loads(line)
        except json.JSONDecodeError as exc:
            raise SystemExit(f"error: unparseable search JSON on line {lineno}: {exc}") from exc
        if not isinstance(payload, dict):
            raise SystemExit(f"error: search JSON line {lineno} is not an object")
        if "line" not in payload:
            raise SystemExit(f"error: search JSON line {lineno} missing line")
        hits.append(payload)
    hits.sort(key=lambda item: int(item.get("rank", len(hits) + 1)))
    return hits


def lines_for_hits(hits: list[dict], k: int = K) -> list[int]:
    ranked: list[int] = []
    for hit in hits[:k]:
        try:
            line_id = int(hit["line"])
        except (TypeError, ValueError) as exc:
            raise SystemExit(f"error: invalid line in search hit: {hit.get('line')!r}") from exc
        ranked.append(line_id)
    return ranked


def run_command(
    command: list[str],
    *,
    label: str,
    ok_codes: frozenset[int] = frozenset({0}),
    cwd: Path | None = None,
) -> subprocess.CompletedProcess[str]:
    try:
        completed = subprocess.run(
            command,
            capture_output=True,
            text=True,
            check=False,
            cwd=cwd,
        )
    except OSError as exc:
        raise SystemExit(f"error: failed to run {label}: {exc}") from exc
    if completed.returncode not in ok_codes:
        detail = completed.stderr.strip() or completed.stdout.strip() or f"exit {completed.returncode}"
        raise SystemExit(f"error: {label} failed: {detail}")
    return completed


def run_checked(
    command: list[str], *, label: str, cwd: Path | None = None
) -> subprocess.CompletedProcess[str]:
    return run_command(command, label=label, ok_codes=frozenset({0}), cwd=cwd)


def mean_metrics(items: list[Metrics]) -> Metrics:
    if not items:
        return Metrics(0.0, 0.0, 0.0)
    return Metrics(
        recall_at_10=statistics.fmean(item.recall_at_10 for item in items),
        mrr=statistics.fmean(item.mrr for item in items),
        ndcg_at_10=statistics.fmean(item.ndcg_at_10 for item in items),
    )


def metrics_dict(metrics: Metrics) -> dict[str, float]:
    return {
        "mrr": round_metric(metrics.mrr),
        "ndcg_at_10": round_metric(metrics.ndcg_at_10),
        "recall_at_10": round_metric(metrics.recall_at_10),
    }


def parse_fixed_line_matches(stdout: str) -> list[int]:
    """Parse `grep -n` / `rg -n` output into 1-based line ids in file order."""
    ranked: list[int] = []
    seen: set[int] = set()
    for raw in stdout.splitlines():
        if not raw:
            continue
        # Format: <line>:<text> — take the leading integer before the first colon.
        colon = raw.find(":")
        if colon <= 0:
            continue
        try:
            line_id = int(raw[:colon])
        except ValueError:
            continue
        if line_id < 1 or line_id in seen:
            continue
        seen.add(line_id)
        ranked.append(line_id)
    return ranked


def fixed_pattern_rank(
    argv_prefix: list[str],
    log_path: Path,
    query: str,
    *,
    k: int = K,
    label: str,
) -> list[int]:
    """Exact fixed-string match, else OR of whitespace tokens; file order, top k."""
    exact = run_command(
        [*argv_prefix, "-e", query, "--", str(log_path)],
        label=f"{label} exact",
        ok_codes=frozenset({0, 1}),
    )
    ranked = parse_fixed_line_matches(exact.stdout)
    if ranked:
        return ranked[:k]
    tokens = query_tokens(query)
    if not tokens:
        return []
    command = list(argv_prefix)
    for token in tokens:
        command.extend(["-e", token])
    command.extend(["--", str(log_path)])
    fallback = run_command(
        command,
        label=f"{label} token-or",
        ok_codes=frozenset({0, 1}),
    )
    return parse_fixed_line_matches(fallback.stdout)[:k]


def fts5_quote_token(token: str) -> str:
    return '"' + token.replace('"', '""') + '"'


def fts5_or_query(tokens: list[str]) -> str:
    return " OR ".join(fts5_quote_token(token) for token in tokens)


def require_fts5() -> None:
    try:
        conn = sqlite3.connect(":memory:")
        try:
            conn.execute("CREATE VIRTUAL TABLE probe USING fts5(x)")
        finally:
            conn.close()
    except sqlite3.Error as exc:
        raise SystemExit(
            f"error: Python sqlite3 build lacks FTS5 (required for --engine bm25): {exc}"
        ) from exc


@dataclass
class NessoEngine:
    name: str = "nesso"
    binary: Path = Path()
    model_dir: Path = Path()
    corpus: Path | None = None

    def availability(self) -> tuple[bool, str]:
        return True, ""

    def prepare(self, log_path: Path, lines: list[str], workdir: Path) -> None:
        del lines
        workdir.mkdir(parents=True, exist_ok=True)
        if self.corpus is None:
            raise SystemExit("error: nesso engine missing corpus path")
        run_checked(
            [
                str(self.binary),
                "index",
                "-o",
                str(self.corpus),
                str(log_path),
                "--model-dir",
                str(self.model_dir),
            ],
            label="nesso index",
        )

    def rank(self, query: str, *, k: int = K) -> list[int]:
        return self.rank_mode(query, "dense", k=k)

    def rank_mode(self, query: str, mode: str, *, k: int = K) -> list[int]:
        if self.corpus is None:
            raise SystemExit("error: nesso engine not prepared")
        completed = run_command(
            [
                str(self.binary),
                "search",
                query,
                "-i",
                str(self.corpus),
                "--json",
                "-k",
                str(k),
                "--mode",
                mode,
                "--model-dir",
                str(self.model_dir),
            ],
            label=f"nesso search ({mode})",
            ok_codes=frozenset({0, 1}),
        )
        return lines_for_hits(parse_search_json(completed.stdout), k)


@dataclass
class GrepEngine:
    name: str = "grep"
    _log_path: Path | None = None

    def availability(self) -> tuple[bool, str]:
        if shutil.which("grep") is None:
            return False, "grep executable not found"
        return True, ""

    def prepare(self, log_path: Path, lines: list[str], workdir: Path) -> None:
        del lines, workdir
        ok, reason = self.availability()
        if not ok:
            raise SystemExit(f"error: {reason}")
        self._log_path = log_path

    def rank(self, query: str, *, k: int = K) -> list[int]:
        if self._log_path is None:
            raise SystemExit("error: grep engine not prepared")
        return fixed_pattern_rank(
            ["grep", "-n", "-F", "-i"],
            self._log_path,
            query,
            k=k,
            label="grep",
        )


@dataclass
class RipgrepEngine:
    name: str = "ripgrep"
    _log_path: Path | None = None
    _skip_reason: str | None = None

    def availability(self) -> tuple[bool, str]:
        if shutil.which("rg") is None:
            return False, "rg executable not found"
        return True, ""

    def prepare(self, log_path: Path, lines: list[str], workdir: Path) -> None:
        del lines, workdir
        ok, reason = self.availability()
        if not ok:
            self._skip_reason = reason
            self._log_path = None
            return
        self._skip_reason = None
        self._log_path = log_path

    def rank(self, query: str, *, k: int = K) -> list[int]:
        if self._skip_reason is not None:
            raise SystemExit(f"error: ripgrep skipped: {self._skip_reason}")
        if self._log_path is None:
            raise SystemExit("error: ripgrep engine not prepared")
        return fixed_pattern_rank(
            ["rg", "-n", "-F", "-i"],
            self._log_path,
            query,
            k=k,
            label="ripgrep",
        )


@dataclass(frozen=True)
class ChunkHit:
    """One ranked chunk from a chunking CLI: an inclusive 1-based line span."""

    score: float
    line_start: int
    line_end: int


def expand_chunk_hits(hits: list[ChunkHit], *, k: int = K, max_line: int | None = None) -> list[int]:
    """Turn ranked chunks into ranked lines.

    Chunks are ordered by (-score, line_start, line_end). Each chunk contributes
    its lines in file order; a line already emitted by an earlier (overlapping)
    chunk is skipped. Stops at k lines.
    """
    ordered = sorted(hits, key=lambda hit: (-hit.score, hit.line_start, hit.line_end))
    ranked: list[int] = []
    seen: set[int] = set()
    for hit in ordered:
        start = max(1, hit.line_start)
        end = hit.line_end if max_line is None else min(hit.line_end, max_line)
        for line_id in range(start, end + 1):
            if line_id in seen:
                continue
            seen.add(line_id)
            ranked.append(line_id)
            if len(ranked) >= k:
                return ranked
    return ranked


def _json_records(stdout: str, *, label: str) -> list[dict]:
    records: list[dict] = []
    for raw in stdout.splitlines():
        text = raw.strip()
        # Status lines that slip past --quiet are not results.
        if not text.startswith("{"):
            continue
        try:
            record = json.loads(text)
        except json.JSONDecodeError as exc:
            raise SystemExit(f"error: {label} printed malformed JSON: {exc}: {text[:200]}") from exc
        if isinstance(record, dict):
            records.append(record)
    return records


def _int_field(record: dict, key: str, *, label: str) -> int:
    value = record.get(key)
    if isinstance(value, bool) or not isinstance(value, int):
        raise SystemExit(f"error: {label} result has no integer {key!r}: {record}")
    return value


def _score_field(record: dict) -> float:
    value = record.get("score")
    return float(value) if isinstance(value, (int, float)) else 0.0


def parse_ck_jsonl(stdout: str, log_name: str) -> list[ChunkHit]:
    """Parse `ck --jsonl` (path, span.line_start, span.line_end, score)."""
    hits: list[ChunkHit] = []
    for record in _json_records(stdout, label="ck"):
        if Path(str(record.get("path", ""))).name != log_name:
            continue
        span = record.get("span")
        if not isinstance(span, dict):
            raise SystemExit(f"error: ck result has no span: {record}")
        hits.append(
            ChunkHit(
                score=_score_field(record),
                line_start=_int_field(span, "line_start", label="ck"),
                line_end=_int_field(span, "line_end", label="ck"),
            )
        )
    return hits


def parse_vecgrep_json(stdout: str, log_name: str) -> list[ChunkHit]:
    """Parse `vecgrep --json` lines (file, start_line, end_line, score)."""
    hits: list[ChunkHit] = []
    for record in _json_records(stdout, label="vecgrep"):
        if Path(str(record.get("file", ""))).name != log_name:
            continue
        hits.append(
            ChunkHit(
                score=_score_field(record),
                line_start=_int_field(record, "start_line", label="vecgrep"),
                line_end=_int_field(record, "end_line", label="vecgrep"),
            )
        )
    return hits


@dataclass(frozen=True)
class ChunkCliSpec:
    """How to drive one chunk-indexing semantic grep CLI."""

    name: str
    executable: str
    # Directory created in the corpus root so the tool treats it as the project root.
    root_marker: str | None
    index_args: tuple[str, ...]
    search_args: Callable[[int], list[str]]
    parse: Callable[[str, str], list[ChunkHit]]


CHUNK_CLI_SPECS: dict[str, ChunkCliSpec] = {
    # --threshold 0: ck's semantic default (0.6) would drop results below
    # the top 10 that every other engine returns.
    "ck": ChunkCliSpec(
        name="ck",
        executable="ck",
        root_marker=None,
        index_args=("--index", "--quiet", "."),
        search_args=lambda k: [
            "--sem",
            "--jsonl",
            "--no-snippet",
            "--quiet",
            "--topk",
            str(k),
            "--threshold",
            "0",
        ],
        parse=parse_ck_jsonl,
    ),
    # A .vecgrep directory pins the project root (and index) to the corpus dir.
    "vecgrep": ChunkCliSpec(
        name="vecgrep",
        executable="vecgrep",
        root_marker=".vecgrep",
        index_args=("--index-only", "--quiet"),
        search_args=lambda k: ["--json", "--quiet", "-k", str(k), "--threshold", "0"],
        parse=parse_vecgrep_json,
    ),
}


def chunk_cli_setup_root(spec: ChunkCliSpec, root: Path, log_path: Path) -> Path:
    """Create an isolated corpus root holding only the log; return the log copy."""
    if root.exists():
        shutil.rmtree(root)
    root.mkdir(parents=True)
    if spec.root_marker is not None:
        (root / spec.root_marker).mkdir()
    target = root / log_path.name
    try:
        os.link(log_path, target)
    except OSError:
        shutil.copyfile(log_path, target)
    return target


def chunk_cli_index(spec: ChunkCliSpec, root: Path) -> None:
    run_checked([spec.executable, *spec.index_args], label=f"{spec.name} index", cwd=root)


def chunk_cli_search(
    spec: ChunkCliSpec,
    root: Path,
    log_name: str,
    query: str,
    *,
    k: int = K,
    max_line: int | None = None,
) -> list[int]:
    completed = run_command(
        [spec.executable, *spec.search_args(k), "--", query, log_name],
        label=f"{spec.name} search",
        ok_codes=frozenset({0, 1}),
        cwd=root,
    )
    return expand_chunk_hits(spec.parse(completed.stdout, log_name), k=k, max_line=max_line)


def chunk_cli_index_bytes(root: Path, log_path: Path) -> int:
    """Corpus root size minus the log itself: the tool's index and metadata."""
    return max(0, directory_size_bytes(root) - log_path.stat().st_size)


@dataclass
class ChunkCliEngine:
    spec: ChunkCliSpec
    _root: Path | None = None
    _log_name: str | None = None
    _n_lines: int = 0

    @property
    def name(self) -> str:
        return self.spec.name

    def availability(self) -> tuple[bool, str]:
        if shutil.which(self.spec.executable) is None:
            return False, f"{self.spec.executable} executable not found"
        return True, ""

    def prepare(self, log_path: Path, lines: list[str], workdir: Path) -> None:
        root = workdir / f"{self.spec.name}-corpus"
        chunk_cli_setup_root(self.spec, root, log_path)
        chunk_cli_index(self.spec, root)
        self._root = root
        self._log_name = log_path.name
        self._n_lines = len(lines)

    def rank(self, query: str, *, k: int = K) -> list[int]:
        if self._root is None or self._log_name is None:
            raise SystemExit(f"error: {self.spec.name} engine not prepared")
        return chunk_cli_search(
            self.spec,
            self._root,
            self._log_name,
            query,
            k=k,
            max_line=self._n_lines,
        )

    def versions(self) -> dict[str, str]:
        return {"version": tool_version_line([self.spec.executable, "--version"])}


@dataclass
class Bm25Engine:
    name: str = "bm25"
    _conn: sqlite3.Connection | None = None

    def availability(self) -> tuple[bool, str]:
        try:
            require_fts5()
        except SystemExit as exc:
            return False, str(exc).removeprefix("error: ")
        return True, ""

    def prepare(self, log_path: Path, lines: list[str], workdir: Path) -> None:
        del log_path, workdir
        require_fts5()
        if self._conn is not None:
            self._conn.close()
        self._conn = sqlite3.connect(":memory:")
        self._conn.execute("CREATE VIRTUAL TABLE lines USING fts5(content)")
        self._conn.executemany(
            "INSERT INTO lines(rowid, content) VALUES (?, ?)",
            ((index, text) for index, text in enumerate(lines, start=1)),
        )
        self._conn.commit()

    def rank(self, query: str, *, k: int = K) -> list[int]:
        if self._conn is None:
            raise SystemExit("error: bm25 engine not prepared")
        tokens = query_tokens(query)
        if not tokens:
            return []
        match = fts5_or_query(tokens)
        rows = self._conn.execute(
            "SELECT rowid FROM lines WHERE lines MATCH ? ORDER BY bm25(lines), rowid LIMIT ?",
            (match, k),
        ).fetchall()
        return [int(row[0]) for row in rows]


def es_request(
    method: str,
    url: str,
    body: bytes | dict | list | str | None = None,
    *,
    content_type: str = "application/json",
    timeout: float = 120.0,
) -> Any:
    data: bytes | None = None
    headers: dict[str, str] = {}
    if body is not None:
        if isinstance(body, (dict, list)):
            data = json.dumps(body).encode("utf-8")
            headers["Content-Type"] = content_type
        elif isinstance(body, str):
            data = body.encode("utf-8")
            headers["Content-Type"] = content_type
        else:
            data = body
            headers["Content-Type"] = content_type
    request = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            raw = response.read()
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode("utf-8", errors="replace")
        raise SystemExit(f"error: ES {method} {url} -> HTTP {exc.code}: {detail}") from exc
    except urllib.error.URLError as exc:
        raise SystemExit(f"error: ES {method} {url} failed: {exc}") from exc
    if not raw:
        return {}
    try:
        return json.loads(raw.decode("utf-8"))
    except json.JSONDecodeError as exc:
        raise SystemExit(f"error: ES {method} {url} returned non-JSON") from exc


def assert_loopback_url(url: str, *, flag: str = "--xerj-url") -> str:
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme not in ("http", "https"):
        raise SystemExit(f"error: {flag} must be http(s), got {url!r}")
    host = (parsed.hostname or "").lower()
    if host not in ("127.0.0.1", "localhost", "::1"):
        raise SystemExit(f"error: {flag} must target localhost, got {host!r}")
    return url.rstrip("/")


def xerj_match_query(query: str, k: int) -> dict:
    return {"size": k, "query": {"match": {"text": query}}}


def xerj_semantic_query(query: str, k: int) -> dict:
    return {
        "size": k,
        "query": {"semantic": {"field": "text", "query": query, "k": k}},
    }


def xerj_neural_mappings() -> dict:
    return {
        "mappings": {
            "properties": {
                "line": {"type": "integer"},
                "text": {"type": "semantic_text"},
            }
        }
    }


def xerj_lexical_mappings() -> dict:
    return {
        "mappings": {
            "properties": {
                "line": {"type": "integer"},
                "text": {"type": "text"},
            }
        }
    }


def check_neural_model_dir(model_dir: Path | None) -> tuple[bool, str]:
    if model_dir is None:
        return False, "neural model dir not set (--xerj-model-dir)"
    if not model_dir.is_dir():
        return False, f"neural model dir not found: {model_dir}"
    missing = [name for name in XERJ_NEURAL_MODEL_FILES if not (model_dir / name).is_file()]
    if missing:
        return False, f"neural model files missing: {', '.join(missing)}"
    return True, ""


def xerj_version_from_binary(binary: Path | None) -> str:
    if binary is None or not binary.is_file():
        return "unknown"
    try:
        completed = subprocess.run(
            [str(binary), "-V"],
            capture_output=True,
            text=True,
            check=False,
            timeout=30,
        )
    except (OSError, subprocess.TimeoutExpired):
        return "unknown"
    line = (completed.stdout or completed.stderr or "").strip().splitlines()
    return line[0].strip() if line else "unknown"


def reserve_xerj_es_port() -> int:
    """Pick N such that N, N+1, and N+2 are free on 127.0.0.1 (--port derives +1/+2)."""
    for _ in range(64):
        holders: list[socket.socket] = []
        try:
            probe = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            probe.bind(("127.0.0.1", 0))
            port = int(probe.getsockname()[1])
            probe.close()
            for candidate in (port, port + 1, port + 2):
                sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                sock.bind(("127.0.0.1", candidate))
                holders.append(sock)
            return port
        except OSError:
            continue
        finally:
            for sock in holders:
                try:
                    sock.close()
                except OSError:
                    pass
    raise SystemExit("error: could not reserve three consecutive localhost ports for xerj")


def wait_xerj_ready(
    base_url: str,
    *,
    timeout: float = XERJ_READY_TIMEOUT_S,
    label: str = "xerj",
    proc: subprocess.Popen[str] | None = None,
) -> None:
    deadline = time.monotonic() + timeout
    health = f"{base_url}/_cluster/health"
    last_error = ""
    while time.monotonic() < deadline:
        if proc is not None and proc.poll() is not None:
            raise SystemExit(
                f"error: {label} exited with code {proc.returncode} before it was ready at {base_url}"
            )
        try:
            es_request("GET", health, timeout=2.0)
            return
        except SystemExit as exc:
            last_error = str(exc)
            time.sleep(0.25)
    raise SystemExit(f"error: {label} not ready at {base_url} within {timeout:.0f}s: {last_error}")


@dataclass
class XerjContext:
    url: str | None = None
    skip_reason: str | None = None
    neural_skip_reason: str | None = None
    url_mode: str = "external"
    binary: Path | None = None
    version: str = "unknown"
    # True when this context spawned the node with --embed-mode neural.
    neural_node: bool = False
    _proc: subprocess.Popen[str] | None = None
    _tmpdir: tempfile.TemporaryDirectory[str] | None = None
    _log_handle: Any = None

    def shutdown(self) -> None:
        stop_spawned_node(self._proc, self._log_handle, self._tmpdir)
        self._proc = None
        self._log_handle = None
        self._tmpdir = None


def stop_spawned_node(
    proc: subprocess.Popen[str] | None,
    log_handle: Any,
    tmpdir: tempfile.TemporaryDirectory[str] | None,
) -> None:
    """SIGTERM a spawned search node, then drop its log handle and temp dir."""
    if proc is not None and proc.poll() is None:
        proc.send_signal(signal.SIGTERM)
        try:
            proc.wait(timeout=30)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait(timeout=10)
    if log_handle is not None:
        log_handle.close()
    if tmpdir is not None:
        tmpdir.cleanup()


@dataclass
class SkippedEngine:
    name: str
    reason: str

    def availability(self) -> tuple[bool, str]:
        return False, self.reason

    def prepare(self, log_path: Path, lines: list[str], workdir: Path) -> None:
        del log_path, lines, workdir

    def rank(self, query: str, *, k: int = K) -> list[int]:
        del query, k
        raise SystemExit(f"error: {self.name} skipped: {self.reason}")


@dataclass
class EsCompatEngine:
    """Generic Elasticsearch-compatible RankEngine (stdlib HTTP only)."""

    name: str
    base_url: str
    index_name: str
    query_fn: Callable[[str, int], dict]
    mappings: dict | None = None
    xerj_version: str = "unknown"
    url_mode: str = "external"
    neural_model_download_size: str | None = None
    index_seconds: float = 0.0
    # Bulk documents for lines[start:start+len(texts)]; default {"line", "text"}.
    doc_batch_fn: Callable[[int, list[str]], list[dict]] | None = None
    # versions() key for the server version (xerj keeps "xerj_version").
    version_key: str = "xerj_version"
    extra_versions: dict[str, Any] | None = None
    _prepared: bool = False

    def availability(self) -> tuple[bool, str]:
        return True, ""

    def versions(self) -> dict[str, Any]:
        payload: dict[str, Any] = {
            "index_seconds": round(self.index_seconds, 6),
            "url_mode": self.url_mode,
            self.version_key: self.xerj_version,
        }
        if self.neural_model_download_size is not None:
            payload["neural_model_download_size"] = self.neural_model_download_size
        if self.extra_versions:
            payload.update(self.extra_versions)
        return payload

    def _bulk_docs(self, first_line_id: int, texts: list[str]) -> list[dict]:
        if self.doc_batch_fn is not None:
            docs = self.doc_batch_fn(first_line_id, texts)
            if len(docs) != len(texts):
                raise SystemExit(
                    f"error: {self.name} produced {len(docs)} documents for {len(texts)} lines"
                )
            return docs
        return [
            {"line": first_line_id + offset, "text": text} for offset, text in enumerate(texts)
        ]

    def prepare(self, log_path: Path, lines: list[str], workdir: Path) -> None:
        del log_path, workdir
        started = time.perf_counter()
        index_url = f"{self.base_url}/{self.index_name}"
        # Drop a leftover index from a previous crashed run.
        try:
            es_request("DELETE", index_url, timeout=30.0)
        except SystemExit:
            pass
        body = self.mappings if self.mappings is not None else {}
        es_request("PUT", index_url, body)
        for start in range(0, len(lines), ES_BULK_BATCH):
            chunk = lines[start : start + ES_BULK_BATCH]
            ndjson_parts: list[str] = []
            docs = self._bulk_docs(start + 1, chunk)
            for offset, doc in enumerate(docs):
                line_id = start + offset + 1
                ndjson_parts.append(json.dumps({"index": {"_id": str(line_id)}}))
                ndjson_parts.append(json.dumps(doc))
            payload = "\n".join(ndjson_parts) + "\n"
            response = es_request(
                "POST",
                f"{index_url}/_bulk",
                payload,
                content_type="application/x-ndjson",
            )
            if response.get("errors"):
                for item in response.get("items", []):
                    action = next(iter(item.values()), {})
                    if isinstance(action, dict) and action.get("error"):
                        raise SystemExit(
                            f"error: ES bulk item failed on {self.index_name}: {action['error']}"
                        )
                raise SystemExit(f"error: ES bulk reported errors on {self.index_name}")
        es_request("POST", f"{index_url}/_refresh", {})
        self.index_seconds = time.perf_counter() - started
        self._prepared = True

    def rank(self, query: str, *, k: int = K) -> list[int]:
        if not self._prepared:
            raise SystemExit(f"error: {self.name} engine not prepared")
        body = self.query_fn(query, k)
        response = es_request(
            "POST",
            f"{self.base_url}/{self.index_name}/_search",
            body,
        )
        hits = response.get("hits", {}).get("hits", [])
        scored: list[tuple[float, int]] = []
        for hit in hits:
            raw_id = hit.get("_id")
            try:
                line_id = int(raw_id)
            except (TypeError, ValueError) as exc:
                raise SystemExit(f"error: ES hit _id is not an int line id: {raw_id!r}") from exc
            score = hit.get("_score")
            score_value = float(score) if score is not None else 0.0
            scored.append((score_value, line_id))
        scored.sort(key=lambda item: (-item[0], item[1]))
        return [line_id for _, line_id in scored[:k]]

    def flush(self) -> None:
        """Flush segments to disk so a data-dir size counts the index, not the translog."""
        es_request("POST", f"{self.base_url}/{self.index_name}/_flush", {})

    def cleanup(self) -> None:
        if not self._prepared:
            return
        try:
            es_request("DELETE", f"{self.base_url}/{self.index_name}", timeout=30.0)
        except SystemExit:
            pass
        self._prepared = False


def resolve_xerj_binary(explicit: str | None) -> Path | None:
    if explicit:
        path = Path(explicit)
        if not path.is_file():
            raise SystemExit(f"error: xerj binary not found: {path}")
        return path
    found = shutil.which("xerj")
    return Path(found) if found else None


def open_xerj_context(
    *,
    engines: list[str],
    xerj_url: str | None,
    xerj_bin: str | None,
    xerj_model_dir: str | None,
) -> XerjContext:
    needs_xerj = bool(XERJ_ENGINES.intersection(engines))
    if not needs_xerj:
        return XerjContext()
    binary = resolve_xerj_binary(xerj_bin)
    model_dir = Path(xerj_model_dir) if xerj_model_dir else None
    needs_neural = "xerj-neural" in engines
    neural_ok, neural_reason = check_neural_model_dir(model_dir)

    if xerj_url:
        url = assert_loopback_url(xerj_url)
        ctx = XerjContext(
            url=url,
            url_mode="external",
            binary=binary,
            version=xerj_version_from_binary(binary),
        )
        # External node: model files are the operator's responsibility.
        return ctx

    if binary is None:
        return XerjContext(skip_reason="xerj executable not found")

    spawn_neural = needs_neural and neural_ok
    if needs_neural and not neural_ok and not {"xerj", "xerj-semantic"}.intersection(engines):
        return XerjContext(
            binary=binary,
            version=xerj_version_from_binary(binary),
            skip_reason=neural_reason,
            neural_skip_reason=neural_reason,
        )

    tmp = tempfile.TemporaryDirectory(prefix="nesso-xerj-")
    tmp_path = Path(tmp.name)
    data_dir = tmp_path / "data"
    data_dir.mkdir()
    port = reserve_xerj_es_port()
    cmd = [
        str(binary),
        "--insecure",
        "--data-dir",
        str(data_dir),
        "--port",
        str(port),
    ]
    if spawn_neural:
        assert model_dir is not None
        config_path = tmp_path / "xerj.toml"
        config_path.write_text(
            "[embedding]\n"
            'mode = "neural"\n'
            f'local_model_dir = "{model_dir.resolve()}"\n',
            encoding="utf-8",
        )
        cmd.extend(["--embed-mode", "neural", "--config", str(config_path)])

    log_path = tmp_path / "xerj.log"
    log_handle = log_path.open("w", encoding="utf-8")
    try:
        proc = subprocess.Popen(
            cmd,
            stdout=log_handle,
            stderr=subprocess.STDOUT,
            text=True,
        )
    except OSError as exc:
        log_handle.close()
        tmp.cleanup()
        raise SystemExit(f"error: failed to start xerj: {exc}") from exc

    url = f"http://127.0.0.1:{port}"
    ctx = XerjContext(
        url=url,
        url_mode="spawned",
        binary=binary,
        version=xerj_version_from_binary(binary),
        neural_skip_reason=None if spawn_neural or not needs_neural else neural_reason,
        neural_node=spawn_neural,
        _proc=proc,
        _tmpdir=tmp,
        _log_handle=log_handle,
    )
    try:
        wait_xerj_ready(url, proc=proc)
    except SystemExit:
        ctx.shutdown()
        raise
    return ctx


def make_xerj_engine(ctx: XerjContext, *, neural: bool, semantic: bool = False) -> RankEngine:
    name = "xerj-semantic" if semantic else ("xerj-neural" if neural else "xerj")
    if ctx.skip_reason:
        return SkippedEngine(name=name, reason=ctx.skip_reason)
    if semantic:
        if not ctx.url:
            return SkippedEngine(name=name, reason="xerj URL unavailable")
        if ctx.neural_node:
            # One spawned node serves every xerj engine in a run, and its
            # embedder is chosen at startup.
            return SkippedEngine(
                name=name,
                reason="xerj-semantic needs a node on the default lexical embedder; "
                "this run's node uses --embed-mode neural (run xerj-semantic without xerj-neural)",
            )
        return EsCompatEngine(
            name=name,
            base_url=ctx.url,
            index_name=XERJ_INDEX_SEMANTIC,
            query_fn=xerj_semantic_query,
            mappings=xerj_neural_mappings(),
            xerj_version=ctx.version,
            url_mode=ctx.url_mode,
        )
    if neural and ctx.neural_skip_reason:
        return SkippedEngine(name=name, reason=ctx.neural_skip_reason)
    if not ctx.url:
        return SkippedEngine(name=name, reason="xerj URL unavailable")
    if neural:
        return EsCompatEngine(
            name=name,
            base_url=ctx.url,
            index_name=XERJ_INDEX_NEURAL,
            query_fn=xerj_semantic_query,
            mappings=xerj_neural_mappings(),
            xerj_version=ctx.version,
            url_mode=ctx.url_mode,
            neural_model_download_size=XERJ_NEURAL_MODEL_SIZE,
        )
    return EsCompatEngine(
        name=name,
        base_url=ctx.url,
        index_name=XERJ_INDEX_LEXICAL,
        query_fn=xerj_match_query,
        mappings=xerj_lexical_mappings(),
        xerj_version=ctx.version,
        url_mode=ctx.url_mode,
    )


def opensearch_index_settings(*, knn: bool) -> dict:
    # One primary and no replica: BM25 statistics are not split across shards,
    # and a single node stays green.
    settings: dict[str, Any] = {"number_of_shards": 1, "number_of_replicas": 0}
    if knn:
        settings["knn"] = True
    return {"index": settings}


def opensearch_lexical_mappings() -> dict:
    return {
        "settings": opensearch_index_settings(knn=False),
        "mappings": {
            "properties": {
                "line": {"type": "integer"},
                "text": {"type": "text"},
            }
        },
    }


def opensearch_knn_mappings() -> dict:
    return {
        "settings": opensearch_index_settings(knn=True),
        "mappings": {
            "properties": {
                "line": {"type": "integer"},
                # Kept in _source for display, as a deployment would; not searched.
                "text": {"type": "text", "index": False},
                "vec": {
                    "type": "knn_vector",
                    "dimension": OPENSEARCH_KNN_DIM,
                    "method": dict(OPENSEARCH_KNN_METHOD),
                },
            }
        },
    }


def opensearch_match_query(query: str, k: int) -> dict:
    return {"size": k, "_source": False, "query": {"match": {"text": query}}}


def opensearch_knn_query(vector: list[float], k: int) -> dict:
    return {
        "size": k,
        "_source": False,
        "query": {"knn": {"vec": {"vector": vector, "k": k}}},
    }


def resolve_opensearch_home(explicit: str | None) -> Path | None:
    raw = explicit or os.environ.get("OPENSEARCH_HOME") or None
    if raw is None:
        return None
    home = Path(raw)
    launcher = home / "bin" / "opensearch"
    if not launcher.is_file():
        raise SystemExit(f"error: OpenSearch launcher not found: {launcher}")
    return home.resolve()


def opensearch_version_from_home(home: Path | None) -> str:
    """Read the version from lib/opensearch-X.Y.Z.jar without starting a JVM."""
    if home is None:
        return "unknown"
    for jar in sorted((home / "lib").glob("opensearch-[0-9]*.jar")):
        return jar.stem[len("opensearch-") :]
    return "unknown"


def opensearch_java_opts() -> str:
    return os.environ.get("OPENSEARCH_JAVA_OPTS") or OPENSEARCH_DEFAULT_JAVA_OPTS


def reserve_free_ports(count: int) -> list[int]:
    holders: list[socket.socket] = []
    try:
        for _ in range(count):
            sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            sock.bind(("127.0.0.1", 0))
            holders.append(sock)
        return [int(sock.getsockname()[1]) for sock in holders]
    finally:
        for sock in holders:
            sock.close()


def log_tail(path: Path, lines: int = 20) -> str:
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return ""
    return "\n".join(text.splitlines()[-lines:])


@dataclass
class OpenSearchContext:
    url: str | None = None
    skip_reason: str | None = None
    knn_skip_reason: str | None = None
    url_mode: str = "external"
    home: Path | None = None
    version: str = "unknown"
    java_opts: str | None = None
    _proc: subprocess.Popen[str] | None = None
    _tmpdir: tempfile.TemporaryDirectory[str] | None = None
    _log_handle: Any = None

    @property
    def data_dir(self) -> Path | None:
        if self._tmpdir is None:
            return None
        return Path(self._tmpdir.name) / "data"

    def shutdown(self) -> None:
        stop_spawned_node(self._proc, self._log_handle, self._tmpdir)
        self._proc = None
        self._log_handle = None
        self._tmpdir = None


def probe_opensearch(ctx: OpenSearchContext) -> None:
    """Record the node version and whether the k-NN plugin is installed."""
    assert ctx.url is not None
    root = es_request("GET", f"{ctx.url}/", timeout=30.0)
    version = root.get("version", {}) if isinstance(root, dict) else {}
    number = version.get("number") if isinstance(version, dict) else None
    if number:
        ctx.version = str(number)
    plugins = es_request("GET", f"{ctx.url}/_cat/plugins?format=json", timeout=30.0)
    components: set[str] = set()
    if isinstance(plugins, list):
        components = {str(item.get("component")) for item in plugins if isinstance(item, dict)}
    if OPENSEARCH_KNN_PLUGIN not in components:
        ctx.knn_skip_reason = (
            f"OpenSearch k-NN plugin ({OPENSEARCH_KNN_PLUGIN}) is not installed on the node"
        )


def open_opensearch_context(
    *,
    engines: list[str],
    opensearch_url: str | None,
    opensearch_home: str | None,
) -> OpenSearchContext:
    if not OPENSEARCH_ENGINES.intersection(engines):
        return OpenSearchContext()
    if opensearch_url:
        ctx = OpenSearchContext(
            url=assert_loopback_url(opensearch_url, flag="--opensearch-url"),
            url_mode="external",
        )
        probe_opensearch(ctx)
        return ctx
    home = resolve_opensearch_home(opensearch_home)
    if home is None:
        return OpenSearchContext(skip_reason=OPENSEARCH_NOT_CONFIGURED)

    tmp = tempfile.TemporaryDirectory(prefix="nesso-opensearch-")
    tmp_path = Path(tmp.name)
    data_dir = tmp_path / "data"
    logs_dir = tmp_path / "logs"
    data_dir.mkdir()
    logs_dir.mkdir()
    http_port, transport_port = reserve_free_ports(2)
    cmd = [
        str(home / "bin" / "opensearch"),
        "-E",
        "discovery.type=single-node",
        "-E",
        "network.host=127.0.0.1",
        "-E",
        f"http.port={http_port}",
        "-E",
        f"transport.port={transport_port}",
        "-E",
        f"path.data={data_dir}",
        "-E",
        f"path.logs={logs_dir}",
        # A nearly full dev disk must not flip the index read-only mid-run.
        "-E",
        "cluster.routing.allocation.disk.threshold_enabled=false",
    ]
    # The min distribution has no security plugin and rejects its settings.
    if (home / "plugins" / OPENSEARCH_SECURITY_PLUGIN).is_dir():
        cmd.extend(["-E", "plugins.security.disabled=true"])
    java_opts = opensearch_java_opts()
    env = os.environ.copy()
    env["OPENSEARCH_JAVA_OPTS"] = java_opts
    # OpenSearch prefers JAVA_HOME over its bundled JDK, and a host JAVA_HOME
    # often points at an older Java than OpenSearch requires. Use the bundled
    # JDK unless OPENSEARCH_JAVA_HOME is set explicitly.
    bundled_jdk = home / "jdk"
    if not env.get("OPENSEARCH_JAVA_HOME") and bundled_jdk.is_dir():
        env["OPENSEARCH_JAVA_HOME"] = str(bundled_jdk)
    env["DISABLE_INSTALL_DEMO_CONFIG"] = "true"

    log_path = tmp_path / "opensearch.log"
    log_handle = log_path.open("w", encoding="utf-8")
    try:
        proc = subprocess.Popen(
            cmd,
            stdout=log_handle,
            stderr=subprocess.STDOUT,
            text=True,
            env=env,
        )
    except OSError as exc:
        log_handle.close()
        tmp.cleanup()
        raise SystemExit(f"error: failed to start OpenSearch: {exc}") from exc

    ctx = OpenSearchContext(
        url=f"http://127.0.0.1:{http_port}",
        url_mode="spawned",
        home=home,
        version=opensearch_version_from_home(home),
        java_opts=java_opts,
        _proc=proc,
        _tmpdir=tmp,
        _log_handle=log_handle,
    )
    try:
        wait_xerj_ready(
            ctx.url,
            timeout=OPENSEARCH_READY_TIMEOUT_S,
            label="OpenSearch",
            proc=proc,
        )
        probe_opensearch(ctx)
    except SystemExit as exc:
        log_handle.flush()
        tail = log_tail(log_path)
        ctx.shutdown()
        message = str(exc.code) if exc.code is not None else "error: OpenSearch failed to start"
        if tail:
            message = f"{message}\n--- OpenSearch log tail ---\n{tail}"
        raise SystemExit(message) from exc
    return ctx


def skip_reason_from_exit(exc: SystemExit, fallback: str) -> str:
    reason = exc.code if isinstance(exc.code, str) else fallback
    if reason.startswith("error: "):
        reason = reason[len("error: ") :]
    return reason


def make_opensearch_engine(
    ctx: OpenSearchContext,
    *,
    knn: bool,
    encoder: Callable[[list[str]], list[list[float]]] | None = None,
) -> RankEngine:
    name = "opensearch-knn" if knn else "opensearch"
    if ctx.skip_reason:
        return SkippedEngine(name=name, reason=ctx.skip_reason)
    if not ctx.url:
        return SkippedEngine(name=name, reason=OPENSEARCH_NOT_CONFIGURED)
    extra: dict[str, Any] = {"java_opts": ctx.java_opts or "external"}
    if not knn:
        return EsCompatEngine(
            name=name,
            base_url=ctx.url,
            index_name=OPENSEARCH_INDEX_LEXICAL,
            query_fn=opensearch_match_query,
            mappings=opensearch_lexical_mappings(),
            xerj_version=ctx.version,
            url_mode=ctx.url_mode,
            version_key="opensearch_version",
            extra_versions=extra,
        )
    if ctx.knn_skip_reason:
        return SkippedEngine(name=name, reason=ctx.knn_skip_reason)
    diy = load_diy_faiss_module()
    if encoder is None:
        try:
            encoder = diy.make_encoder()
        except SystemExit as exc:
            return SkippedEngine(name=name, reason=skip_reason_from_exit(exc, diy.INSTALL_HINT))
    encode = encoder

    def doc_batch(first_line_id: int, texts: list[str]) -> list[dict]:
        vectors = encode(texts)
        if len(vectors) != len(texts):
            raise SystemExit(
                f"error: {name} encoder returned {len(vectors)} vectors for {len(texts)} lines"
            )
        return [
            {"line": first_line_id + offset, "text": text, "vec": vector}
            for offset, (text, vector) in enumerate(zip(texts, vectors, strict=True))
        ]

    def query(text: str, k: int) -> dict:
        return opensearch_knn_query(encode([text])[0], k)

    method = OPENSEARCH_KNN_METHOD
    extra.update(
        {
            "knn_method": f"{method['name']}/{method['engine']}/{method['space_type']}",
            "model": diy.MODEL_ID,
            "model_revision": diy.MODEL_REVISION,
        }
    )
    return EsCompatEngine(
        name=name,
        base_url=ctx.url,
        index_name=OPENSEARCH_INDEX_KNN,
        query_fn=query,
        mappings=opensearch_knn_mappings(),
        xerj_version=ctx.version,
        url_mode=ctx.url_mode,
        doc_batch_fn=doc_batch,
        version_key="opensearch_version",
        extra_versions=extra,
    )


def format_mode_table(modes: list[dict]) -> str:
    headers = ("mode", "class", "n", "recall@10", "MRR", "nDCG@10")
    rows: list[tuple[str, str, str, str, str, str]] = []
    for mode in modes:
        mode_name = mode["mode"]
        for bucket in mode["by_class"]:
            metrics = bucket["metrics"]
            rows.append(
                (
                    mode_name,
                    bucket["class"],
                    str(bucket["n"]),
                    f"{metrics['recall_at_10']:0.6f}",
                    f"{metrics['mrr']:0.6f}",
                    f"{metrics['ndcg_at_10']:0.6f}",
                )
            )
        overall = mode["overall"]["metrics"]
        rows.append(
            (
                mode_name,
                "overall",
                str(mode["overall"]["n"]),
                f"{overall['recall_at_10']:0.6f}",
                f"{overall['mrr']:0.6f}",
                f"{overall['ndcg_at_10']:0.6f}",
            )
        )
    widths = [len(header) for header in headers]
    for row in rows:
        for index, cell in enumerate(row):
            widths[index] = max(widths[index], len(cell))
    lines = [
        "  ".join(header.ljust(widths[index]) for index, header in enumerate(headers)),
        "  ".join("-" * widths[index] for index in range(len(headers))),
    ]
    for row in rows:
        lines.append("  ".join(cell.ljust(widths[index]) for index, cell in enumerate(row)))
    return "\n".join(lines)


def format_engine_table(engines: list[dict]) -> str:
    headers = ("engine", "class", "n", "recall@10", "MRR", "nDCG@10")
    rows: list[tuple[str, str, str, str, str, str]] = []
    for engine in engines:
        engine_name = engine["engine"]
        if engine.get("status") == "skipped":
            rows.append(
                (
                    engine_name,
                    "skipped",
                    "-",
                    engine.get("reason", ""),
                    "",
                    "",
                )
            )
            continue
        if "modes" in engine:
            for mode in engine["modes"]:
                label = f"{engine_name}/{mode['mode']}"
                for bucket in mode["by_class"]:
                    metrics = bucket["metrics"]
                    rows.append(
                        (
                            label,
                            bucket["class"],
                            str(bucket["n"]),
                            f"{metrics['recall_at_10']:0.6f}",
                            f"{metrics['mrr']:0.6f}",
                            f"{metrics['ndcg_at_10']:0.6f}",
                        )
                    )
                overall = mode["overall"]["metrics"]
                rows.append(
                    (
                        label,
                        "overall",
                        str(mode["overall"]["n"]),
                        f"{overall['recall_at_10']:0.6f}",
                        f"{overall['mrr']:0.6f}",
                        f"{overall['ndcg_at_10']:0.6f}",
                    )
                )
            continue
        for bucket in engine["by_class"]:
            metrics = bucket["metrics"]
            rows.append(
                (
                    engine_name,
                    bucket["class"],
                    str(bucket["n"]),
                    f"{metrics['recall_at_10']:0.6f}",
                    f"{metrics['mrr']:0.6f}",
                    f"{metrics['ndcg_at_10']:0.6f}",
                )
            )
        overall = engine["overall"]["metrics"]
        rows.append(
            (
                engine_name,
                "overall",
                str(engine["overall"]["n"]),
                f"{overall['recall_at_10']:0.6f}",
                f"{overall['mrr']:0.6f}",
                f"{overall['ndcg_at_10']:0.6f}",
            )
        )
    widths = [len(header) for header in headers]
    for row in rows:
        for index, cell in enumerate(row):
            widths[index] = max(widths[index], len(cell))
    lines = [
        "  ".join(header.ljust(widths[index]) for index, header in enumerate(headers)),
        "  ".join("-" * widths[index] for index in range(len(headers))),
    ]
    for row in rows:
        lines.append("  ".join(cell.ljust(widths[index]) for index, cell in enumerate(row)))
    return "\n".join(lines)


def format_xerj_metadata_lines(payload: dict) -> list[str]:
    lines: list[str] = []
    for dataset in payload.get("datasets", []):
        for engine in dataset.get("engines", []):
            if engine.get("status") != "ok":
                continue
            if engine.get("engine") not in XERJ_ENGINES:
                continue
            versions = engine.get("versions")
            if not isinstance(versions, dict):
                continue
            parts = [
                f"xerj_version={versions.get('xerj_version', 'unknown')}",
                f"url_mode={versions.get('url_mode', 'unknown')}",
                f"index_seconds={versions.get('index_seconds', 0)}",
            ]
            size = versions.get("neural_model_download_size")
            if size is not None:
                parts.append(f"neural_model_download_size={size}")
            lines.append(f"# {dataset['dataset']}/{engine['engine']}: " + " ".join(parts))
    return lines


def format_opensearch_metadata_lines(payload: dict) -> list[str]:
    lines: list[str] = []
    for dataset in payload.get("datasets", []):
        for engine in dataset.get("engines", []):
            if engine.get("status") != "ok" or engine.get("engine") not in OPENSEARCH_ENGINES:
                continue
            versions = engine.get("versions")
            if not isinstance(versions, dict):
                continue
            parts = [
                f"opensearch_version={versions.get('opensearch_version', 'unknown')}",
                f"url_mode={versions.get('url_mode', 'unknown')}",
                f"index_seconds={versions.get('index_seconds', 0)}",
                f"java_opts={versions.get('java_opts', 'unknown')!r}",
            ]
            method = versions.get("knn_method")
            if method is not None:
                parts.append(f"knn_method={method}")
            lines.append(f"# {dataset['dataset']}/{engine['engine']}: " + " ".join(parts))
    return lines


def format_report(payload: dict) -> str:
    sections: list[str] = []
    schema = payload.get("schema_version", SCHEMA_VERSION)
    if schema >= SCHEMA_VERSION_ENGINES:
        for dataset in payload["datasets"]:
            sections.append(f"=== {dataset['dataset']} ===")
            sections.append(format_engine_table(dataset["engines"]))
        sections.append("=== overall ===")
        sections.append(format_engine_table(payload["overall"]["engines"]))
        sections.extend(format_xerj_metadata_lines(payload))
        sections.extend(format_opensearch_metadata_lines(payload))
        return "\n".join(sections)
    for dataset in payload["datasets"]:
        sections.append(f"=== {dataset['dataset']} ===")
        sections.append(format_mode_table(dataset["modes"]))
    sections.append("=== overall ===")
    sections.append(format_mode_table(payload["overall"]["modes"]))
    return "\n".join(sections)


def parse_full_datasets(raw: str | None) -> list[FullDatasetSpec]:
    if raw is None:
        return [DATASETS_FULL[name] for name in ("hdfs-v1", "bgl", "thunderbird")]
    parts = [part.strip() for part in raw.split(",") if part.strip()]
    if not parts:
        raise SystemExit("error: --dataset must list at least one full dataset")
    names: list[str] = []
    for part in parts:
        if part == ALL_FULL:
            names.extend(DATASETS_FULL)
            continue
        if part not in DATASETS_FULL:
            raise SystemExit(
                f"error: unknown full dataset {part!r}; expected one of "
                f"{sorted(DATASETS_FULL) + [ALL_FULL]}"
            )
        names.append(part)
    ordered: list[FullDatasetSpec] = []
    seen: set[str] = set()
    for name in names:
        if name in seen:
            continue
        seen.add(name)
        ordered.append(DATASETS_FULL[name])
    return ordered


def parse_datasets(raw: str | None) -> list[DatasetSpec] | None:
    if raw is None:
        return None
    parts = [part.strip() for part in raw.split(",") if part.strip()]
    if not parts:
        raise SystemExit("error: --dataset must list at least one dataset")
    names: list[str] = []
    for part in parts:
        if part == ALL_2K:
            names.extend(DATASETS_2K)
            continue
        if part not in DATASETS_2K:
            raise SystemExit(
                f"error: unknown dataset {part!r}; expected one of "
                f"{sorted(DATASETS_2K) + [ALL_2K]}"
            )
        names.append(part)
    # Preserve order, drop duplicates.
    seen: set[str] = set()
    ordered: list[DatasetSpec] = []
    for name in names:
        if name in seen:
            continue
        seen.add(name)
        ordered.append(DATASETS_2K[name])
    return ordered


def parse_engines(raw: list[str] | None) -> list[str]:
    if not raw:
        return ["nesso"]
    allowed = set(VALID_ENGINES)
    ordered: list[str] = []
    seen: set[str] = set()
    for name in raw:
        if name not in allowed:
            raise SystemExit(
                f"error: unknown engine {name!r}; expected one of {list(VALID_ENGINES)}"
            )
        if name in seen:
            continue
        seen.add(name)
        ordered.append(name)
    if not ordered:
        raise SystemExit("error: --engine must list at least one engine")
    return ordered


def ensure_inputs(
    log_path: Path,
    structured_path: Path,
    *,
    fetch_dataset: str | None = None,
) -> None:
    if log_path.is_file() and structured_path.is_file():
        return
    fetch = ROOT / "scripts" / "fetch-loghub"
    if fetch_dataset is not None:
        if not fetch.is_file():
            raise SystemExit(f"error: missing log or structured CSV and {fetch} is absent")
        run_checked([sys.executable, str(fetch), "--dataset", fetch_dataset], label="fetch-loghub")
        if not log_path.is_file():
            raise SystemExit(f"error: log still missing after fetch-loghub: {log_path}")
        if not structured_path.is_file():
            raise SystemExit(f"error: structured CSV still missing after fetch-loghub: {structured_path}")
        return
    if log_path != DEFAULT_LOG or structured_path != DEFAULT_STRUCTURED:
        missing = []
        if not log_path.is_file():
            missing.append(str(log_path))
        if not structured_path.is_file():
            missing.append(str(structured_path))
        raise SystemExit(
            "error: missing input file(s): "
            + ", ".join(missing)
            + "; pass existing paths or use the default build/bench locations"
        )
    if not fetch.is_file():
        raise SystemExit(f"error: missing log or structured CSV and {fetch} is absent")
    run_checked([sys.executable, str(fetch), "--dataset", "hdfs-2k"], label="fetch-loghub")
    if not log_path.is_file():
        raise SystemExit(f"error: log still missing after fetch-loghub: {log_path}")
    if not structured_path.is_file():
        raise SystemExit(f"error: structured CSV still missing after fetch-loghub: {structured_path}")


def score_queries(
    *,
    queries: list[Query],
    event_by_line: dict[int, str],
    rank_fn,
) -> dict:
    resolved = [(query, relevant_set(query, event_by_line)) for query in queries]
    per_query: list[dict] = []
    by_class: dict[str, list[Metrics]] = {name: [] for name in sorted(VALID_CLASSES)}
    all_metrics: list[Metrics] = []
    for query, relevant in resolved:
        ranked = rank_fn(query.query)
        metrics = score_ranking(ranked, relevant)
        all_metrics.append(metrics)
        by_class[query.class_name].append(metrics)
        per_query.append(
            {
                "class": query.class_name,
                "id": query.id,
                "metrics": metrics_dict(metrics),
                "ranked_lines": ranked,
            }
        )
    class_rows = []
    for class_name in sorted(VALID_CLASSES):
        items = by_class[class_name]
        class_rows.append(
            {
                "class": class_name,
                "metrics": metrics_dict(mean_metrics(items)),
                "n": len(items),
            }
        )
    return {
        "by_class": class_rows,
        "overall": {
            "metrics": metrics_dict(mean_metrics(all_metrics)),
            "n": len(all_metrics),
        },
        "queries": per_query,
    }


def evaluate_modes(
    *,
    binary: Path,
    model_dir: Path,
    queries: list[Query],
    event_by_line: dict[int, str],
    log_path: Path,
    modes: list[str],
    corpus: Path,
) -> list[dict]:
    engine = NessoEngine(binary=binary, model_dir=model_dir, corpus=corpus)
    engine.prepare(log_path, read_log_lines(log_path), corpus.parent)
    mode_results = []
    for mode in modes:
        scored = score_queries(
            queries=queries,
            event_by_line=event_by_line,
            rank_fn=lambda q, mode=mode: engine.rank_mode(q, mode),
        )
        mode_results.append(
            {
                "by_class": scored["by_class"],
                "mode": mode,
                "overall": scored["overall"],
                "queries": scored["queries"],
            }
        )
    return mode_results


def evaluate_keyword_engine(
    engine: RankEngine,
    *,
    queries: list[Query],
    event_by_line: dict[int, str],
    log_path: Path,
    lines: list[str],
    workdir: Path,
) -> dict:
    ok, reason = engine.availability()
    if not ok:
        if engine.name in SKIPPABLE_ENGINES:
            return {
                "engine": engine.name,
                "status": "skipped",
                "reason": reason,
            }
        raise SystemExit(f"error: {reason}")
    try:
        engine.prepare(log_path, lines, workdir)
        scored = score_queries(
            queries=queries,
            event_by_line=event_by_line,
            rank_fn=lambda q: engine.rank(q),
        )
        payload = {
            "engine": engine.name,
            "status": "ok",
            "by_class": scored["by_class"],
            "overall": scored["overall"],
            "queries": scored["queries"],
        }
        versions_fn = getattr(engine, "versions", None)
        if callable(versions_fn):
            payload["versions"] = versions_fn()
        return payload
    finally:
        cleanup = getattr(engine, "cleanup", None)
        if callable(cleanup):
            cleanup()


def aggregate_overall(dataset_results: list[dict], modes: list[str]) -> dict:
    mode_rows: list[dict] = []
    total_queries = sum(item["query_count"] for item in dataset_results)
    for mode_name in modes:
        by_class: dict[str, list[Metrics]] = {name: [] for name in sorted(VALID_CLASSES)}
        all_metrics: list[Metrics] = []
        for dataset in dataset_results:
            mode_payload = next(item for item in dataset["modes"] if item["mode"] == mode_name)
            for query in mode_payload["queries"]:
                metrics = Metrics(
                    recall_at_10=query["metrics"]["recall_at_10"],
                    mrr=query["metrics"]["mrr"],
                    ndcg_at_10=query["metrics"]["ndcg_at_10"],
                )
                all_metrics.append(metrics)
                by_class[query["class"]].append(metrics)
        class_rows = []
        for class_name in sorted(VALID_CLASSES):
            items = by_class[class_name]
            class_rows.append(
                {
                    "class": class_name,
                    "metrics": metrics_dict(mean_metrics(items)),
                    "n": len(items),
                }
            )
        mode_rows.append(
            {
                "by_class": class_rows,
                "mode": mode_name,
                "overall": {
                    "metrics": metrics_dict(mean_metrics(all_metrics)),
                    "n": len(all_metrics),
                },
            }
        )
    return {"modes": mode_rows, "query_count": total_queries}


def aggregate_overall_engines(dataset_results: list[dict], engine_names: list[str]) -> dict:
    engine_rows: list[dict] = []
    total_queries = sum(item["query_count"] for item in dataset_results)
    for engine_name in engine_names:
        samples = []
        for dataset in dataset_results:
            entry = next(item for item in dataset["engines"] if item["engine"] == engine_name)
            samples.append(entry)
        if any(item.get("status") == "skipped" for item in samples):
            reason = next(
                item.get("reason", "skipped")
                for item in samples
                if item.get("status") == "skipped"
            )
            engine_rows.append(
                {
                    "engine": engine_name,
                    "status": "skipped",
                    "reason": reason,
                }
            )
            continue
        if engine_name == "nesso":
            # Aggregate each mode across datasets the same way as schema 3.
            modes = [mode["mode"] for mode in samples[0]["modes"]]
            mode_rows: list[dict] = []
            for mode_name in modes:
                by_class: dict[str, list[Metrics]] = {name: [] for name in sorted(VALID_CLASSES)}
                all_metrics: list[Metrics] = []
                for sample in samples:
                    mode_payload = next(item for item in sample["modes"] if item["mode"] == mode_name)
                    for query in mode_payload["queries"]:
                        metrics = Metrics(
                            recall_at_10=query["metrics"]["recall_at_10"],
                            mrr=query["metrics"]["mrr"],
                            ndcg_at_10=query["metrics"]["ndcg_at_10"],
                        )
                        all_metrics.append(metrics)
                        by_class[query["class"]].append(metrics)
                class_rows = []
                for class_name in sorted(VALID_CLASSES):
                    items = by_class[class_name]
                    class_rows.append(
                        {
                            "class": class_name,
                            "metrics": metrics_dict(mean_metrics(items)),
                            "n": len(items),
                        }
                    )
                mode_rows.append(
                    {
                        "by_class": class_rows,
                        "mode": mode_name,
                        "overall": {
                            "metrics": metrics_dict(mean_metrics(all_metrics)),
                            "n": len(all_metrics),
                        },
                    }
                )
            engine_rows.append(
                {
                    "engine": "nesso",
                    "status": "ok",
                    "modes": mode_rows,
                }
            )
            continue
        by_class: dict[str, list[Metrics]] = {name: [] for name in sorted(VALID_CLASSES)}
        all_metrics: list[Metrics] = []
        for sample in samples:
            for query in sample["queries"]:
                metrics = Metrics(
                    recall_at_10=query["metrics"]["recall_at_10"],
                    mrr=query["metrics"]["mrr"],
                    ndcg_at_10=query["metrics"]["ndcg_at_10"],
                )
                all_metrics.append(metrics)
                by_class[query["class"]].append(metrics)
        class_rows = []
        for class_name in sorted(VALID_CLASSES):
            items = by_class[class_name]
            class_rows.append(
                {
                    "class": class_name,
                    "metrics": metrics_dict(mean_metrics(items)),
                    "n": len(items),
                }
            )
        row = {
            "engine": engine_name,
            "status": "ok",
            "by_class": class_rows,
            "overall": {
                "metrics": metrics_dict(mean_metrics(all_metrics)),
                "n": len(all_metrics),
            },
        }
        if "versions" in samples[0]:
            row["versions"] = samples[0]["versions"]
        engine_rows.append(row)
    return {"engines": engine_rows, "query_count": total_queries}


def make_rank_engine(
    engine_name: str,
    *,
    xerj: XerjContext | None = None,
    opensearch: OpenSearchContext | None = None,
) -> RankEngine:
    """Build any non-nesso engine by name."""
    if engine_name == "grep":
        return GrepEngine()
    if engine_name == "ripgrep":
        return RipgrepEngine()
    if engine_name == "bm25":
        return Bm25Engine()
    if engine_name == "diy-faiss":
        return load_diy_faiss_module().DiyFaissEngine()
    if engine_name == "xerj":
        return make_xerj_engine(xerj or XerjContext(skip_reason="xerj not configured"), neural=False)
    if engine_name == "xerj-neural":
        return make_xerj_engine(xerj or XerjContext(skip_reason="xerj not configured"), neural=True)
    if engine_name == "xerj-semantic":
        return make_xerj_engine(
            xerj or XerjContext(skip_reason="xerj not configured"), neural=False, semantic=True
        )
    if engine_name in CHUNK_CLI_ENGINES:
        return ChunkCliEngine(CHUNK_CLI_SPECS[engine_name])
    if engine_name in OPENSEARCH_ENGINES:
        return make_opensearch_engine(
            opensearch or OpenSearchContext(skip_reason=OPENSEARCH_NOT_CONFIGURED),
            knn=engine_name == "opensearch-knn",
        )
    raise SystemExit(f"error: unknown engine {engine_name!r}")


def evaluate_dataset(
    *,
    binary: Path | None,
    model_dir: Path | None,
    queries: list[Query],
    event_by_line: dict[int, str],
    log_path: Path,
    lines: list[str],
    modes: list[str],
    engines: list[str],
    workdir: Path,
    corpus_name: str,
    dataset_name: str,
    xerj: XerjContext | None = None,
    opensearch: OpenSearchContext | None = None,
) -> dict:
    workdir.mkdir(parents=True, exist_ok=True)
    nesso_only = engines == ["nesso"]
    if nesso_only:
        assert binary is not None and model_dir is not None
        modes_payload = evaluate_modes(
            binary=binary,
            model_dir=model_dir,
            queries=queries,
            event_by_line=event_by_line,
            log_path=log_path,
            modes=modes,
            corpus=workdir / corpus_name,
        )
        return {
            "dataset": dataset_name,
            "modes": modes_payload,
            "query_count": len(queries),
        }

    engine_payloads: list[dict] = []
    for engine_name in engines:
        if engine_name == "nesso":
            assert binary is not None and model_dir is not None
            modes_payload = evaluate_modes(
                binary=binary,
                model_dir=model_dir,
                queries=queries,
                event_by_line=event_by_line,
                log_path=log_path,
                modes=modes,
                corpus=workdir / corpus_name,
            )
            engine_payloads.append(
                {
                    "engine": "nesso",
                    "status": "ok",
                    "modes": modes_payload,
                }
            )
            continue
        engine = make_rank_engine(engine_name, xerj=xerj, opensearch=opensearch)
        engine_payloads.append(
            evaluate_keyword_engine(
                engine,
                queries=queries,
                event_by_line=event_by_line,
                log_path=log_path,
                lines=lines,
                workdir=workdir,
            )
        )
    return {
        "dataset": dataset_name,
        "engines": engine_payloads,
        "query_count": len(queries),
    }


def parse_modes(raw: str) -> list[str]:
    modes = [part.strip() for part in raw.split(",") if part.strip()]
    if not modes:
        raise SystemExit("error: --modes must list at least one mode")
    allowed = set(DEFAULT_MODES)
    for mode in modes:
        if mode not in allowed:
            raise SystemExit(f"error: unknown mode {mode!r}; expected one of {sorted(allowed)}")
    return modes


def no_index_fields(log_bytes: int) -> dict[str, Any]:
    del log_bytes
    return {
        "indexWallSeconds": None,
        "indexPeakRssBytes": None,
        "indexBytes": None,
        "indexToLogRatio": None,
    }


def query_metric_fields(
    *,
    wall: float | None,
    peak_rss: int | None,
    latencies: list[float],
) -> dict[str, Any]:
    return {
        "queryWallSeconds": wall,
        "queryPeakRssBytes": peak_rss,
        "queryLatencyMedianSeconds": median_value(latencies),
        "queryLatencyP95Seconds": percentile_p95(latencies),
    }


def median_optional_ints(values: list[int | None]) -> int | None:
    present = [value for value in values if value is not None]
    if not present:
        return None
    return int(statistics.median(present))


def median_optional_floats(values: list[float | None]) -> float | None:
    present = [value for value in values if value is not None]
    if not present:
        return None
    return median_value(present)


def merge_engine_measure_repeats(repeats: list[dict[str, Any]]) -> dict[str, Any]:
    if not repeats:
        raise SystemExit("error: measure produced no repeats")
    first = repeats[0]
    merged: dict[str, Any] = {"engine": first["engine"]}
    if first.get("status") == "skipped":
        merged["status"] = "skipped"
        merged["reason"] = first.get("reason", "")
        return merged
    merged["status"] = "ok"
    for key in (
        "indexWallSeconds",
        "indexPeakRssBytes",
        "indexBytes",
        "indexToLogRatio",
        "timeToFirstResultSeconds",
    ):
        if key in ("indexPeakRssBytes", "indexBytes"):
            merged[key] = median_optional_ints([item.get(key) for item in repeats])
        else:
            merged[key] = median_optional_floats([item.get(key) for item in repeats])
    if "modes" in first:
        mode_names = [mode["mode"] for mode in first["modes"]]
        modes_out: list[dict[str, Any]] = []
        for mode_name in mode_names:
            mode_repeats = []
            for item in repeats:
                for mode in item["modes"]:
                    if mode["mode"] == mode_name:
                        mode_repeats.append(mode)
                        break
            modes_out.append(
                {
                    "mode": mode_name,
                    **{
                        key: (
                            median_optional_ints([mode.get(key) for mode in mode_repeats])
                            if key == "queryPeakRssBytes"
                            else median_optional_floats([mode.get(key) for mode in mode_repeats])
                        )
                        for key in (
                            "queryWallSeconds",
                            "queryPeakRssBytes",
                            "queryLatencyMedianSeconds",
                            "queryLatencyP95Seconds",
                        )
                    },
                }
            )
        merged["modes"] = modes_out
    else:
        for key in (
            "queryWallSeconds",
            "queryPeakRssBytes",
            "queryLatencyMedianSeconds",
            "queryLatencyP95Seconds",
        ):
            if key == "queryPeakRssBytes":
                merged[key] = median_optional_ints([item.get(key) for item in repeats])
            else:
                merged[key] = median_optional_floats([item.get(key) for item in repeats])
    return merged


def model_identity(model_dir: Path | None) -> dict[str, Any] | None:
    """Which embedding model files produced nesso's numbers (digests, not names).

    Reports record this so runs with a different model, quantization, or
    vocabulary cannot be mistaken for each other.
    """
    if model_dir is None:
        return None
    identity: dict[str, Any] = {"dir": model_dir.name}
    for key, name in (("model_onnx", "model.onnx"), ("vocab", "vocab.txt")):
        path = model_dir / name
        if path.is_file():
            identity[f"{key}_sha256"] = sha256_of_file(path)
            identity[f"{key}_bytes"] = path.stat().st_size
    return identity


def sha256_of_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def tool_version_line(argv: list[str]) -> str:
    try:
        completed = subprocess.run(
            argv,
            capture_output=True,
            text=True,
            check=False,
            timeout=30,
        )
    except (OSError, subprocess.TimeoutExpired):
        return "unknown"
    text = (completed.stdout or completed.stderr or "").strip()
    return text.splitlines()[0].strip() if text else "unknown"


def collect_measure_tool_versions(
    *,
    engines: list[str],
    binary: Path | None,
    xerj_bin: str | None,
    opensearch_home: str | None = None,
    model_dir: Path | None = None,
) -> dict[str, str]:
    tools: dict[str, str] = {"python": sys.version.split()[0]}
    identity = model_identity(model_dir) if "nesso" in engines else None
    if identity is not None and "model_onnx_sha256" in identity:
        tools["nesso-model"] = f"{identity['dir']} onnx {identity['model_onnx_sha256'][:12]} {identity['model_onnx_bytes']}B"
    if OPENSEARCH_ENGINES.intersection(engines):
        home = resolve_opensearch_home(opensearch_home)
        tools["opensearch"] = "missing" if home is None else opensearch_version_from_home(home)
    if "nesso" in engines and binary is not None:
        tools["nesso"] = tool_version_line([str(binary), "-V"])
    if "grep" in engines:
        tools["grep"] = tool_version_line(["grep", "--version"])
    if "ripgrep" in engines:
        if shutil.which("rg") is None:
            tools["rg"] = "missing"
        else:
            tools["rg"] = tool_version_line(["rg", "--version"])
    if XERJ_ENGINES.intersection(engines):
        resolved = resolve_xerj_binary(xerj_bin)
        tools["xerj"] = xerj_version_from_binary(resolved)
    for name in sorted(CHUNK_CLI_ENGINES.intersection(engines)):
        executable = CHUNK_CLI_SPECS[name].executable
        if shutil.which(executable) is None:
            tools[name] = "missing"
        else:
            tools[name] = tool_version_line([executable, "--version"])
    if "bm25" in engines:
        tools["sqlite3"] = sqlite3.sqlite_version
    if "diy-faiss" in engines or "opensearch-knn" in engines:
        diy = load_diy_faiss_module()
        engine = diy.DiyFaissEngine()
        ok, _reason = engine.availability()
        if ok:
            versions = engine.versions()
            tools["diy-faiss"] = (
                f"st={versions.get('sentence_transformers')} "
                f"torch={versions.get('torch')} faiss={versions.get('faiss')}"
            )
        else:
            tools["diy-faiss"] = "unavailable"
    return tools


def ensure_full_log(spec: FullDatasetSpec, *, lines: int, skip_fetch: bool) -> Path:
    dest = spec.log_path
    if skip_fetch and not dest.is_file():
        raise SystemExit(f"error: full log missing and --skip-fetch is set: {dest}")
    if not skip_fetch:
        fetch = ROOT / "scripts" / "fetch-loghub"
        if not fetch.is_file():
            raise SystemExit(f"error: missing fetch-loghub: {fetch}")
        run_checked(
            [
                sys.executable,
                str(fetch),
                "--dataset",
                spec.name,
                "--lines",
                str(lines),
                "--dest",
                str(dest),
            ],
            label="fetch-loghub",
        )
    if not dest.is_file():
        raise SystemExit(f"error: full log still missing: {dest}")
    # Exact N-line prefix beside the fetch dest (fetch may write the 1M pin name).
    prefix_path = dest.with_name(f"{dest.stem}_{lines}{dest.suffix}")
    written = 0
    with dest.open("r", encoding="utf-8", errors="replace") as source, prefix_path.open(
        "w", encoding="utf-8", newline="\n"
    ) as out:
        for line in source:
            if written >= lines:
                break
            out.write(line if line.endswith("\n") else line + "\n")
            written += 1
    if written < lines:
        raise SystemExit(f"error: {dest} has only {written} lines; need {lines}")
    return prefix_path


def load_query_texts(path: Path) -> list[str]:
    queries = load_queries(path)
    return [query.query for query in queries]


def bm25_build_db(db_path: Path, lines: list[str]) -> None:
    require_fts5()
    if db_path.exists():
        db_path.unlink()
    conn = sqlite3.connect(str(db_path))
    try:
        conn.execute("CREATE VIRTUAL TABLE lines USING fts5(content)")
        conn.executemany(
            "INSERT INTO lines(rowid, content) VALUES (?, ?)",
            ((index, text) for index, text in enumerate(lines, start=1)),
        )
        conn.commit()
    finally:
        conn.close()


def bm25_rank_db(db_path: Path, query: str, *, k: int = K) -> list[int]:
    conn = sqlite3.connect(str(db_path))
    try:
        tokens = query_tokens(query)
        if not tokens:
            return []
        match = fts5_or_query(tokens)
        rows = conn.execute(
            "SELECT rowid FROM lines WHERE lines MATCH ? ORDER BY bm25(lines), rowid LIMIT ?",
            (match, k),
        ).fetchall()
        return [int(row[0]) for row in rows]
    finally:
        conn.close()


def parse_worker_json(stdout: str) -> dict[str, Any]:
    text = stdout.strip()
    if not text:
        raise SystemExit("error: measure worker produced no JSON")
    try:
        payload = json.loads(text.splitlines()[-1])
    except json.JSONDecodeError as exc:
        raise SystemExit(f"error: measure worker JSON parse failed: {exc}") from exc
    if not isinstance(payload, dict):
        raise SystemExit("error: measure worker JSON must be an object")
    return payload


def run_measure_worker(
    *,
    engine: str,
    phase: str,
    log_path: Path,
    workdir: Path,
    queries: list[str],
    binary: Path | None = None,
    model_dir: Path | None = None,
    mode: str | None = None,
    corpus: Path | None = None,
    xerj_bin: str | None = None,
    xerj_model_dir: str | None = None,
    neural: bool = False,
    opensearch_home: str | None = None,
    timeout: float | None = None,
    env: dict[str, str] | None = None,
) -> dict[str, Any]:
    workdir.mkdir(parents=True, exist_ok=True)
    queries_path = workdir / f"measure-queries-{phase}.json"
    queries_path.write_text(json.dumps(queries), encoding="utf-8")
    time_path = workdir / f"gnu-time-{engine}-{phase}.txt"
    argv = [
        sys.executable,
        str(Path(__file__).resolve()),
        "--measure-worker",
        engine,
        "--phase",
        phase,
        "--log",
        str(log_path),
        "--workdir",
        str(workdir),
        "--queries-json",
        str(queries_path),
    ]
    if binary is not None:
        argv.extend(["--binary", str(binary)])
    if model_dir is not None:
        argv.extend(["--model-dir", str(model_dir)])
    if mode is not None:
        argv.extend(["--mode", mode])
    if corpus is not None:
        argv.extend(["--corpus", str(corpus)])
    if xerj_bin is not None:
        argv.extend(["--xerj-bin", xerj_bin])
    if xerj_model_dir is not None:
        argv.extend(["--xerj-model-dir", xerj_model_dir])
    if neural:
        argv.append("--neural")
    if opensearch_home is not None:
        argv.extend(["--opensearch-home", opensearch_home])
    result = execute_timed(argv, time_path, timeout=timeout, env=env)
    if result["error"]:
        raise SystemExit(f"error: measure worker {engine}/{phase}: {result['error']}")
    if result["exitCode"] not in (0,):
        detail = result["stderr"].strip() or result["stdout"].strip() or f"exit {result['exitCode']}"
        raise SystemExit(f"error: measure worker {engine}/{phase} failed: {detail}")
    payload = parse_worker_json(result["stdout"])
    payload["wallSeconds"] = result["wallSeconds"]
    payload["peakRssBytes"] = result["peakRssBytes"]
    return payload


def measure_worker_main(argv: list[str]) -> None:
    parser = argparse.ArgumentParser(prog="eval-retrieval --measure-worker")
    parser.add_argument("engine", choices=list(VALID_ENGINES))
    parser.add_argument("--phase", choices=list(MEASURE_PHASES), required=True)
    parser.add_argument("--log", type=Path, required=True)
    parser.add_argument("--workdir", type=Path, required=True)
    parser.add_argument("--queries-json", type=Path, required=True)
    parser.add_argument("--binary", type=Path, default=None)
    parser.add_argument("--model-dir", type=Path, default=None)
    parser.add_argument("--mode", default=None)
    parser.add_argument("--corpus", type=Path, default=None)
    parser.add_argument("--xerj-bin", default=None)
    parser.add_argument("--xerj-model-dir", default=None)
    parser.add_argument("--neural", action="store_true")
    parser.add_argument("--opensearch-home", default=None)
    args = parser.parse_args(argv)
    queries: list[str] = json.loads(args.queries_json.read_text(encoding="utf-8"))
    if not isinstance(queries, list):
        raise SystemExit("error: queries JSON must be a list of strings")
    lines = read_log_lines(args.log)
    args.workdir.mkdir(parents=True, exist_ok=True)
    payload = run_measure_worker_phase(
        engine=args.engine,
        phase=args.phase,
        log_path=args.log,
        lines=lines,
        workdir=args.workdir,
        queries=queries,
        binary=args.binary,
        model_dir=args.model_dir,
        mode=args.mode,
        corpus=args.corpus,
        xerj_bin=args.xerj_bin,
        xerj_model_dir=args.xerj_model_dir,
        neural=args.neural,
        opensearch_home=args.opensearch_home,
    )
    print(json.dumps(payload, sort_keys=True, separators=(",", ":")))


def run_measure_worker_phase(
    *,
    engine: str,
    phase: str,
    log_path: Path,
    lines: list[str],
    workdir: Path,
    queries: list[str],
    binary: Path | None,
    model_dir: Path | None,
    mode: str | None,
    corpus: Path | None,
    xerj_bin: str | None,
    xerj_model_dir: str | None,
    neural: bool,
    opensearch_home: str | None = None,
) -> dict[str, Any]:
    if engine in OPENSEARCH_ENGINES:
        return _worker_opensearch_phase(
            phase=phase,
            lines=lines,
            workdir=workdir,
            queries=queries,
            opensearch_home=opensearch_home,
            knn=engine == "opensearch-knn",
        )
    if engine in CHUNK_CLI_ENGINES:
        return _worker_chunk_cli_phase(
            engine=engine,
            phase=phase,
            log_path=log_path,
            lines=lines,
            workdir=workdir,
            queries=queries,
            corpus=corpus,
        )
    if engine in ("bm25", "diy-faiss", "grep", "ripgrep", "nesso"):
        return _worker_local_phase(
            engine=engine,
            phase=phase,
            log_path=log_path,
            lines=lines,
            workdir=workdir,
            queries=queries,
            binary=binary,
            model_dir=model_dir,
            mode=mode,
            corpus=corpus,
        )
    if engine in XERJ_ENGINES:
        return _worker_xerj_phase(
            phase=phase,
            log_path=log_path,
            lines=lines,
            workdir=workdir,
            queries=queries,
            xerj_bin=xerj_bin,
            xerj_model_dir=xerj_model_dir,
            neural=neural or engine == "xerj-neural",
            semantic=engine == "xerj-semantic",
        )
    raise SystemExit(f"error: unknown measure worker engine {engine!r}")


def _worker_chunk_cli_phase(
    *,
    engine: str,
    phase: str,
    log_path: Path,
    lines: list[str],
    workdir: Path,
    queries: list[str],
    corpus: Path | None,
) -> dict[str, Any]:
    spec = CHUNK_CLI_SPECS[engine]
    if phase == "index":
        if corpus is None:
            raise SystemExit(f"error: {engine} index phase needs --corpus")
        chunk_cli_setup_root(spec, corpus, log_path)
        chunk_cli_index(spec, corpus)
        return {"indexBytes": chunk_cli_index_bytes(corpus, log_path), "latencySeconds": []}
    if phase == "queries":
        if corpus is None:
            raise SystemExit(f"error: {engine} queries phase needs --corpus")
        latencies: list[float] = []
        for query in queries:
            started = time.perf_counter()
            chunk_cli_search(spec, corpus, log_path.name, query, max_line=len(lines))
            latencies.append(time.perf_counter() - started)
        return {"latencySeconds": latencies}
    # ttfr: a fresh root and one search; both tools build their index on demand.
    root = workdir / f"{engine}-ttfr"
    started = time.perf_counter()
    chunk_cli_setup_root(spec, root, log_path)
    if queries:
        chunk_cli_search(spec, root, log_path.name, queries[0], max_line=len(lines))
    return {"latencySeconds": [time.perf_counter() - started]}


def _worker_local_phase(
    *,
    engine: str,
    phase: str,
    log_path: Path,
    lines: list[str],
    workdir: Path,
    queries: list[str],
    binary: Path | None,
    model_dir: Path | None,
    mode: str | None,
    corpus: Path | None,
) -> dict[str, Any]:
    if engine == "bm25":
        db_path = workdir / "bm25.sqlite"
        if phase == "index":
            bm25_build_db(db_path, lines)
            return {"indexBytes": db_path.stat().st_size, "latencySeconds": []}
        if phase == "queries":
            if not db_path.is_file():
                bm25_build_db(db_path, lines)
            latencies: list[float] = []
            for query in queries:
                started = time.perf_counter()
                bm25_rank_db(db_path, query)
                latencies.append(time.perf_counter() - started)
            return {"latencySeconds": latencies}
        # ttfr
        if db_path.exists():
            db_path.unlink()
        started = time.perf_counter()
        bm25_build_db(db_path, lines)
        if queries:
            bm25_rank_db(db_path, queries[0])
        return {"latencySeconds": [time.perf_counter() - started]}

    if engine == "diy-faiss":
        diy = load_diy_faiss_module()
        index_path = workdir / "diy_faiss.index"
        meta_path = workdir / "diy_faiss_meta.json"
        if phase == "index":
            engine_obj = diy.DiyFaissEngine()
            engine_obj.prepare(log_path, lines, workdir)
            engine_obj.write_index(index_path)
            meta_path.write_text(json.dumps({"n": len(lines)}), encoding="utf-8")
            return {"indexBytes": index_path.stat().st_size, "latencySeconds": []}
        if phase == "queries":
            meta = json.loads(meta_path.read_text(encoding="utf-8"))
            engine_obj = diy.DiyFaissEngine()
            engine_obj.read_index(index_path, int(meta["n"]))
            latencies = []
            for query in queries:
                started = time.perf_counter()
                engine_obj.rank(query)
                latencies.append(time.perf_counter() - started)
            return {"latencySeconds": latencies}
        engine_obj = diy.DiyFaissEngine()
        started = time.perf_counter()
        engine_obj.prepare(log_path, lines, workdir)
        if queries:
            engine_obj.rank(queries[0])
        return {"latencySeconds": [time.perf_counter() - started]}

    if engine in ("grep", "ripgrep"):
        argv_prefix = ["grep", "-n", "-F", "-i"] if engine == "grep" else ["rg", "-n", "-F", "-i"]
        label = engine
        if phase == "index":
            return {"indexBytes": None, "latencySeconds": []}
        if phase == "queries":
            latencies = []
            for query in queries:
                started = time.perf_counter()
                fixed_pattern_rank(argv_prefix, log_path, query, label=label)
                latencies.append(time.perf_counter() - started)
            return {"latencySeconds": latencies}
        started = time.perf_counter()
        if queries:
            fixed_pattern_rank(argv_prefix, log_path, queries[0], label=label)
        return {"latencySeconds": [time.perf_counter() - started]}

    if engine == "nesso":
        if binary is None or model_dir is None:
            raise SystemExit("error: nesso measure worker needs --binary and --model-dir")
        if phase == "index":
            if corpus is None:
                raise SystemExit("error: nesso index phase needs --corpus")
            if corpus.exists():
                shutil.rmtree(corpus)
            run_checked(
                [
                    str(binary),
                    "index",
                    "-o",
                    str(corpus),
                    str(log_path),
                    "--model-dir",
                    str(model_dir),
                ],
                label="nesso index",
            )
            return {"indexBytes": directory_size_bytes(corpus), "latencySeconds": []}
        if phase == "queries":
            if corpus is None:
                raise SystemExit("error: nesso queries phase needs --corpus")
            if mode is None:
                raise SystemExit("error: nesso queries phase needs --mode")
            latencies = []
            for query in queries:
                started = time.perf_counter()
                completed = run_command(
                    [
                        str(binary),
                        "search",
                        query,
                        "-i",
                        str(corpus),
                        "--json",
                        "-k",
                        str(K),
                        "--mode",
                        mode,
                        "--model-dir",
                        str(model_dir),
                    ],
                    label=f"nesso search ({mode})",
                    ok_codes=frozenset({0, 1}),
                )
                parse_search_json(completed.stdout)
                latencies.append(time.perf_counter() - started)
            return {"latencySeconds": latencies}
        # ttfr: cold nesso grep
        started = time.perf_counter()
        if queries:
            run_command(
                [
                    str(binary),
                    "grep",
                    queries[0],
                    str(log_path),
                    "--model-dir",
                    str(model_dir),
                    "-k",
                    str(K),
                ],
                label="nesso grep",
                ok_codes=frozenset({0, 1}),
            )
        return {"latencySeconds": [time.perf_counter() - started]}

    raise SystemExit(f"error: unsupported local measure engine {engine!r}")


def _worker_xerj_phase(
    *,
    phase: str,
    log_path: Path,
    lines: list[str],
    workdir: Path,
    queries: list[str],
    xerj_bin: str | None,
    xerj_model_dir: str | None,
    neural: bool,
    semantic: bool = False,
) -> dict[str, Any]:
    del log_path
    engines = ["xerj-semantic"] if semantic else (["xerj-neural"] if neural else ["xerj"])
    # Measure always owns a spawned node so GNU time includes server RSS.
    ctx = open_xerj_context(
        engines=engines,
        xerj_url=None,
        xerj_bin=xerj_bin,
        xerj_model_dir=xerj_model_dir,
    )
    try:
        if ctx.skip_reason or (neural and ctx.neural_skip_reason):
            reason = ctx.skip_reason or ctx.neural_skip_reason or "xerj unavailable"
            return {"skipped": True, "reason": reason, "latencySeconds": []}
        engine = make_xerj_engine(ctx, neural=neural, semantic=semantic)
        if isinstance(engine, SkippedEngine):
            return {"skipped": True, "reason": engine.reason, "latencySeconds": []}
        assert isinstance(engine, EsCompatEngine)
        data_dir = None
        if ctx._tmpdir is not None:
            data_dir = Path(ctx._tmpdir.name) / "data"
        marker = workdir / f"{engines[0]}-ready"
        if phase == "index":
            engine.prepare(Path("."), lines, workdir)
            index_bytes = directory_size_bytes(data_dir) if data_dir is not None else 0
            marker.write_text("1", encoding="utf-8")
            engine.cleanup()
            return {"indexBytes": index_bytes, "latencySeconds": []}
        if phase == "queries":
            # Re-index inside the owned node; query wall is the sum of query
            # latencies so spawn/index are not attributed to the query set.
            engine.prepare(Path("."), lines, workdir)
            latencies: list[float] = []
            for query in queries:
                started = time.perf_counter()
                engine.rank(query)
                latencies.append(time.perf_counter() - started)
            engine.cleanup()
            return {
                "latencySeconds": latencies,
                "queryWallSeconds": round(sum(latencies), 6),
            }
        engine.prepare(Path("."), lines, workdir)
        started = time.perf_counter()
        if queries:
            engine.rank(queries[0])
        elapsed = time.perf_counter() - started
        engine.cleanup()
        # TTFR includes spawn+index+first query; wall comes from GNU time on this process.
        return {"latencySeconds": [elapsed], "includeSpawnInWall": True}
    finally:
        ctx.shutdown()


def _worker_opensearch_phase(
    *,
    phase: str,
    lines: list[str],
    workdir: Path,
    queries: list[str],
    opensearch_home: str | None,
    knn: bool,
) -> dict[str, Any]:
    name = "opensearch-knn" if knn else "opensearch"
    # Measure always owns a spawned JVM so GNU time includes server RSS.
    ctx = open_opensearch_context(
        engines=[name],
        opensearch_url=None,
        opensearch_home=opensearch_home,
    )
    try:
        engine = make_opensearch_engine(ctx, knn=knn)
        if isinstance(engine, SkippedEngine):
            return {"skipped": True, "reason": engine.reason, "latencySeconds": []}
        assert isinstance(engine, EsCompatEngine)
        if phase == "index":
            engine.prepare(Path("."), lines, workdir)
            engine.flush()
            data_dir = ctx.data_dir
            index_bytes = directory_size_bytes(data_dir) if data_dir is not None else None
            engine.cleanup()
            return {"indexBytes": index_bytes, "latencySeconds": []}
        if phase == "queries":
            # Same as xerj: re-index in the owned node and report the summed
            # query latencies so spawn and index time stay out of query wall.
            engine.prepare(Path("."), lines, workdir)
            latencies: list[float] = []
            for query in queries:
                started = time.perf_counter()
                engine.rank(query)
                latencies.append(time.perf_counter() - started)
            engine.cleanup()
            return {
                "latencySeconds": latencies,
                "queryWallSeconds": round(sum(latencies), 6),
            }
        engine.prepare(Path("."), lines, workdir)
        started = time.perf_counter()
        if queries:
            engine.rank(queries[0])
        elapsed = time.perf_counter() - started
        engine.cleanup()
        return {"latencySeconds": [elapsed], "includeSpawnInWall": True}
    finally:
        ctx.shutdown()


def measure_cli_engine_once(
    *,
    engine: str,
    log_path: Path,
    log_bytes: int,
    queries: list[str],
    workdir: Path,
    binary: Path | None,
    model_dir: Path | None,
    modes: list[str],
    xerj_bin: str | None,
    xerj_model_dir: str | None,
    opensearch_home: str | None = None,
) -> dict[str, Any]:
    workdir.mkdir(parents=True, exist_ok=True)
    if engine in ("grep", "ripgrep"):
        if engine == "ripgrep" and shutil.which("rg") is None:
            return {"engine": engine, "status": "skipped", "reason": "rg executable not found"}
        index_fields = no_index_fields(log_bytes)
        query_payload = run_measure_worker(
            engine=engine,
            phase="queries",
            log_path=log_path,
            workdir=workdir / "queries",
            queries=queries,
        )
        ttfr_payload = run_measure_worker(
            engine=engine,
            phase="ttfr",
            log_path=log_path,
            workdir=workdir / "ttfr",
            queries=queries[:1],
        )
        return {
            "engine": engine,
            "status": "ok",
            **index_fields,
            **query_metric_fields(
                wall=query_payload["wallSeconds"],
                peak_rss=query_payload["peakRssBytes"],
                latencies=list(query_payload.get("latencySeconds", [])),
            ),
            "timeToFirstResultSeconds": ttfr_payload["wallSeconds"],
        }

    if engine == "nesso":
        assert binary is not None and model_dir is not None
        corpus = workdir / "corpus.nesso"
        index_payload = run_measure_worker(
            engine="nesso",
            phase="index",
            log_path=log_path,
            workdir=workdir / "index",
            queries=[],
            binary=binary,
            model_dir=model_dir,
            corpus=corpus,
        )
        modes_out: list[dict[str, Any]] = []
        for mode in modes:
            query_payload = run_measure_worker(
                engine="nesso",
                phase="queries",
                log_path=log_path,
                workdir=workdir / f"queries-{mode}",
                queries=queries,
                binary=binary,
                model_dir=model_dir,
                mode=mode,
                corpus=corpus,
            )
            modes_out.append(
                {
                    "mode": mode,
                    **query_metric_fields(
                        wall=query_payload["wallSeconds"],
                        peak_rss=query_payload["peakRssBytes"],
                        latencies=list(query_payload.get("latencySeconds", [])),
                    ),
                }
            )
        ttfr_dir = workdir / "ttfr"
        ttfr_dir.mkdir(parents=True, exist_ok=True)
        ttfr_cache = ttfr_dir / "xdg-cache"
        ttfr_cache.mkdir(parents=True, exist_ok=True)
        ttfr_payload = run_measure_worker(
            engine="nesso",
            phase="ttfr",
            log_path=log_path,
            workdir=ttfr_dir,
            queries=queries[:1],
            binary=binary,
            model_dir=model_dir,
            env={"XDG_CACHE_HOME": str(ttfr_cache)},
        )
        index_bytes = index_payload.get("indexBytes")
        return {
            "engine": "nesso",
            "status": "ok",
            "indexWallSeconds": index_payload["wallSeconds"],
            "indexPeakRssBytes": index_payload["peakRssBytes"],
            "indexBytes": index_bytes,
            "indexToLogRatio": index_to_log_ratio(index_bytes, log_bytes),
            "timeToFirstResultSeconds": ttfr_payload["wallSeconds"],
            "modes": modes_out,
        }

    if engine in CHUNK_CLI_ENGINES:
        if shutil.which(CHUNK_CLI_SPECS[engine].executable) is None:
            return {
                "engine": engine,
                "status": "skipped",
                "reason": f"{CHUNK_CLI_SPECS[engine].executable} executable not found",
            }
        corpus = workdir / f"{engine}-corpus"
        index_payload = run_measure_worker(
            engine=engine,
            phase="index",
            log_path=log_path,
            workdir=workdir / "index",
            queries=[],
            corpus=corpus,
        )
        query_payload = run_measure_worker(
            engine=engine,
            phase="queries",
            log_path=log_path,
            workdir=workdir / "queries",
            queries=queries,
            corpus=corpus,
        )
        ttfr_payload = run_measure_worker(
            engine=engine,
            phase="ttfr",
            log_path=log_path,
            workdir=workdir / "ttfr",
            queries=queries[:1],
        )
        index_bytes = index_payload.get("indexBytes")
        return {
            "engine": engine,
            "status": "ok",
            "indexWallSeconds": index_payload["wallSeconds"],
            "indexPeakRssBytes": index_payload["peakRssBytes"],
            "indexBytes": index_bytes,
            "indexToLogRatio": index_to_log_ratio(index_bytes, log_bytes),
            **query_metric_fields(
                wall=query_payload["wallSeconds"],
                peak_rss=query_payload["peakRssBytes"],
                latencies=list(query_payload.get("latencySeconds", [])),
            ),
            "timeToFirstResultSeconds": ttfr_payload["wallSeconds"],
        }

    if engine in ("bm25", "diy-faiss"):
        index_payload = run_measure_worker(
            engine=engine,
            phase="index",
            log_path=log_path,
            workdir=workdir / "index",
            queries=[],
        )
        # Share the index workdir artifacts with the queries phase.
        if engine == "bm25":
            db_src = workdir / "index" / "bm25.sqlite"
            query_dir = workdir / "queries"
            query_dir.mkdir(parents=True, exist_ok=True)
            if db_src.is_file():
                shutil.copy2(db_src, query_dir / "bm25.sqlite")
        else:
            query_dir = workdir / "queries"
            query_dir.mkdir(parents=True, exist_ok=True)
            for name in ("diy_faiss.index", "diy_faiss_meta.json"):
                src = workdir / "index" / name
                if src.is_file():
                    shutil.copy2(src, query_dir / name)
        query_payload = run_measure_worker(
            engine=engine,
            phase="queries",
            log_path=log_path,
            workdir=query_dir,
            queries=queries,
        )
        ttfr_payload = run_measure_worker(
            engine=engine,
            phase="ttfr",
            log_path=log_path,
            workdir=workdir / "ttfr",
            queries=queries[:1],
        )
        index_bytes = index_payload.get("indexBytes")
        return {
            "engine": engine,
            "status": "ok",
            "indexWallSeconds": index_payload["wallSeconds"],
            "indexPeakRssBytes": index_payload["peakRssBytes"],
            "indexBytes": index_bytes,
            "indexToLogRatio": index_to_log_ratio(index_bytes, log_bytes),
            **query_metric_fields(
                wall=query_payload["wallSeconds"],
                peak_rss=query_payload["peakRssBytes"],
                latencies=list(query_payload.get("latencySeconds", [])),
            ),
            "timeToFirstResultSeconds": ttfr_payload["wallSeconds"],
        }

    if engine in XERJ_ENGINES or engine in OPENSEARCH_ENGINES:
        # Server engines: each phase spawns its own node inside the timed child.
        server_args: dict[str, Any] = {
            "xerj_bin": xerj_bin,
            "xerj_model_dir": xerj_model_dir,
            "neural": engine == "xerj-neural",
            "opensearch_home": opensearch_home,
        }
        index_payload = run_measure_worker(
            engine=engine,
            phase="index",
            log_path=log_path,
            workdir=workdir / "index",
            queries=[],
            **server_args,
        )
        if index_payload.get("skipped"):
            return {
                "engine": engine,
                "status": "skipped",
                "reason": index_payload.get("reason", f"{engine} unavailable"),
            }
        query_payload = run_measure_worker(
            engine=engine,
            phase="queries",
            log_path=log_path,
            workdir=workdir / "queries",
            queries=queries,
            **server_args,
        )
        ttfr_payload = run_measure_worker(
            engine=engine,
            phase="ttfr",
            log_path=log_path,
            workdir=workdir / "ttfr",
            queries=queries[:1],
            **server_args,
        )
        index_bytes = index_payload.get("indexBytes")
        query_wall = query_payload.get("queryWallSeconds", query_payload["wallSeconds"])
        return {
            "engine": engine,
            "status": "ok",
            "indexWallSeconds": index_payload["wallSeconds"],
            "indexPeakRssBytes": index_payload["peakRssBytes"],
            "indexBytes": index_bytes,
            "indexToLogRatio": index_to_log_ratio(index_bytes, log_bytes),
            **query_metric_fields(
                wall=query_wall,
                peak_rss=query_payload["peakRssBytes"],
                latencies=list(query_payload.get("latencySeconds", [])),
            ),
            "timeToFirstResultSeconds": ttfr_payload["wallSeconds"],
        }

    raise SystemExit(f"error: unknown measure engine {engine!r}")


def measure_dataset(
    *,
    dataset_name: str,
    log_path: Path,
    query_texts: list[str],
    engines: list[str],
    modes: list[str],
    workdir: Path,
    binary: Path | None,
    model_dir: Path | None,
    xerj_bin: str | None,
    xerj_model_dir: str | None,
    repeats: int,
    opensearch_home: str | None = None,
) -> dict[str, Any]:
    log_bytes = log_path.stat().st_size
    log_lines = sum(1 for _ in log_path.open("r", encoding="utf-8", errors="replace"))
    engine_rows: list[dict[str, Any]] = []
    for engine in engines:
        repeats_out: list[dict[str, Any]] = []
        for index in range(repeats):
            repeat_dir = workdir / f"{engine}-r{index}"
            if repeat_dir.exists():
                shutil.rmtree(repeat_dir)
            repeats_out.append(
                measure_cli_engine_once(
                    engine=engine,
                    log_path=log_path,
                    log_bytes=log_bytes,
                    queries=query_texts,
                    workdir=repeat_dir,
                    binary=binary,
                    model_dir=model_dir,
                    modes=modes,
                    xerj_bin=xerj_bin,
                    xerj_model_dir=xerj_model_dir,
                    opensearch_home=opensearch_home,
                )
            )
        engine_rows.append(merge_engine_measure_repeats(repeats_out))
    return {
        "name": dataset_name,
        "logBytes": log_bytes,
        "logLines": log_lines,
        "engines": engine_rows,
    }


def format_measure_table(dataset: dict[str, Any]) -> str:
    headers = (
        "engine",
        "index_s",
        "index_rss",
        "index_bytes",
        "ratio",
        "q_wall_s",
        "q_rss",
        "q_p50_s",
        "q_p95_s",
        "ttfr_s",
    )
    rows: list[tuple[str, ...]] = []
    for engine in dataset["engines"]:
        name = engine["engine"]
        if engine.get("status") == "skipped":
            rows.append((name, "skipped", engine.get("reason", ""), "", "", "", "", "", "", ""))
            continue
        if "modes" in engine:
            rows.append(
                (
                    name,
                    format_measure_none(engine.get("indexWallSeconds")),
                    format_measure_none(engine.get("indexPeakRssBytes")),
                    format_measure_none(engine.get("indexBytes")),
                    format_measure_none(engine.get("indexToLogRatio")),
                    "-",
                    "-",
                    "-",
                    "-",
                    format_measure_none(engine.get("timeToFirstResultSeconds")),
                )
            )
            for mode in engine["modes"]:
                rows.append(
                    (
                        f"{name}/{mode['mode']}",
                        "-",
                        "-",
                        "-",
                        "-",
                        format_measure_none(mode.get("queryWallSeconds")),
                        format_measure_none(mode.get("queryPeakRssBytes")),
                        format_measure_none(mode.get("queryLatencyMedianSeconds")),
                        format_measure_none(mode.get("queryLatencyP95Seconds")),
                        "-",
                    )
                )
            continue
        rows.append(
            (
                name,
                format_measure_none(engine.get("indexWallSeconds")),
                format_measure_none(engine.get("indexPeakRssBytes")),
                format_measure_none(engine.get("indexBytes")),
                format_measure_none(engine.get("indexToLogRatio")),
                format_measure_none(engine.get("queryWallSeconds")),
                format_measure_none(engine.get("queryPeakRssBytes")),
                format_measure_none(engine.get("queryLatencyMedianSeconds")),
                format_measure_none(engine.get("queryLatencyP95Seconds")),
                format_measure_none(engine.get("timeToFirstResultSeconds")),
            )
        )
    widths = [len(header) for header in headers]
    for row in rows:
        for index, cell in enumerate(row):
            widths[index] = max(widths[index], len(cell))
    lines = [
        "  ".join(header.ljust(widths[index]) for index, header in enumerate(headers)),
        "  ".join("-" * widths[index] for index in range(len(headers))),
    ]
    for row in rows:
        lines.append("  ".join(cell.ljust(widths[index]) for index, cell in enumerate(row)))
    return "\n".join(lines)


def format_measure_sections(measure: dict) -> list[str]:
    sections: list[str] = []
    sections.append("=== measure ===")
    sections.append(
        f"platform={measure.get('platform')} cpu={measure.get('cpuModel')} "
        f"nproc={measure.get('nproc')} threads={measure.get('threads')} "
        f"repeat={measure.get('repeat')}"
    )
    tools = measure.get("tool")
    if isinstance(tools, dict):
        sections.append("tools: " + " ".join(f"{key}={value}" for key, value in sorted(tools.items())))
    for dataset in measure.get("datasets", []):
        sections.append(f"=== measure {dataset['name']} ===")
        sections.append(format_measure_table(dataset))
    return sections


def format_report_with_measure(payload: dict) -> str:
    sections: list[str] = []
    if payload.get("datasets") and payload.get("overall") is not None:
        sections.append(format_report(payload))
    measure = payload.get("measure")
    if not isinstance(measure, dict):
        return "\n".join(sections)
    sections.extend(format_measure_sections(measure))
    return "\n".join(sections)


# --- Needle benchmark --------------------------------------------------------
# Windows of the Loghub 2.0 BGL and Thunderbird logs, where the relevant set of
# a query is every line the system administrators tagged with one alert
# category (Oliner & Stearley, DSN 2007). scripts/fetch-loghub strips the tag
# from the text and writes it to a .labels sidecar.

NEEDLES_DIR = ROOT / "test" / "eval" / "needles"
NEEDLE_DEPTH = 100
NEEDLE_CLASSES = ("keyword", "symptom")
NEEDLE_SCHEMA_VERSION = 1
# Overlap is measured against at most this many relevant lines per query.
NEEDLE_OVERLAP_SAMPLE = 2000


@dataclass(frozen=True)
class NeedleSpec:
    name: str
    source: str  # fetch-loghub dataset
    stem: str  # fetch-loghub window file stem
    start: int
    count: int
    queries_name: str

    @property
    def log_path(self) -> Path:
        return BENCH_DIR / f"{self.stem}_{self.start}_{self.count}.log"

    @property
    def labels_path(self) -> Path:
        return BENCH_DIR / f"{self.stem}_{self.start}_{self.count}.labels"

    @property
    def queries_path(self) -> Path:
        return NEEDLES_DIR / self.queries_name

    @property
    def corpus_name(self) -> str:
        return self.name.replace("-", "_") + ".nesso"


DATASETS_NEEDLE: dict[str, NeedleSpec] = {
    "bgl-needle-100k": NeedleSpec(
        "bgl-needle-100k", "bgl-loghub2", "BGL_loghub2", 4_100_001, 100_000, "bgl.jsonl"
    ),
    "bgl-needle-1m": NeedleSpec(
        "bgl-needle-1m", "bgl-loghub2", "BGL_loghub2", 3_200_001, 1_000_000, "bgl.jsonl"
    ),
    "thunderbird-needle-1m": NeedleSpec(
        "thunderbird-needle-1m",
        "thunderbird-loghub2",
        "Thunderbird_loghub2",
        8_550_001,
        1_000_000,
        "thunderbird.jsonl",
    ),
}
ALL_NEEDLE = "all-needle"


@dataclass(frozen=True)
class NeedleQuery:
    id: str
    class_name: str
    query: str
    alert: str


def load_needle_queries(path: Path) -> list[NeedleQuery]:
    if not path.is_file():
        raise SystemExit(f"error: needle query file not found: {path}")
    queries: list[NeedleQuery] = []
    seen: set[str] = set()
    for lineno, raw in enumerate(path.read_text(encoding="utf-8").splitlines(), start=1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        try:
            payload = json.loads(line)
        except json.JSONDecodeError as exc:
            raise SystemExit(f"error: {path}:{lineno}: invalid JSON: {exc}") from exc
        if not isinstance(payload, dict):
            raise SystemExit(f"error: {path}:{lineno}: query must be a JSON object")
        query_id = payload.get("id")
        class_name = payload.get("class")
        text = payload.get("query")
        alert = payload.get("alert")
        if not isinstance(query_id, str) or not query_id or query_id in seen:
            raise SystemExit(f"error: {path}:{lineno}: missing or duplicate id")
        if class_name not in NEEDLE_CLASSES:
            raise SystemExit(f"error: {path}:{lineno}: class must be one of {list(NEEDLE_CLASSES)}")
        if not isinstance(text, str) or not text.strip():
            raise SystemExit(f"error: {path}:{lineno}: missing query")
        if not isinstance(alert, str) or not alert or alert == "-":
            raise SystemExit(f"error: {path}:{lineno}: alert must be an alert category")
        unknown = set(payload) - {"id", "class", "query", "alert", "meaning"}
        if unknown:
            raise SystemExit(f"error: {path}:{lineno}: unknown keys {sorted(unknown)}")
        seen.add(query_id)
        queries.append(NeedleQuery(query_id, class_name, text, alert))
    if not queries:
        raise SystemExit(f"error: {path}: no queries")
    return queries


def load_labels(path: Path, expected_lines: int) -> list[str]:
    if not path.is_file():
        raise SystemExit(f"error: labels file not found: {path}")
    labels = path.read_text(encoding="utf-8").splitlines()
    if len(labels) != expected_lines:
        raise SystemExit(
            f"error: {path} has {len(labels)} labels but the log has {expected_lines} lines"
        )
    return labels


def lines_by_alert(labels: list[str]) -> dict[str, frozenset[int]]:
    grouped: dict[str, set[int]] = {}
    for line_id, label in enumerate(labels, start=1):
        if label != "-":
            grouped.setdefault(label, set()).add(line_id)
    return {alert: frozenset(ids) for alert, ids in grouped.items()}


def word_tokens(text: str) -> set[str]:
    tokens: set[str] = set()
    current: list[str] = []
    for char in text.lower():
        if char in TOKEN_CHARS:
            current.append(char)
        elif current:
            tokens.add("".join(current))
            current = []
    if current:
        tokens.add("".join(current))
    return tokens


def query_overlap(query: str, relevant: frozenset[int], lines: list[str]) -> float:
    """Share of the query's word tokens that occur in the relevant lines."""
    query_tokens = word_tokens(query)
    if not query_tokens:
        return 0.0
    line_tokens: set[str] = set()
    for line_id in sorted(relevant)[:NEEDLE_OVERLAP_SAMPLE]:
        line_tokens |= word_tokens(lines[line_id - 1])
    return len(query_tokens & line_tokens) / len(query_tokens)


def precision_at_k(ranked_lines: list[int], relevant: frozenset[int], k: int = K) -> float:
    top = ranked_lines[:k]
    if not top:
        return 0.0
    return sum(1 for line_id in top if line_id in relevant) / k


def first_hit_rank(ranked_lines: list[int], relevant: frozenset[int], depth: int = NEEDLE_DEPTH) -> int | None:
    for index, line_id in enumerate(ranked_lines[:depth], start=1):
        if line_id in relevant:
            return index
    return None


def needle_query_row(query: NeedleQuery, relevant: frozenset[int], ranked: list[int], overlap: float) -> dict:
    metrics = score_ranking(ranked, relevant)
    return {
        "alert": query.alert,
        "class": query.class_name,
        "first_hit_rank": first_hit_rank(ranked, relevant),
        "id": query.id,
        "metrics": {
            **metrics_dict(metrics),
            "precision_at_10": round_metric(precision_at_k(ranked, relevant)),
        },
        "overlap": round_metric(overlap),
        "ranked_lines": ranked[:K],
        "relevant_count": len(relevant),
    }


def summarize_needle_rows(rows: list[dict]) -> dict:
    if not rows:
        return {"n": 0}
    ranks = [row["first_hit_rank"] for row in rows if row["first_hit_rank"] is not None]
    names = ("recall_at_10", "mrr", "ndcg_at_10", "precision_at_10")
    return {
        "found_at_depth": round_metric(len(ranks) / len(rows)),
        "median_first_hit_rank": statistics.median(ranks) if ranks else None,
        "metrics": {
            name: round_metric(statistics.fmean(row["metrics"][name] for row in rows)) for name in names
        },
        "mean_overlap": round_metric(statistics.fmean(row["overlap"] for row in rows)),
        "n": len(rows),
    }


def needle_buckets(rows: list[dict]) -> dict:
    return {
        "by_class": [
            {"class": name, **summarize_needle_rows([row for row in rows if row["class"] == name])}
            for name in NEEDLE_CLASSES
        ],
        "overall": summarize_needle_rows(rows),
    }


def score_needle_queries(
    queries: list[NeedleQuery],
    relevant_by_alert: dict[str, frozenset[int]],
    overlaps: dict[str, float],
    rank_fn: Callable[[str], list[int]],
) -> dict:
    rows = []
    for query in queries:
        relevant = relevant_by_alert[query.alert]
        rows.append(needle_query_row(query, relevant, rank_fn(query.query), overlaps[query.id]))
    return {**needle_buckets(rows), "queries": rows}


def ensure_needle_inputs(spec: NeedleSpec, *, skip_fetch: bool) -> None:
    if spec.log_path.is_file() and spec.labels_path.is_file():
        return
    if skip_fetch:
        raise SystemExit(f"error: needle window missing and --skip-fetch is set: {spec.log_path}")
    run_checked(
        [
            sys.executable,
            str(ROOT / "scripts" / "fetch-loghub"),
            "--dataset",
            spec.source,
            "--window",
            f"{spec.start}:{spec.count}",
            "--dest-dir",
            str(BENCH_DIR),
        ],
        label="fetch-loghub",
    )


def parse_needle_datasets(raw: str) -> list[NeedleSpec]:
    names: list[str] = []
    for part in (piece.strip() for piece in raw.split(",")):
        if not part:
            continue
        if part == ALL_NEEDLE:
            names.extend(DATASETS_NEEDLE)
        elif part in DATASETS_NEEDLE:
            names.append(part)
        else:
            raise SystemExit(
                f"error: cannot mix needle and other datasets, or unknown needle dataset {part!r}; "
                f"expected {sorted(DATASETS_NEEDLE) + [ALL_NEEDLE]}"
            )
    ordered: list[NeedleSpec] = []
    for name in dict.fromkeys(names):
        ordered.append(DATASETS_NEEDLE[name])
    if not ordered:
        raise SystemExit("error: --dataset must list at least one needle dataset")
    return ordered


def is_needle_request(raw: str | None) -> bool:
    if raw is None:
        return False
    parts = [part.strip() for part in raw.split(",") if part.strip()]
    return any(part in DATASETS_NEEDLE or part == ALL_NEEDLE for part in parts)


def evaluate_needle_dataset(
    spec: NeedleSpec,
    *,
    engines: list[str],
    modes: list[str],
    binary: Path | None,
    model_dir: Path | None,
    workdir: Path,
    xerj: XerjContext,
    opensearch: OpenSearchContext,
) -> dict:
    lines = read_log_lines(spec.log_path)
    labels = load_labels(spec.labels_path, len(lines))
    relevant_by_alert = lines_by_alert(labels)
    all_queries = load_needle_queries(spec.queries_path)
    queries = [query for query in all_queries if query.alert in relevant_by_alert]
    absent = sorted({query.alert for query in all_queries} - set(relevant_by_alert))
    uncovered = sorted(set(relevant_by_alert) - {query.alert for query in all_queries})
    if not queries:
        raise SystemExit(f"error: no query in {spec.queries_path} matches an alert in {spec.name}")
    overlaps = {
        query.id: query_overlap(query.query, relevant_by_alert[query.alert], lines) for query in queries
    }
    workdir.mkdir(parents=True, exist_ok=True)
    rows: list[dict] = []
    for engine_name in engines:
        if engine_name == "nesso":
            assert binary is not None and model_dir is not None
            engine = NessoEngine(binary=binary, model_dir=model_dir, corpus=workdir / spec.corpus_name)
            engine.prepare(spec.log_path, lines, workdir)
            for mode in modes:
                scored = score_needle_queries(
                    queries,
                    relevant_by_alert,
                    overlaps,
                    lambda text, mode=mode: engine.rank_mode(text, mode, k=NEEDLE_DEPTH),
                )
                rows.append({"engine": f"nesso/{mode}", "status": "ok", **scored})
            continue
        other = make_rank_engine(engine_name, xerj=xerj, opensearch=opensearch)
        ok, reason = other.availability()
        if not ok:
            if engine_name not in SKIPPABLE_ENGINES:
                raise SystemExit(f"error: {reason}")
            rows.append({"engine": engine_name, "status": "skipped", "reason": reason})
            continue
        try:
            other.prepare(spec.log_path, lines, workdir)
            scored = score_needle_queries(
                queries,
                relevant_by_alert,
                overlaps,
                lambda text: other.rank(text, k=NEEDLE_DEPTH),
            )
            row = {"engine": engine_name, "status": "ok", **scored}
            versions_fn = getattr(other, "versions", None)
            if callable(versions_fn):
                row["versions"] = versions_fn()
            rows.append(row)
        finally:
            cleanup = getattr(other, "cleanup", None)
            if callable(cleanup):
                cleanup()
    return {
        "alert_counts": {alert: len(ids) for alert, ids in sorted(relevant_by_alert.items())},
        "dataset": spec.name,
        "engines": rows,
        "lines": len(lines),
        "queries_absent_alert": absent,
        "query_count": len(queries),
        "uncovered_alerts": uncovered,
        "window": {"count": spec.count, "source": spec.source, "start": spec.start},
    }


def aggregate_needle_overall(dataset_results: list[dict]) -> list[dict]:
    names: list[str] = []
    for dataset in dataset_results:
        for row in dataset["engines"]:
            if row["engine"] not in names:
                names.append(row["engine"])
    overall: list[dict] = []
    for name in names:
        entries = [
            row for dataset in dataset_results for row in dataset["engines"] if row["engine"] == name
        ]
        skipped = [row for row in entries if row["status"] == "skipped"]
        if skipped:
            overall.append({"engine": name, "status": "skipped", "reason": skipped[0]["reason"]})
            continue
        rows = [query for entry in entries for query in entry["queries"]]
        overall.append({"engine": name, "status": "ok", **needle_buckets(rows)})
    return overall


def format_needle_table(engines: list[dict]) -> str:
    headers = ("engine", "class", "n", "p@10", "MRR", "nDCG@10", f"found@{NEEDLE_DEPTH}", "median 1st", "overlap")
    rows: list[tuple[str, ...]] = []
    for engine in engines:
        if engine["status"] == "skipped":
            rows.append((engine["engine"], "skipped", "-", engine.get("reason", ""), "", "", "", "", ""))
            continue
        buckets = [*engine["by_class"], {"class": "overall", **engine["overall"]}]
        for bucket in buckets:
            if not bucket.get("n"):
                continue
            metrics = bucket["metrics"]
            median = bucket["median_first_hit_rank"]
            rows.append(
                (
                    engine["engine"],
                    bucket["class"],
                    str(bucket["n"]),
                    f"{metrics['precision_at_10']:0.3f}",
                    f"{metrics['mrr']:0.3f}",
                    f"{metrics['ndcg_at_10']:0.3f}",
                    f"{bucket['found_at_depth']:0.3f}",
                    "none" if median is None else f"{median:g}",
                    f"{bucket['mean_overlap']:0.2f}",
                )
            )
    widths = [len(header) for header in headers]
    for row in rows:
        for index, cell in enumerate(row):
            widths[index] = max(widths[index], len(cell))
    out = [
        "  ".join(header.ljust(widths[index]) for index, header in enumerate(headers)),
        "  ".join("-" * widths[index] for index in range(len(headers))),
    ]
    for row in rows:
        out.append("  ".join(cell.ljust(widths[index]) for index, cell in enumerate(row)))
    return "\n".join(out)


def format_needle_report(payload: dict) -> str:
    sections: list[str] = []
    for dataset in payload["datasets"]:
        alerts = dataset["alert_counts"]
        sections.append(
            f"=== {dataset['dataset']} ({dataset['lines']} lines, {len(alerts)} alert categories, "
            f"{sum(alerts.values())} alert lines, {dataset['query_count']} queries) ==="
        )
        sections.append(format_needle_table(dataset["engines"]))
        if dataset["uncovered_alerts"]:
            sections.append("# alerts without a query: " + ", ".join(dataset["uncovered_alerts"]))
    sections.append("=== overall ===")
    sections.append(format_needle_table(payload["overall"]["engines"]))
    return "\n".join(sections)


def measure_needle_datasets(
    specs: list[NeedleSpec],
    *,
    args: argparse.Namespace,
    engines: list[str],
    modes: list[str],
    binary: Path | None,
    model_dir: Path | None,
) -> dict:
    """Speed, memory, and index size on each needle window, for the window's queries."""
    repeats = DEFAULT_MEASURE_REPEAT if args.repeat is None else args.repeat
    opensearch_home: str | None = None
    if OPENSEARCH_ENGINES.intersection(engines):
        resolved = resolve_opensearch_home(args.opensearch_home)
        opensearch_home = str(resolved) if resolved is not None else None
    datasets = []
    for spec in specs:
        lines = read_log_lines(spec.log_path)
        present = set(lines_by_alert(load_labels(spec.labels_path, len(lines))))
        texts = [query.query for query in load_needle_queries(spec.queries_path) if query.alert in present]
        datasets.append(
            measure_dataset(
                dataset_name=spec.name,
                log_path=spec.log_path,
                query_texts=texts,
                engines=engines,
                modes=modes,
                workdir=args.workdir / "measure" / spec.name,
                binary=binary,
                model_dir=model_dir,
                xerj_bin=args.xerj_bin,
                xerj_model_dir=args.xerj_model_dir,
                repeats=repeats,
                opensearch_home=opensearch_home,
            )
        )
    return {
        "cpuModel": cpu_model(),
        "datasets": datasets,
        "nproc": logical_cpus(),
        "platform": platform.platform(),
        "repeat": repeats,
        "threads": threads_setting(),
        "tool": collect_measure_tool_versions(
            engines=engines,
            binary=binary,
            xerj_bin=args.xerj_bin,
            opensearch_home=opensearch_home,
            model_dir=model_dir,
        ),
    }


def run_needles(args: argparse.Namespace, engines: list[str], modes: list[str]) -> None:
    if args.measure_only and not args.measure:
        raise SystemExit("error: --measure-only requires --measure")
    specs = parse_needle_datasets(args.dataset)
    binary: Path | None = None
    model_dir: Path | None = None
    if "nesso" in engines:
        binary = resolve_binary(args.binary)
        model_dir = resolve_model_dir(args.model_dir)
    for spec in specs:
        ensure_needle_inputs(spec, skip_fetch=args.skip_fetch)
    # Measure spawns a fresh node per phase; an idle one would hold memory.
    xerj = (
        XerjContext()
        if args.measure_only
        else open_xerj_context(
            engines=engines,
            xerj_url=args.xerj_url,
            xerj_bin=args.xerj_bin,
            xerj_model_dir=args.xerj_model_dir,
        )
    )
    results: list[dict] = []
    opensearch = OpenSearchContext()
    try:
        if not args.measure_only:
            opensearch = open_opensearch_context(
                engines=engines,
                opensearch_url=args.opensearch_url,
                opensearch_home=args.opensearch_home,
            )
            results = [
                evaluate_needle_dataset(
                    spec,
                    engines=engines,
                    modes=modes,
                    binary=binary,
                    model_dir=model_dir,
                    workdir=args.workdir / spec.name,
                    xerj=xerj,
                    opensearch=opensearch,
                )
                for spec in specs
            ]
    finally:
        opensearch.shutdown()
        xerj.shutdown()
    payload: dict = {
        "datasets": results,
        "depth": NEEDLE_DEPTH,
        "k": K,
        "kind": "needle",
        # Which model files produced nesso's rows, so a later model change is visible.
        "nesso": (
            {"version": tool_version_line([str(binary), "-V"]), "model": model_identity(model_dir)}
            if "nesso" in engines and binary is not None
            else None
        ),
        "overall": {
            "engines": aggregate_needle_overall(results) if results else [],
            "query_count": sum(item["query_count"] for item in results),
        },
        "schema_version": NEEDLE_SCHEMA_VERSION,
    }
    sections = [format_needle_report(payload)] if results else []
    if args.measure:
        payload["measure"] = measure_needle_datasets(
            specs, args=args, engines=engines, modes=modes, binary=binary, model_dir=model_dir
        )
        sections.extend(format_measure_sections(payload["measure"]))
    encoded = json.dumps(payload, sort_keys=True, separators=(",", ":")) + "\n"
    args.out.parent.mkdir(parents=True, exist_ok=True)
    args.out.write_text(encoded, encoding="utf-8")
    print("\n".join(sections))
    print(f"wrote {args.out}")


def main(argv: list[str] | None = None) -> None:
    argv_list = list(sys.argv[1:] if argv is None else argv)
    if argv_list and argv_list[0] == "--measure-worker":
        measure_worker_main(argv_list[1:])
        return

    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--out", type=Path, required=True, help="Deterministic JSON report path")
    parser.add_argument(
        "--dataset",
        default=None,
        help="Comma-separated 2k datasets or all-2k (maps log, CSV, and query file); "
        "with --measure/--log-prefix-lines also hdfs-v1,bgl,thunderbird,all-full; "
        "or needle windows bgl-needle-100k,bgl-needle-1m,thunderbird-needle-1m,all-needle",
    )
    parser.add_argument("--queries", type=Path, default=DEFAULT_QUERIES, help="JSONL query set")
    parser.add_argument("--log", type=Path, default=DEFAULT_LOG, help="Loghub 2k log path")
    parser.add_argument(
        "--structured",
        type=Path,
        default=DEFAULT_STRUCTURED,
        help="Loghub 2k structured CSV path",
    )
    parser.add_argument(
        "--modes",
        default=",".join(DEFAULT_MODES),
        help="Comma-separated search modes for nesso (default: auto,hybrid,dense,lexical)",
    )
    parser.add_argument(
        "--engine",
        action="append",
        dest="engines",
        choices=list(VALID_ENGINES),
        help="Ranking engine (repeatable; default: nesso). Non-nesso engines use schema_version 4",
    )
    parser.add_argument("--binary", default=None, help="Path to the nesso executable")
    parser.add_argument("--model-dir", default=None, help="Directory with model.onnx and vocab.txt")
    parser.add_argument(
        "--workdir",
        type=Path,
        default=ROOT / "build" / "eval",
        help="Directory for the temporary corpus",
    )
    parser.add_argument(
        "--skip-fetch",
        action="store_true",
        help="Do not call fetch-loghub when inputs are missing",
    )
    parser.add_argument(
        "--measure",
        action="store_true",
        help="Record wall time, peak RSS, index size, and time-to-first-result (machine-dependent)",
    )
    parser.add_argument(
        "--measure-only",
        action="store_true",
        help="With --measure on needle datasets, skip the quality scoring and only measure",
    )
    parser.add_argument(
        "--repeat",
        type=int,
        default=None,
        help=f"With --measure, median over N repeats (default {DEFAULT_MEASURE_REPEAT})",
    )
    parser.add_argument(
        "--log-prefix-lines",
        type=int,
        nargs="?",
        const=DEFAULT_LOG_PREFIX_LINES,
        default=None,
        help=(
            f"With --measure, use the first N lines of pinned full Loghub sets "
            f"(default {DEFAULT_LOG_PREFIX_LINES}; published size is {PUBLISHED_LOG_PREFIX_LINES}). "
            "Speed/memory only; no quality labels."
        ),
    )
    parser.add_argument(
        "--xerj-url",
        default=None,
        help="Existing Elasticsearch-compatible xerj URL (localhost only)",
    )
    parser.add_argument(
        "--xerj-bin",
        default=None,
        help="Path to the xerj binary (default: xerj on PATH)",
    )
    parser.add_argument(
        "--xerj-model-dir",
        default=None,
        help="Local all-MiniLM-L6-v2 dir for spawned xerj-neural (no download)",
    )
    parser.add_argument(
        "--opensearch-url",
        default=None,
        help="Existing OpenSearch node URL (localhost only, security off)",
    )
    parser.add_argument(
        "--opensearch-home",
        default=None,
        help="Extracted OpenSearch tarball to spawn (default: $OPENSEARCH_HOME)",
    )
    args = parser.parse_args(argv_list)
    if args.repeat is not None and not args.measure:
        raise SystemExit("error: --repeat requires --measure")
    if args.log_prefix_lines is not None and not args.measure:
        raise SystemExit("error: --log-prefix-lines requires --measure")
    if args.measure and args.xerj_url:
        raise SystemExit("error: --measure requires a spawned xerj (--xerj-bin / PATH); not --xerj-url")
    if args.measure and args.opensearch_url:
        raise SystemExit(
            "error: --measure requires a spawned OpenSearch (--opensearch-home / OPENSEARCH_HOME); "
            "not --opensearch-url"
        )
    if args.log_prefix_lines is not None and args.log_prefix_lines <= 0:
        raise SystemExit("error: --log-prefix-lines must be a positive integer")
    measure_repeats = DEFAULT_MEASURE_REPEAT if args.repeat is None else args.repeat
    if args.measure and measure_repeats <= 0:
        raise SystemExit("error: --repeat must be a positive integer")

    engines = parse_engines(args.engines)
    if is_needle_request(args.dataset):
        run_needles(args, engines, parse_modes(args.modes))
        return
    if args.measure_only:
        raise SystemExit("error: --measure-only applies to needle datasets")
    nesso_only = engines == ["nesso"]
    needs_nesso = "nesso" in engines
    binary: Path | None = None
    model_dir: Path | None = None
    if needs_nesso:
        binary = resolve_binary(args.binary)
        model_dir = resolve_model_dir(args.model_dir)
    if "bm25" in engines:
        require_fts5()
    if "grep" in engines:
        ok, reason = GrepEngine().availability()
        if not ok:
            raise SystemExit(f"error: {reason}")
    if "diy-faiss" in engines:
        diy = load_diy_faiss_module()
        ok, reason = diy.DiyFaissEngine().availability()
        if not ok:
            raise SystemExit(f"error: {reason}")
    modes = parse_modes(args.modes)
    prefix_lines = args.log_prefix_lines
    measure_only = prefix_lines is not None

    opensearch_home: str | None = None
    if OPENSEARCH_ENGINES.intersection(engines) and not args.opensearch_url:
        resolved_home = resolve_opensearch_home(args.opensearch_home)
        opensearch_home = str(resolved_home) if resolved_home is not None else None

    xerj = XerjContext()
    opensearch = OpenSearchContext()
    if not measure_only:
        xerj = open_xerj_context(
            engines=engines,
            xerj_url=args.xerj_url,
            xerj_bin=args.xerj_bin,
            xerj_model_dir=args.xerj_model_dir,
        )
    try:
        if not measure_only:
            opensearch = open_opensearch_context(
                engines=engines,
                opensearch_url=args.opensearch_url,
                opensearch_home=opensearch_home,
            )
        dataset_results: list[dict] = []
        measure_targets: list[tuple[str, Path, list[str]]] = []

        if measure_only:
            full_specs = parse_full_datasets(args.dataset)
            for spec in full_specs:
                log_path = ensure_full_log(spec, lines=prefix_lines, skip_fetch=args.skip_fetch)
                query_texts = load_query_texts(spec.queries_path)
                measure_targets.append((spec.name, log_path, query_texts))
        else:
            dataset_specs = parse_datasets(args.dataset)
            if dataset_specs is None:
                queries = load_queries(args.queries)
                if not args.skip_fetch:
                    ensure_inputs(args.log, args.structured)
                elif not args.log.is_file() or not args.structured.is_file():
                    raise SystemExit("error: --log and --structured must exist when --skip-fetch is set")
                lines = read_log_lines(args.log)
                event_by_line = load_event_ids(args.structured)
                assert_line_id_alignment(args.log, event_by_line, lines)
                validate_relevant_lines(queries, args.log, lines)
                dataset_results.append(
                    evaluate_dataset(
                        binary=binary,
                        model_dir=model_dir,
                        queries=queries,
                        event_by_line=event_by_line,
                        log_path=args.log,
                        lines=lines,
                        modes=modes,
                        engines=engines,
                        workdir=args.workdir,
                        corpus_name="hdfs_2k.nesso",
                        dataset_name="hdfs-2k",
                        xerj=xerj,
                        opensearch=opensearch,
                    )
                )
                measure_targets.append(
                    ("hdfs-2k", args.log, [query.query for query in queries])
                )
            else:
                for spec in dataset_specs:
                    if not args.skip_fetch:
                        ensure_inputs(spec.log_path, spec.structured_path, fetch_dataset=spec.name)
                    elif not spec.log_path.is_file() or not spec.structured_path.is_file():
                        raise SystemExit(
                            f"error: --log and --structured must exist when --skip-fetch is set "
                            f"({spec.log_path}, {spec.structured_path})"
                        )
                    queries = load_queries(spec.queries_path)
                    lines = read_log_lines(spec.log_path)
                    event_by_line = load_event_ids(spec.structured_path)
                    assert_line_id_alignment(spec.log_path, event_by_line, lines)
                    validate_relevant_lines(queries, spec.log_path, lines)
                    dataset_results.append(
                        evaluate_dataset(
                            binary=binary,
                            model_dir=model_dir,
                            queries=queries,
                            event_by_line=event_by_line,
                            log_path=spec.log_path,
                            lines=lines,
                            modes=modes,
                            engines=engines,
                            workdir=args.workdir,
                            corpus_name=spec.corpus_name,
                            dataset_name=spec.name,
                            xerj=xerj,
                            opensearch=opensearch,
                        )
                    )
                    measure_targets.append(
                        (spec.name, spec.log_path, [query.query for query in queries])
                    )

        if measure_only:
            payload = {
                "datasets": [],
                "k": K,
                "overall": None,
                "schema_version": SCHEMA_VERSION_ENGINES if not nesso_only else SCHEMA_VERSION,
            }
        elif nesso_only:
            overall = aggregate_overall(dataset_results, modes)
            payload = {
                "datasets": dataset_results,
                "k": K,
                "overall": overall,
                "schema_version": SCHEMA_VERSION,
            }
        else:
            overall = aggregate_overall_engines(dataset_results, engines)
            payload = {
                "datasets": dataset_results,
                "k": K,
                "overall": overall,
                "schema_version": SCHEMA_VERSION_ENGINES,
            }

        if args.measure:
            measure_datasets = []
            for name, log_path, query_texts in measure_targets:
                measure_datasets.append(
                    measure_dataset(
                        dataset_name=name,
                        log_path=log_path,
                        query_texts=query_texts,
                        engines=engines,
                        modes=modes,
                        workdir=args.workdir / "measure" / name,
                        binary=binary,
                        model_dir=model_dir,
                        xerj_bin=args.xerj_bin,
                        xerj_model_dir=args.xerj_model_dir,
                        repeats=measure_repeats,
                        opensearch_home=opensearch_home,
                    )
                )
            payload["measure"] = {
                "cpuModel": cpu_model(),
                "datasets": measure_datasets,
                "nproc": logical_cpus(),
                "platform": platform.platform(),
                "repeat": measure_repeats,
                "threads": threads_setting(),
                "tool": collect_measure_tool_versions(
                    engines=engines,
                    binary=binary,
                    xerj_bin=args.xerj_bin,
                    opensearch_home=opensearch_home,
                    model_dir=model_dir,
                ),
            }

        encoded = json.dumps(payload, sort_keys=True, separators=(",", ":")) + "\n"
        args.out.parent.mkdir(parents=True, exist_ok=True)
        args.out.write_text(encoded, encoding="utf-8")
        print(format_report_with_measure(payload) if args.measure else format_report(payload))
        print(f"wrote {args.out}")
    finally:
        opensearch.shutdown()
        xerj.shutdown()


if __name__ == "__main__":
    try:
        main()
    except SystemExit as exc:
        code = exc.code
        if isinstance(code, str):
            print(code, file=sys.stderr)
            raise SystemExit(1) from exc
        raise
