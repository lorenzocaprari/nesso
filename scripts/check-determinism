#!/usr/bin/env python3

import argparse
import hashlib
import os
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path


DEFAULT_QUERY = "PAY-E1042"
DEFAULT_RUNS = 10
DEFAULT_TOP_K = 1_000_000
DEFAULT_INPUT_LINES = 3_500
# Pull requests compare two fresh processes. Eight embed batches (the runtime
# window is 32) is two waves on a 4-session int8 pool, so the short corpus
# still crosses a batch boundary and a second pool wave. Main, nightly, and
# the release gate keep DEFAULT_INPUT_LINES and DEFAULT_RUNS.
PR_RUNS = 2
PR_INDEX_RUNS = 2
PR_INPUT_LINES = 256
MODES = ("full", "pr")
# Four queries, not one, so an index that only disagrees on a later ranking
# still fails. PAY-E1042 is the original gate query.
INDEX_QUERIES = (
    "PAY-E1042",
    "connection refused",
    "database connection error",
    "payment timeout",
)
# --cpu-method all exits the only worker (and then stress-ng) when Apéry's
# accuracy check fails or a target_clones method takes SIGILL. The default
# LLC-sized cache mmap can also fail before the first nesso process.
# loop is a one-core integer spin; timeout 0 runs until the gate stops it;
# the cache cap avoids that startup mmap.
DEFAULT_STRESS_COMMAND = "stress-ng --cpu 1 --cpu-method loop --timeout 0 --cache-size 2M"
STRESS_WARMUP_SECONDS = 0.5
STRESS_START_ATTEMPTS = 3


class GateFailure(Exception):
    pass


def command_path(value: str) -> str:
    path = Path(value)
    if path.parent != Path(".") or path.is_absolute():
        if not path.is_file():
            raise argparse.ArgumentTypeError(f"binary does not exist: {value}")
        return str(path)
    resolved = shutil.which(value)
    if resolved is None:
        raise argparse.ArgumentTypeError(f"binary is not on PATH: {value}")
    return resolved


def positive(value: str) -> int:
    parsed = int(value)
    if parsed < 1:
        raise argparse.ArgumentTypeError("must be positive")
    return parsed


def determinism_lines(count: int = DEFAULT_INPUT_LINES) -> list[str]:
    patterns = (
        "PAY-E1042 connection refused",
        "database connection error after {n} retries",
        "payment timeout after {n}s",
        "INFO accepted connection from 10.1.0.{octet} user={n}",
    )
    return [patterns[n % len(patterns)].format(n=n, octet=n % 256) for n in range(count)]


def arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Compare fresh nesso processes under CPU load.")
    parser.add_argument("--binary", default=os.environ.get("NESSO_BINARY", "nesso"))
    parser.add_argument("--model-dir", default=os.environ.get("NESSO_MODEL_DIR"), required=False, type=Path)
    parser.add_argument("--input", type=Path)
    parser.add_argument(
        "--emit-input",
        type=Path,
        help=f"Write a {DEFAULT_INPUT_LINES}-line determinism input and exit",
    )
    parser.add_argument("--query", default=DEFAULT_QUERY)
    parser.add_argument(
        "--mode",
        choices=MODES,
        default=os.environ.get("NESSO_DETERMINISM_MODE", "full"),
        help=(
            "full: 10 runs and a 3500-line --emit-input (index runs only when --index-runs is set). "
            f"pr: {PR_RUNS} runs, {PR_INDEX_RUNS} index runs, and a {PR_INPUT_LINES}-line --emit-input. "
            "NESSO_DETERMINISM_MODE sets the default"
        ),
    )
    parser.add_argument("--runs", default=None, type=positive)
    parser.add_argument(
        "--index-runs",
        type=positive,
        help="Index this many times and compare corpus bytes plus rankings for four queries",
    )
    parser.add_argument("--top-k", default=DEFAULT_TOP_K, type=positive)
    parser.add_argument(
        "--stress-command",
        default=os.environ.get("NESSO_STRESS_COMMAND", DEFAULT_STRESS_COMMAND),
        help=f"Command to run while the gate executes; default: {DEFAULT_STRESS_COMMAND}",
    )
    parsed = parser.parse_args()
    if parsed.mode not in MODES:
        parser.error(f"--mode must be full or pr, got {parsed.mode}")
    if parsed.runs is None:
        parsed.runs = PR_RUNS if parsed.mode == "pr" else DEFAULT_RUNS
    if parsed.mode == "pr" and parsed.index_runs is None:
        parsed.index_runs = PR_INDEX_RUNS
    if parsed.emit_input is not None:
        return parsed
    try:
        parsed.binary = command_path(parsed.binary)
    except argparse.ArgumentTypeError as error:
        parser.error(str(error))
    if parsed.model_dir is None:
        parser.error("--model-dir or NESSO_MODEL_DIR is required")
    if not parsed.model_dir.is_dir():
        parser.error(f"model directory does not exist: {parsed.model_dir}")
    if parsed.input is None:
        parser.error("--input is required")
    if not parsed.input.is_file():
        parser.error(f"input does not exist: {parsed.input}")
    if parsed.runs < 2:
        parser.error("--runs must be at least 2")
    if parsed.index_runs is not None and parsed.index_runs < 2:
        parser.error("--index-runs must be at least 2")
    return parsed


def input_line_count(mode: str) -> int:
    if mode == "pr":
        return PR_INPUT_LINES
    return DEFAULT_INPUT_LINES


def digest(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()[:16]


def run_process(command: list[str], name: str) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(command, capture_output=True, text=True, check=False)
    if result.returncode != 0:
        details = result.stderr.strip() or result.stdout.strip() or "no output"
        raise GateFailure(f"{name} failed with exit {result.returncode}: {details}")
    return result


def start_stress(command: str) -> tuple[subprocess.Popen[bytes], Path]:
    parts = shlex.split(command)
    if not parts:
        raise GateFailure("stress command is empty")
    if shutil.which(parts[0]) is None:
        raise GateFailure(f"stress command is not available: {parts[0]}")
    fd, name = tempfile.mkstemp(prefix="nesso-stress-", suffix=".log")
    os.close(fd)
    stderr_path = Path(name)
    stderr_file = stderr_path.open("wb")
    try:
        # stress-ng reports mmap and worker failures on stdout.
        process = subprocess.Popen(parts, stdout=stderr_file, stderr=subprocess.STDOUT)
    except Exception:
        stderr_file.close()
        stderr_path.unlink(missing_ok=True)
        raise
    stderr_file.close()
    return process, stderr_path


def stress_exit_message(process: subprocess.Popen[bytes], stderr_path: Path) -> str:
    code = process.poll()
    status = f"signal {-code}" if code is not None and code < 0 else f"exit {code}"
    try:
        text = stderr_path.read_text(errors="replace")
    except OSError:
        text = ""
    lines = [line.strip() for line in text.splitlines() if line.strip()]
    tail = " | ".join(lines[-8:])
    if tail:
        return f"stress command exited before the gate completed ({status}): {tail}"
    return f"stress command exited before the gate completed ({status})"


def stop_stress(process: subprocess.Popen[bytes]) -> None:
    if process.poll() is None:
        process.terminate()
        try:
            process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()


def alive_after_warmup(process: subprocess.Popen[bytes]) -> bool:
    deadline = time.monotonic() + STRESS_WARMUP_SECONDS
    while True:
        if process.poll() is not None:
            return False
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return True
        time.sleep(min(0.05, remaining))


def ensure_stress(command: str) -> tuple[subprocess.Popen[bytes], Path]:
    last = "stress command exited before the gate completed"
    for _ in range(STRESS_START_ATTEMPTS):
        process, stderr_path = start_stress(command)
        if alive_after_warmup(process):
            return process, stderr_path
        last = stress_exit_message(process, stderr_path)
        stderr_path.unlink(missing_ok=True)
    raise GateFailure(last)


def refresh_stress(
    process: subprocess.Popen[bytes],
    stderr_path: Path,
    command: str,
) -> tuple[subprocess.Popen[bytes], Path]:
    if process.poll() is None:
        return process, stderr_path
    previous = stderr_path
    process, stderr_path = ensure_stress(command)
    previous.unlink(missing_ok=True)
    return process, stderr_path


def index_corpus(options: argparse.Namespace, corpus: Path, name: str) -> bytes:
    run_process(
        [
            options.binary,
            "index",
            "-o",
            str(corpus),
            "--model-dir",
            str(options.model_dir),
            str(options.input),
        ],
        name,
    )
    return corpus.read_bytes()


def search_corpus(options: argparse.Namespace, corpus: Path, query: str, name: str) -> str:
    return run_process(
        [
            options.binary,
            "search",
            query,
            "-i",
            str(corpus),
            "-k",
            str(options.top_k),
            "--model-dir",
            str(options.model_dir),
        ],
        name,
    ).stdout


def check_determinism(options: argparse.Namespace) -> None:
    stress, stderr_path = ensure_stress(options.stress_command)
    try:
        with tempfile.TemporaryDirectory(prefix="nesso-determinism-") as temp:
            output_dir = Path(temp)
            baseline_corpus: bytes | None = None
            baseline_ranking: str | None = None
            for run in range(options.runs):
                stress, stderr_path = refresh_stress(stress, stderr_path, options.stress_command)
                corpus = output_dir / f"corpus-{run}.nesso"
                corpus_bytes = index_corpus(options, corpus, f"index run {run + 1}")
                stress, stderr_path = refresh_stress(stress, stderr_path, options.stress_command)
                ranking = search_corpus(options, corpus, options.query, f"search run {run + 1}")

                if baseline_corpus is None:
                    baseline_corpus = corpus_bytes
                    baseline_ranking = ranking
                    continue
                if corpus_bytes != baseline_corpus:
                    raise GateFailure(
                        f"corpus differs on run {run + 1}: {digest(corpus_bytes)} != {digest(baseline_corpus)}"
                    )
                if ranking != baseline_ranking:
                    raise GateFailure(f"ranking differs on run {run + 1}")

            if options.index_runs is not None:
                indexed_corpus: bytes | None = None
                indexed_rankings: dict[str, str] | None = None
                for run in range(options.index_runs):
                    stress, stderr_path = refresh_stress(stress, stderr_path, options.stress_command)
                    corpus = output_dir / f"index-run-{run}.nesso"
                    corpus_bytes = index_corpus(options, corpus, f"index-run {run + 1}")
                    rankings: dict[str, str] = {}
                    for query in INDEX_QUERIES:
                        stress, stderr_path = refresh_stress(stress, stderr_path, options.stress_command)
                        rankings[query] = search_corpus(
                            options,
                            corpus,
                            query,
                            f"index-run {run + 1} query {query}",
                        )
                    if indexed_corpus is None:
                        indexed_corpus = corpus_bytes
                        indexed_rankings = rankings
                        continue
                    if corpus_bytes != indexed_corpus:
                        raise GateFailure(
                            f"corpus differs on index run {run + 1}: "
                            f"{digest(corpus_bytes)} != {digest(indexed_corpus)}"
                        )
                    assert indexed_rankings is not None
                    for query, ranking in rankings.items():
                        if ranking != indexed_rankings[query]:
                            raise GateFailure(f"ranking for {query!r} differs on index run {run + 1}")
    finally:
        stop_stress(stress)
        stderr_path.unlink(missing_ok=True)
    message = f"determinism OK ({options.mode}): {options.runs} runs, corpus and rankings identical"
    if options.index_runs is not None:
        message += f"; index-runs {options.index_runs}, {len(INDEX_QUERIES)} queries identical"
    print(message)


def main() -> int:
    options = arguments()
    if options.emit_input is not None:
        options.emit_input.write_text(
            "".join(f"{line}\n" for line in determinism_lines(input_line_count(options.mode)))
        )
        return 0
    try:
        check_determinism(options)
    except GateFailure as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
