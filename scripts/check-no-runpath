#!/usr/bin/env python3
"""Fail when an ELF binary carries a DT_RPATH or DT_RUNPATH entry.

Every host dependency of the release binary is linked statically, so it
needs no library search path. A search path baked into the binary is a
hijack risk: the dynamic loader treats an empty entry (a leading, trailing,
or doubled ':') as the current working directory, and build-tree paths
point at directories that do not exist, or that someone else can create,
on the target host.

Usage: check-no-runpath BINARY. Exit 0 when the dynamic section has neither
tag, 1 when it has one, 2 on a usage or readelf error. READELF overrides the
readelf command.
"""

import os
import re
import subprocess
import sys

TAG = re.compile(r"\((RPATH|RUNPATH)\)\s+Library (?:rpath|runpath): \[(.*)\]\s*$")


def search_paths(binary: str) -> list[tuple[str, str]]:
    readelf = os.environ.get("READELF", "readelf")
    result = subprocess.run([readelf, "-d", binary], capture_output=True, text=True, check=False)
    if result.returncode != 0:
        raise OSError(result.stderr.strip() or f"{readelf} -d failed")
    found = []
    for line in result.stdout.splitlines():
        match = TAG.search(line)
        if match:
            found.append((match.group(1), match.group(2)))
        elif "(RPATH)" in line or "(RUNPATH)" in line:
            found.append(("RUNPATH" if "(RUNPATH)" in line else "RPATH", line.strip()))
    return found


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        print("usage: check-no-runpath BINARY", file=sys.stderr)
        return 2
    try:
        found = search_paths(argv[1])
    except OSError as error:
        print(f"error: {error}", file=sys.stderr)
        return 2
    for tag, value in found:
        empty = value.split(":").count("") if value else 1
        note = f" ({empty} empty entry, searched as the current directory)" if empty else ""
        print(f"error: {argv[1]} has {tag} [{value}]{note}", file=sys.stderr)
    return 1 if found else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
