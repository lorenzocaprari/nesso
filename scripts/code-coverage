#!/usr/bin/env bash
set -euo pipefail

REQUIRED_LINES=96.9
REQUIRED_FUNCTIONS=96.4
REQUIRED_BRANCHES=44.5

cd "$(dirname "${BASH_SOURCE[0]}")/.."

conan profile detect --force
conan build . -of build/coverage -pr:h "${1:-conan/profiles/code-coverage}" -pr:b default --build=missing

lcov() { command lcov --rc branch_coverage=1 --ignore-errors inconsistent,mismatch "$@" >/dev/null; }
lcov --directory build/coverage/build/Debug --capture --output-file build/coverage/coverage.info
lcov --remove build/coverage/coverage.info '/usr/*' "${HOME}/.conan2/*" --output-file build/coverage/coverage.cleaned
genhtml --branch-coverage --rc branch_coverage=1 build/coverage/coverage.cleaned --output-directory build/coverage/report >/dev/null

summary=$(command lcov --rc branch_coverage=1 --summary build/coverage/coverage.cleaned 2>&1)
pct() { echo "$summary" | grep -E "^[[:space:]]+${1}\\.+" | awk -F: '{print $2}' | awk '{print $1}' | tr -d '%'; }

fail=0
check() {
  local measured
  measured=$(pct "$1")
  measured=${measured:-0}
  echo "$1: ${measured}% (required $2%)"
  [[ "$measured" == "$2" ]] || { echo "ERROR: $1 mismatch" >&2; fail=1; }
}

check lines "$REQUIRED_LINES"
check functions "$REQUIRED_FUNCTIONS"
check branches "$REQUIRED_BRANCHES"
[[ $fail -eq 0 ]] || exit 2

echo "Coverage OK"
