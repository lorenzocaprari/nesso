#!/usr/bin/env python3
"""Run deterministic benchmarks and write JSON under bench/results/.

Without --dataset, time grep on fixed-seed synthetic logs. --dataset hdfs
indexes the Loghub HDFS sample and writes bench/results/<sha>.hdfs.json.
--dataset logdir generates a synthetic log directory, times a cold index and
the first search, and writes bench/results/<sha>.logdir.json. nesso index
reads regular files, so logdir passes each file on its own.
"""

import argparse
import json
import os
import random
import re
import signal
import subprocess
import sys
import tempfile
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
DEFAULT_SIZES = (1000, 10_000, 100_000)
HDFS_DEFAULT_LINES = 100_000
LOGDIR_DEFAULT_LINES = 256
LOGDIR_QUERY = "disk write failed"
LOGDIR_NOISE_DIVISOR = 5
QUERY = "database connection refused"
INDEXED_CHUNKS = re.compile(r"Indexed (\d+) chunks")
MONTHS = ("Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec")
HOSTS = ("edge-01", "edge-02", "store-01", "batch-01")
LOG_SPECS = (
    ("var/log/messages", "messages", 24),
    ("var/log/messages.1", "messages", 10),
    ("var/log/messages.2", "messages", 6),
    ("var/log/secure", "secure", 8),
    ("var/log/kern.log", "kern", 8),
    ("var/log/dmesg", "dmesg", 6),
    ("var/log/boot.log", "boot", 4),
    ("var/log/cron", "cron", 5),
    ("var/log/pkg.log", "pkg", 6),
    ("var/log/app/service.jsonl", "jsonl", 14),
    ("sos_commands/logs/journalctl_--no-pager", "journal", 18),
)
NOISE_FILES = (
    ("etc/hostname", "edge-01"),
    ("proc/cpuinfo", "processor: 0"),
    ("sys/class/net/eth0/address", "02:00:00:00:00:01"),
    ("etc/hosts", "127.0.0.1 localhost edge-01"),
    ("proc/meminfo", "MemTotal: 16384000 kB"),
    ("sys/class/net/eth0/mtu", "1500"),
    ("etc/resolv.conf", "nameserver 10.0.0.2"),
    ("proc/uptime", "12345.67 8901.23"),
    ("sys/class/net/eth0/operstate", "up"),
    ("etc/os-release", 'PRETTY_NAME="Synthetic OS"'),
    ("proc/loadavg", "0.10 0.20 0.30 1/100 1234"),
    ("sys/devices/system/cpu/online", "0-3"),
    ("etc/nsswitch.conf", "hosts: files dns"),
    ("proc/version", "Linux version synthetic"),
    ("sys/devices/system/cpu/possible", "0-3"),
    ("etc/fstab", "/dev/sda1 / ext4 defaults 0 1"),
    ("proc/mounts", "/dev/sda1 / ext4 rw 0 0"),
    ("sys/kernel/hostname", "edge-01"),
    ("etc/passwd", "svc:x:1000:1000:Service:/home/svc:/bin/false"),
    ("proc/stat", "cpu 10 20 30 40"),
    ("sys/module/synthetic/parameters/debug", "0"),
    ("etc/group", "svc:x:1000:"),
    ("proc/diskstats", "8 0 sda 1 2 3 4"),
    ("sys/class/net/eth0/speed", "1000"),
    ("etc/ssh/sshd_config", "Port 22"),
    ("proc/net/dev", "eth0: 100 10 0 0 0 0 0 0 200 20 0 0 0 0 0 0"),
    ("sys/class/net/eth0/duplex", "full"),
    ("etc/sysctl.d/99-synthetic.conf", "net.ipv4.ip_forward = 0"),
    ("etc/app/conf.d/00-base.conf", "listener 8080"),
    ("etc/app/conf.d/10-listener.conf", "workers 4"),
    ("etc/app/conf.d/20-worker.conf", "queue 128"),
    ("etc/app/conf.d/30-limits.conf", "nofile 1024"),
    ("etc/app/conf.d/40-rotate.conf", "keep 2"),
    ("etc/cron.d/synthetic-job", "*/5 * * * * svc /usr/bin/synthetic-job"),
    ("etc/logrotate.d/app", "/var/log/app/service.jsonl { rotate 2 }"),
    ("etc/profile.d/app.sh", "PATH=/usr/bin"),
)
SEED = 0x4E455353
TEMPLATES = (
    "database connection refused",
    "database connection refused to primary",
    "payment timeout waiting for gateway",
    "auth failure for user",
    "cache miss while loading session",
    "disk full while writing checkpoint",
    "tls handshake failed with upstream",
    "query cancelled after deadline",
)
# grep records parse, then the query embedding, then the batched embed flush.
# Ranking happens inside that flush, so the trace has no separate rank stage.
TRACE_STAGES = ("parse", "query-embed", "embed")


def git_sha() -> str:
    # Actions deletes checkout's temporary safe.directory before later steps, so
    # git rev-parse exits 128 in the container and this script never writes results.
    sha = os.environ.get("GITHUB_SHA", "").strip()
    if sha:
        return sha
    return subprocess.check_output(
        ["git", "-c", "safe.directory=*", "-C", str(ROOT), "rev-parse", "HEAD"],
        text=True,
    ).strip()


def resolve_binary(explicit: str | None) -> Path:
    if explicit:
        return Path(explicit)
    env = os.environ.get("NESSO_BINARY")
    if env:
        return Path(env)
    for relative in ("build/Release/src/nesso", "build/Release/nesso", "build/Debug/src/nesso", "build/Debug/nesso"):
        candidate = ROOT / relative
        if candidate.is_file():
            return candidate
    raise SystemExit("error: nesso binary not found; pass --binary or set NESSO_BINARY")


def resolve_model_dir(explicit: str | None) -> Path:
    if explicit:
        return Path(explicit)
    env = os.environ.get("NESSO_MODEL_DIR")
    if env:
        return Path(env)
    return ROOT / "models"


# scripts/ci bench-scale greps this many lines at 1 thread and at 4. A numeric
# id masks to one token, so that file collapses to a handful of embeddings and
# four sessions are slower than one. A letter id keeps each non-query line
# distinct, which is the workload that check was measured on.
SCALE_LINES = 4000


def letter_token(ordinal: int) -> str:
    chars = []
    value = ordinal
    while True:
        chars.append(chr(ord("a") + (value % 26)))
        value //= 26
        if value == 0:
            break
    return "w" + "".join(reversed(chars))


def write_log(path: Path, lines: int) -> None:
    rng = random.Random(SEED)
    distinct = lines == SCALE_LINES
    with path.open("w", encoding="utf-8") as handle:
        for ordinal in range(lines):
            choice = rng.randrange(len(TEMPLATES))
            force_query = rng.randrange(10) == 0
            identifier = rng.randrange(1_000_000)
            if force_query:
                text = QUERY
            elif distinct:
                text = f"{TEMPLATES[choice]} id-{letter_token(ordinal)}"
            else:
                text = f"{TEMPLATES[choice]} id={identifier}"
            handle.write(text + "\n")


def parse_trace(stderr: str) -> dict | None:
    found = None
    for line in stderr.splitlines():
        stripped = line.strip()
        if not stripped.startswith("{"):
            continue
        try:
            obj = json.loads(stripped)
        except json.JSONDecodeError:
            continue
        if isinstance(obj, dict) and "peakRssBytes" in obj and "stages" in obj:
            found = obj
    return found


def trace_ok(trace: dict | None) -> bool:
    if trace is None:
        return False
    names = [stage.get("name") for stage in trace.get("stages", [])]
    return names == list(TRACE_STAGES)


def address_limit_bytes() -> int | None:
    raw = os.environ.get("NESSO_BENCH_AS_LIMIT_KB")
    if not raw:
        return None
    return int(raw) * 1024


def with_address_limit(command: list[str]) -> list[str]:
    limit = address_limit_bytes()
    if limit is None:
        return command
    if not Path("/usr/bin/prlimit").is_file():
        raise SystemExit("error: /usr/bin/prlimit is required when NESSO_BENCH_AS_LIMIT_KB is set")
    return ["prlimit", f"--as={limit}", *command]


def read_gnu_time(time_path: Path) -> tuple[float | None, int | None]:
    if not time_path.is_file():
        return None, None
    for line in reversed(time_path.read_text(encoding="utf-8", errors="replace").splitlines()):
        parts = line.split()
        if len(parts) < 2:
            continue
        try:
            return float(parts[0]), int(parts[1]) * 1024
        except ValueError:
            continue
    return None, None


def repeat_lines(source: Path, dest: Path, count: int) -> tuple[int, int]:
    if count <= 0:
        raise SystemExit("error: --lines must be a positive integer")
    lines = source.read_text(encoding="utf-8").splitlines()
    if not lines:
        raise SystemExit(f"error: {source} has no lines")
    with dest.open("w", encoding="utf-8", newline="\n") as handle:
        for index in range(count):
            handle.write(lines[index % len(lines)])
            handle.write("\n")
    size = dest.stat().st_size
    return count, size


def parse_cpu_model(text: str) -> str:
    for line in text.splitlines():
        if line.lower().startswith("model name"):
            return line.split(":", 1)[1].strip()
    return "unknown"


def cpu_model() -> str:
    path = Path("/proc/cpuinfo")
    if not path.is_file():
        return "unknown"
    return parse_cpu_model(path.read_text(encoding="utf-8", errors="replace"))


def logical_cpus() -> int:
    try:
        return int(subprocess.check_output(["nproc"], text=True).strip())
    except (OSError, subprocess.CalledProcessError, ValueError) as exc:
        raise SystemExit(f"error: nproc failed: {exc}") from exc


def gnu_time_binary() -> str:
    # The arm64 test image has no GNU time. Tests point this at a stand-in.
    return os.environ.get("NESSO_BENCH_TIME", "/usr/bin/time")


def threads_setting() -> str | None:
    value = os.environ.get("NESSO_THREADS")
    if value is None or value == "":
        return None
    return value


def hdfs_measurement(
    *,
    lines: int,
    wall_seconds: float,
    peak_rss_bytes: int | None,
    input_bytes: int,
    corpus_bytes: int | None,
    exit_code: int | None,
    ok: bool,
    error: str | None = None,
) -> dict:
    wall = round(wall_seconds, 6)
    per_second = round(lines / wall, 6) if wall > 0 else None
    ratio = None
    if corpus_bytes is not None and input_bytes > 0:
        ratio = round(corpus_bytes / input_bytes, 6)
    case = {
        "lines": lines,
        "ok": ok,
        "exitCode": exit_code,
        "wallSeconds": wall,
        "peakRssBytes": peak_rss_bytes,
        "linesPerSecond": per_second,
        "inputBytes": input_bytes,
        "corpusBytes": corpus_bytes,
        "corpusToInputRatio": ratio,
    }
    if error is not None:
        case["error"] = error
    return case


def grep_payload(*, sha: str, binary: Path, query: str, cpu: str, nproc: int, threads: str | None, cases: list) -> dict:
    return {
        "sha": sha,
        "binary": str(binary),
        "query": query,
        "cpuModel": cpu,
        "nproc": nproc,
        "threads": threads,
        "cases": cases,
    }


def hdfs_payload(*, sha: str, binary: Path, cpu: str, nproc: int, threads: str | None, case: dict) -> dict:
    return {
        "sha": sha,
        "binary": str(binary),
        "dataset": "hdfs",
        "cpuModel": cpu,
        "nproc": nproc,
        "threads": threads,
        "cases": [case],
    }


def run_case(binary: Path, model_dir: Path, lines: int, timeout: float | None) -> dict:
    with tempfile.TemporaryDirectory(prefix="nesso-bench-") as tmp:
        log_path = Path(tmp) / "corpus.log"
        write_log(log_path, lines)
        time_path = Path(tmp) / "time.txt"
        env = os.environ.copy()
        env["NESSO_TRACE"] = "1"
        command = [
            "/usr/bin/time",
            "-f",
            "%e %M",
            "-o",
            str(time_path),
            str(binary),
            "grep",
            QUERY,
            str(log_path),
            "--model-dir",
            str(model_dir),
            "-k",
            "5",
        ]
        command = with_address_limit(command)
        started = time.perf_counter()
        process = subprocess.Popen(
            command,
            env=env,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            start_new_session=True,
        )
        try:
            stdout, stderr_bytes = process.communicate(timeout=timeout)
        except subprocess.TimeoutExpired:
            os.killpg(process.pid, signal.SIGKILL)
            process.communicate()
            return {
                "lines": lines,
                "ok": False,
                "exitCode": None,
                "wallSeconds": round(time.perf_counter() - started, 6),
                "peakRssBytes": None,
                "error": f"timed out after {timeout}s",
            }
        wall_seconds = time.perf_counter() - started
        stderr = stderr_bytes.decode("utf-8", "replace")
        timed_wall, peak_rss_bytes = read_gnu_time(time_path)
        if timed_wall is not None:
            wall_seconds = timed_wall
        trace = parse_trace(stderr)
        return_code = process.returncode
        ok = return_code == 0 and trace_ok(trace) and peak_rss_bytes is not None and bool(stdout)
        case = {
            "lines": lines,
            "ok": ok,
            "exitCode": return_code,
            "wallSeconds": round(wall_seconds, 6),
            "peakRssBytes": peak_rss_bytes,
            "trace": trace,
        }
        if not ok:
            if "Failed to allocate memory" in stderr:
                case["error"] = "embedder failed to allocate"
            elif return_code is not None and return_code < 0:
                case["error"] = f"killed by signal {-return_code}"
            elif return_code is not None and return_code > 128:
                case["error"] = f"killed by signal {return_code - 128}"
            elif return_code not in (0, None):
                case["error"] = f"nesso exited {return_code}"
            elif not trace_ok(trace):
                case["error"] = f"missing {'/'.join(TRACE_STAGES)} trace"
            elif not stdout:
                case["error"] = "no matches on stdout"
            else:
                case["error"] = "missing peak RSS"
        return case


def index_failure(return_code: int | None, stderr: str, peak_rss_bytes: int | None, corpus: Path) -> str | None:
    if return_code == 0 and peak_rss_bytes is not None and corpus.is_file() and corpus.stat().st_size > 0:
        return None
    if "Failed to allocate memory" in stderr:
        return "embedder failed to allocate"
    if return_code is not None and return_code < 0:
        return f"killed by signal {-return_code}"
    if return_code is not None and return_code > 128:
        return f"killed by signal {return_code - 128}"
    if return_code not in (0, None):
        return f"nesso exited {return_code}"
    if not corpus.is_file() or corpus.stat().st_size == 0:
        return "missing corpus"
    return "missing peak RSS"


def ensure_hdfs_sample(explicit: Path | None) -> Path:
    if explicit is not None:
        if not explicit.is_file():
            raise SystemExit(f"error: sample not found: {explicit}")
        return explicit
    script = Path(__file__).resolve().parent / "fetch-loghub"
    completed = subprocess.run([sys.executable, str(script)], check=False)
    if completed.returncode != 0:
        raise SystemExit(completed.returncode)
    dest = ROOT / "build" / "bench" / "HDFS_2k.log"
    if not dest.is_file():
        raise SystemExit(f"error: fetch-loghub did not write {dest}")
    return dest


def run_hdfs_index(binary: Path, model_dir: Path, sample: Path, lines: int, timeout: float | None) -> dict:
    with tempfile.TemporaryDirectory(prefix="nesso-bench-hdfs-") as tmp:
        directory = Path(tmp)
        log_path = directory / "hdfs.log"
        _, input_bytes = repeat_lines(sample, log_path, lines)
        corpus = directory / "corpus.nesso"
        time_path = directory / "time.txt"
        command = with_address_limit(
            [
                gnu_time_binary(),
                "-f",
                "%e %M",
                "-o",
                str(time_path),
                str(binary),
                "index",
                "-o",
                str(corpus),
                str(log_path),
                "--model-dir",
                str(model_dir),
                "--quiet",
            ]
        )
        started = time.perf_counter()
        process = subprocess.Popen(
            command,
            env=os.environ.copy(),
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            start_new_session=True,
        )
        try:
            _stdout, stderr_bytes = process.communicate(timeout=timeout)
        except subprocess.TimeoutExpired:
            os.killpg(process.pid, signal.SIGKILL)
            process.communicate()
            return hdfs_measurement(
                lines=lines,
                wall_seconds=time.perf_counter() - started,
                peak_rss_bytes=None,
                input_bytes=input_bytes,
                corpus_bytes=None,
                exit_code=None,
                ok=False,
                error=f"timed out after {timeout}s",
            )
        wall_seconds = time.perf_counter() - started
        stderr = stderr_bytes.decode("utf-8", "replace")
        timed_wall, peak_rss_bytes = read_gnu_time(time_path)
        if timed_wall is not None:
            wall_seconds = timed_wall
        corpus_bytes = corpus.stat().st_size if corpus.is_file() else None
        error = index_failure(process.returncode, stderr, peak_rss_bytes, corpus)
        return hdfs_measurement(
            lines=lines,
            wall_seconds=wall_seconds,
            peak_rss_bytes=peak_rss_bytes,
            input_bytes=input_bytes,
            corpus_bytes=corpus_bytes,
            exit_code=process.returncode,
            ok=error is None,
            error=error,
        )


def run_hdfs(args: argparse.Namespace) -> None:
    if args.sizes is not None:
        raise SystemExit("error: --sizes applies to the synthetic grep benchmark")
    lines = HDFS_DEFAULT_LINES if args.lines is None else args.lines
    if lines <= 0:
        raise SystemExit("error: --lines must be a positive integer")
    binary = resolve_binary(args.binary)
    if not binary.is_file():
        raise SystemExit(f"error: binary not found: {binary}")
    model_dir = resolve_model_dir(args.model_dir)
    if not (model_dir / "model.onnx").is_file() or not (model_dir / "vocab.txt").is_file():
        raise SystemExit(f"error: {model_dir} must contain model.onnx and vocab.txt")
    time_bin = gnu_time_binary()
    if not Path(time_bin).is_file():
        raise SystemExit(f"error: {time_bin} is required")
    sample = ensure_hdfs_sample(args.sample)
    print(f"bench: hdfs index {lines} lines", flush=True)
    case = run_hdfs_index(binary, model_dir, sample, lines, args.timeout)
    status = "ok" if case["ok"] else case.get("error", "failed")
    print(
        f"bench: {lines} lines {status} wall={case['wallSeconds']}s "
        f"lines/s={case['linesPerSecond']} peak={case['peakRssBytes']} "
        f"corpusBytes={case['corpusBytes']} inputBytes={case['inputBytes']} "
        f"ratio={case['corpusToInputRatio']}",
        flush=True,
    )
    cpu = cpu_model()
    count = logical_cpus()
    threads = threads_setting()
    shown_threads = threads if threads is not None else "unset"
    print(f"bench: cpu={cpu} nproc={count} NESSO_THREADS={shown_threads}", flush=True)
    payload = hdfs_payload(
        sha=git_sha(),
        binary=binary,
        cpu=cpu,
        nproc=count,
        threads=threads,
        case=case,
    )
    output = args.output or (ROOT / "bench" / "results" / f"{payload['sha']}.hdfs.json")
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
    print(f"bench: wrote {output}")
    if not case.get("ok"):
        raise SystemExit(1)


def syslog_stamp(rng: random.Random) -> str:
    month = MONTHS[rng.randrange(len(MONTHS))]
    day = rng.randint(1, 28)
    hour = rng.randint(0, 23)
    minute = rng.randint(0, 59)
    second = rng.randint(0, 59)
    return f"{month} {day:2d} {hour:02d}:{minute:02d}:{second:02d}"


def pick_host(rng: random.Random) -> str:
    return HOSTS[rng.randrange(len(HOSTS))]


def pick_pid(rng: random.Random) -> int:
    return rng.randint(200, 65000)


def pick_ip(rng: random.Random) -> str:
    return f"10.{rng.randint(0, 255)}.{rng.randint(0, 255)}.{rng.randint(1, 254)}"


def message_text(rng: random.Random, *, query: bool) -> str:
    if query:
        return f"{LOGDIR_QUERY} on volume vol-{rng.randint(1, 48)}"
    choice = rng.randrange(5)
    if choice == 0:
        return f"accepted connection from {pick_ip(rng)}"
    if choice == 1:
        return f"session opened for user svc{rng.randint(1, 40)}"
    if choice == 2:
        return f"checkpoint written for block blk-{rng.randint(0, 65535):04x}"
    if choice == 3:
        return f"worker idle after {rng.randint(1, 900)} ms"
    return f"certificate reloaded for listener {rng.randint(1, 12)}"


def bracket_time(rng: random.Random, whole_max: int) -> str:
    return f"{rng.randint(0, whole_max):5d}.{rng.randint(0, 999999):06d}"


def render_log_line(kind: str, ordinal: int, rng: random.Random) -> str:
    if kind == "messages":
        if ordinal == 0:
            program = "app"
            text = message_text(rng, query=True)
        else:
            program = ("app", "systemd")[rng.randrange(2)]
            text = message_text(rng, query=rng.randrange(17) == 0)
        return f"{syslog_stamp(rng)} {pick_host(rng)} {program}[{pick_pid(rng)}]: {text}"
    if kind == "journal":
        text = message_text(rng, query=rng.randrange(17) == 0)
        return f"{syslog_stamp(rng)} {pick_host(rng)} app[{pick_pid(rng)}]: {text}"
    if kind == "jsonl":
        text = message_text(rng, query=rng.randrange(17) == 0)
        payload = {
            "time": syslog_stamp(rng),
            "host": pick_host(rng),
            "pid": pick_pid(rng),
            "message": text,
        }
        return json.dumps(payload, separators=(",", ":"))
    if kind == "secure":
        action = ("Failed password", "Accepted publickey")[rng.randrange(2)]
        user = rng.randint(1, 40)
        return (
            f"{syslog_stamp(rng)} {pick_host(rng)} sshd[{pick_pid(rng)}]: "
            f"{action} for svc{user} from {pick_ip(rng)} port {rng.randint(1024, 65000)} ssh2"
        )
    if kind == "kern":
        letter = "abcd"[rng.randrange(4)]
        return (
            f"{syslog_stamp(rng)} {pick_host(rng)} kernel: [{bracket_time(rng, 99999)}] "
            f"block blk-{rng.randint(0, 65535):04x}: I/O error on dev sd{letter} "
            f"sector {rng.randint(1, 50_000_000)}"
        )
    if kind == "dmesg":
        return (
            f"[{bracket_time(rng, 40)}] block blk-{rng.randint(0, 65535):04x}: "
            f"device ready sector {rng.randint(1, 50_000_000)}"
        )
    if kind == "boot":
        return f"[  OK  ] Started synthetic unit worker-{rng.randint(1, 20)}.service"
    if kind == "cron":
        user = rng.randint(1, 40)
        return (
            f"{syslog_stamp(rng)} {pick_host(rng)} CROND[{pick_pid(rng)}]: "
            f"(svc{user}) CMD (/usr/bin/synthetic-job {user})"
        )
    if kind == "pkg":
        number = rng.randint(1, 80)
        return (
            f"{syslog_stamp(rng)} {pick_host(rng)} pkgman[{pick_pid(rng)}]: "
            f"installed synthetic-pkg-{number} 1.{rng.randint(0, 20)}.{rng.randint(0, 30)}"
        )
    raise SystemExit(f"error: unknown log kind {kind}")


def logdir_budget(total: int) -> tuple[int, int]:
    if total <= 0:
        raise SystemExit("error: --lines must be a positive integer")
    if total < len(LOG_SPECS):
        raise SystemExit(f"error: --lines must be at least {len(LOG_SPECS)} to fill the log directory")
    noise = min(len(NOISE_FILES), total // LOGDIR_NOISE_DIVISOR)
    if total - noise < len(LOG_SPECS):
        noise = total - len(LOG_SPECS)
    return total - noise, noise


def distribute_counts(total: int, weights: list[int]) -> list[int]:
    count = len(weights)
    if total < count:
        raise SystemExit("error: --lines must be a positive integer")
    extra = total - count
    weight_sum = sum(weights)
    scaled = [extra * weight for weight in weights]
    counts = [value // weight_sum for value in scaled]
    remainders = [value % weight_sum for value in scaled]
    leftover = extra - sum(counts)
    order = sorted(
        range(count),
        key=lambda index: (remainders[index], weights[index]),
        reverse=True,
    )
    for index in range(leftover):
        counts[order[index]] += 1
    return [1 + value for value in counts]


def logdir_records(line_count: int, seed: int) -> list[tuple[str, str]]:
    log_lines, noise_lines = logdir_budget(line_count)
    counts = distribute_counts(log_lines, [spec[2] for spec in LOG_SPECS])
    rng = random.Random(seed)
    records: list[tuple[str, str]] = []
    for spec, count in zip(LOG_SPECS, counts, strict=True):
        path, kind, _weight = spec
        for ordinal in range(count):
            records.append((path, render_log_line(kind, ordinal, rng)))
    for path, text in NOISE_FILES[:noise_lines]:
        records.append((path, text))
    return records


def logdir_input_bytes(line_count: int, seed: int) -> int:
    return sum(len(line.encode("utf-8")) + 1 for _path, line in logdir_records(line_count, seed))


def lines_for_mib(mib: float, seed: int) -> int:
    if mib <= 0:
        raise SystemExit("error: --mib must be positive")
    size_bytes = round(mib * 1024 * 1024)
    if size_bytes < 1:
        raise SystemExit("error: --mib must be positive")
    minimum = len(LOG_SPECS)
    minimum_bytes = logdir_input_bytes(minimum, seed)
    if minimum_bytes > size_bytes:
        raise SystemExit(f"error: --mib is below the log directory minimum of {minimum_bytes} bytes")
    if minimum_bytes == size_bytes:
        return minimum
    low = minimum
    high = minimum
    while logdir_input_bytes(high, seed) < size_bytes:
        high *= 2
    while low + 1 < high:
        mid = (low + high) // 2
        if logdir_input_bytes(mid, seed) >= size_bytes:
            high = mid
        else:
            low = mid
    return high


def generate_logdir(root: Path, *, lines: int | None = None, mib: float | None = None, seed: int = SEED) -> dict:
    if lines is not None and mib is not None:
        raise SystemExit("error: pass only one of --lines and --mib")
    if mib is not None:
        line_count = lines_for_mib(mib, seed)
    else:
        line_count = LOGDIR_DEFAULT_LINES if lines is None else lines
    records = logdir_records(line_count, seed)
    grouped: dict[str, list[str]] = {}
    order: list[str] = []
    for relative, line in records:
        if relative not in grouped:
            order.append(relative)
            grouped[relative] = []
        grouped[relative].append(line)
    root.mkdir(parents=True, exist_ok=True)
    written: list[Path] = []
    total_bytes = 0
    for relative in order:
        path = root.joinpath(*relative.split("/"))
        path.parent.mkdir(parents=True, exist_ok=True)
        text = "".join(f"{line}\n" for line in grouped[relative])
        path.write_text(text, encoding="utf-8", newline="\n")
        total_bytes += path.stat().st_size
        written.append(path)
    encoded = sum(len(line.encode("utf-8")) + 1 for _relative, line in records)
    if total_bytes != encoded:
        raise SystemExit("error: log directory byte count changed while writing")
    written.sort(key=lambda path: path.relative_to(root).as_posix())
    return {
        "lines": line_count,
        "filesRead": len(written),
        "inputBytes": total_bytes,
        "files": written,
    }


def execute_timed(argv: list[str], timeout: float | None, time_path: Path) -> dict:
    command = with_address_limit([gnu_time_binary(), "-f", "%e %M", "-o", str(time_path), *argv])
    started = time.perf_counter()
    process = subprocess.Popen(
        command,
        env=os.environ.copy(),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        start_new_session=True,
    )
    try:
        stdout, stderr_bytes = process.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        os.killpg(process.pid, signal.SIGKILL)
        process.communicate()
        return {
            "exitCode": None,
            "stdout": "",
            "stderr": "",
            "wallSeconds": round(time.perf_counter() - started, 6),
            "peakRssBytes": None,
            "error": f"timed out after {timeout}s",
        }
    wall_seconds, peak_rss_bytes = read_gnu_time(time_path)
    if wall_seconds is None:
        wall_seconds = time.perf_counter() - started
    return {
        "exitCode": process.returncode,
        "stdout": stdout.decode("utf-8", "replace"),
        "stderr": stderr_bytes.decode("utf-8", "replace"),
        "wallSeconds": round(wall_seconds, 6),
        "peakRssBytes": peak_rss_bytes,
        "error": None,
    }


def command_error(result: dict, *, corpus: Path | None = None, need_stdout: bool = False) -> str | None:
    if result.get("error"):
        return result["error"]
    code = result["exitCode"]
    stderr = result["stderr"]
    if "Failed to allocate memory" in stderr:
        return "embedder failed to allocate"
    if code is not None and code < 0:
        return f"killed by signal {-code}"
    if code is not None and code > 128:
        return f"killed by signal {code - 128}"
    if code not in (0, None):
        return f"nesso exited {code}"
    if corpus is not None and (not corpus.is_file() or corpus.stat().st_size == 0):
        return "missing corpus"
    if result["peakRssBytes"] is None:
        return "missing peak RSS"
    if need_stdout and not result["stdout"]:
        return "no matches on stdout"
    return None


def logdir_case(
    *,
    lines: int,
    files_read: int,
    input_bytes: int,
    index_result: dict,
    search_result: dict | None,
    corpus_bytes: int | None,
    error: str | None,
) -> dict:
    index_wall = index_result["wallSeconds"]
    search_wall = None if search_result is None else search_result["wallSeconds"]
    index_peak = index_result["peakRssBytes"]
    search_peak = None if search_result is None else search_result["peakRssBytes"]
    total = None
    if index_wall is not None and search_wall is not None:
        total = round(index_wall + search_wall, 6)
    peaks = [value for value in (index_peak, search_peak) if value is not None]
    ratio = None
    if corpus_bytes is not None and input_bytes > 0:
        ratio = round(corpus_bytes / input_bytes, 6)
    case = {
        "lines": lines,
        "filesRead": files_read,
        "ok": error is None,
        "indexExitCode": index_result["exitCode"],
        "searchExitCode": None if search_result is None else search_result["exitCode"],
        "indexWallSeconds": index_wall,
        "searchWallSeconds": search_wall,
        "wallSeconds": total,
        "indexPeakRssBytes": index_peak,
        "searchPeakRssBytes": search_peak,
        "peakRssBytes": max(peaks) if peaks else None,
        "inputBytes": input_bytes,
        "corpusBytes": corpus_bytes,
        "corpusToInputRatio": ratio,
    }
    if error is not None:
        case["error"] = error
    return case


def logdir_payload(*, sha: str, binary: Path, cpu: str, nproc: int, threads: str | None, case: dict) -> dict:
    return {
        "sha": sha,
        "binary": str(binary),
        "dataset": "logdir",
        "query": LOGDIR_QUERY,
        "seed": SEED,
        "cpuModel": cpu,
        "nproc": nproc,
        "threads": threads,
        "cases": [case],
    }


def run_logdir(args: argparse.Namespace) -> None:
    if args.sizes is not None:
        raise SystemExit("error: --sizes applies to the synthetic grep benchmark")
    if args.sample is not None:
        raise SystemExit("error: --sample applies to --dataset hdfs")
    if args.lines is not None and args.mib is not None:
        raise SystemExit("error: pass only one of --lines and --mib")
    binary = resolve_binary(args.binary)
    if not binary.is_file():
        raise SystemExit(f"error: binary not found: {binary}")
    model_dir = resolve_model_dir(args.model_dir)
    if not (model_dir / "model.onnx").is_file() or not (model_dir / "vocab.txt").is_file():
        raise SystemExit(f"error: {model_dir} must contain model.onnx and vocab.txt")
    time_bin = gnu_time_binary()
    if not Path(time_bin).is_file():
        raise SystemExit(f"error: {time_bin} is required")
    with tempfile.TemporaryDirectory(prefix="nesso-bench-logdir-") as tmp:
        directory = Path(tmp)
        root = directory / "tree"
        if args.mib is not None:
            stats = generate_logdir(root, mib=args.mib)
        else:
            stats = generate_logdir(root, lines=args.lines)
        corpus = directory / "corpus.nesso"
        print(
            f"bench: logdir index+search {stats['lines']} lines {stats['filesRead']} files",
            flush=True,
        )
        index_result = execute_timed(
            [
                str(binary),
                "index",
                "-o",
                str(corpus),
                *[str(path) for path in stats["files"]],
                "--model-dir",
                str(model_dir),
                "--quiet",
            ],
            args.timeout,
            directory / "index-time.txt",
        )
        error = command_error(index_result, corpus=corpus)
        if error is None:
            found = INDEXED_CHUNKS.findall(index_result["stderr"])
            if found and int(found[-1]) != stats["lines"]:
                error = "indexed chunk count mismatch"
        search_result = None
        if error is None:
            search_result = execute_timed(
                [
                    str(binary),
                    "search",
                    LOGDIR_QUERY,
                    "-i",
                    str(corpus),
                    "--model-dir",
                    str(model_dir),
                    "-k",
                    "5",
                ],
                args.timeout,
                directory / "search-time.txt",
            )
            error = command_error(search_result, need_stdout=True)
        corpus_bytes = corpus.stat().st_size if corpus.is_file() else None
        case = logdir_case(
            lines=stats["lines"],
            files_read=stats["filesRead"],
            input_bytes=stats["inputBytes"],
            index_result=index_result,
            search_result=search_result,
            corpus_bytes=corpus_bytes,
            error=error,
        )
    status = "ok" if case["ok"] else case.get("error", "failed")
    print(
        f"bench: {case['lines']} lines {case['filesRead']} files {status} "
        f"wall={case['wallSeconds']}s index={case['indexWallSeconds']}s "
        f"search={case['searchWallSeconds']}s peak={case['peakRssBytes']} "
        f"corpusBytes={case['corpusBytes']} inputBytes={case['inputBytes']} "
        f"ratio={case['corpusToInputRatio']}",
        flush=True,
    )
    cpu = cpu_model()
    count = logical_cpus()
    threads = threads_setting()
    shown_threads = threads if threads is not None else "unset"
    print(f"bench: cpu={cpu} nproc={count} NESSO_THREADS={shown_threads}", flush=True)
    payload = logdir_payload(sha=git_sha(), binary=binary, cpu=cpu, nproc=count, threads=threads, case=case)
    output = args.output or (ROOT / "bench" / "results" / f"{payload['sha']}.logdir.json")
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
    print(f"bench: wrote {output}")
    if not case.get("ok"):
        raise SystemExit(1)


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--binary", help="Path to the nesso executable")
    parser.add_argument("--model-dir", help="Directory with model.onnx and vocab.txt")
    parser.add_argument(
        "--dataset",
        choices=("hdfs", "logdir"),
        help="hdfs indexes the Loghub sample. logdir indexes a generated log directory and runs one search",
    )
    parser.add_argument(
        "--lines",
        type=int,
        default=None,
        help="Line count for --dataset hdfs (repeat the sample) or --dataset logdir (generate the tree)",
    )
    parser.add_argument(
        "--mib",
        type=float,
        default=None,
        help="Build the log directory until the indexed files reach this many MiB",
    )
    parser.add_argument("--sample", type=Path, help="HDFS sample to repeat (default: scripts/fetch-loghub)")
    parser.add_argument(
        "--sizes",
        default=None,
        help="Comma-separated log line counts (default: 1000,10000,100000)",
    )
    parser.add_argument("--output", type=Path, help="Result JSON path (default: bench/results/<sha>.json)")
    parser.add_argument("--timeout", type=float, help="Per-size timeout in seconds")
    args = parser.parse_args()
    if args.dataset == "hdfs":
        if args.mib is not None:
            raise SystemExit("error: --mib applies to --dataset logdir")
        run_hdfs(args)
        return
    if args.dataset == "logdir":
        run_logdir(args)
        return
    if args.mib is not None:
        raise SystemExit("error: --mib applies to --dataset logdir")
    if args.sample is not None:
        raise SystemExit("error: --sample applies to --dataset hdfs")
    if args.lines is not None:
        raise SystemExit("error: --lines applies to --dataset hdfs or --dataset logdir")

    binary = resolve_binary(args.binary)
    if not binary.is_file():
        raise SystemExit(f"error: binary not found: {binary}")
    model_dir = resolve_model_dir(args.model_dir)
    if not (model_dir / "model.onnx").is_file() or not (model_dir / "vocab.txt").is_file():
        raise SystemExit(f"error: {model_dir} must contain model.onnx and vocab.txt")
    if not Path("/usr/bin/time").is_file():
        raise SystemExit("error: /usr/bin/time is required")

    size_text = args.sizes if args.sizes is not None else ",".join(str(size) for size in DEFAULT_SIZES)
    sizes = tuple(int(part) for part in size_text.split(",") if part)
    if not sizes or any(size <= 0 for size in sizes):
        raise SystemExit("error: --sizes must be positive integers")

    sha = git_sha()
    cases = []
    for size in sizes:
        print(f"bench: grep {size} lines", flush=True)
        case = run_case(binary, model_dir, size, args.timeout)
        status = "ok" if case["ok"] else case.get("error", "failed")
        print(f"bench: {size} lines {status} wall={case['wallSeconds']}s peak={case['peakRssBytes']}", flush=True)
        cases.append(case)

    payload = grep_payload(
        sha=sha,
        binary=binary,
        query=QUERY,
        cpu=cpu_model(),
        nproc=logical_cpus(),
        threads=threads_setting(),
        cases=cases,
    )
    output = args.output or (ROOT / "bench" / "results" / f"{sha}.json")
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
    print(f"bench: wrote {output}")
    if any(not case.get("ok") for case in cases):
        raise SystemExit(1)


if __name__ == "__main__":
    main()
