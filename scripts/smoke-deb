#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 || $# -gt 2 ]]; then
  echo "usage: smoke-deb DEB [IMAGE]" >&2
  exit 2
fi

DEB="$1"
IMAGE="${2:-ubuntu:26.04}"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ ! -f "${DEB}" ]]; then
  echo "error: deb not found: ${DEB}" >&2
  exit 2
fi
if [[ ! "${IMAGE}" =~ ^[A-Za-z0-9][A-Za-z0-9._:/-]*$ ]]; then
  echo "error: refusing image ${IMAGE}" >&2
  exit 2
fi

DEB_ABS="$(cd "$(dirname "${DEB}")" && pwd)/$(basename "${DEB}")"

# Same grep as the release smoke. remove and purge each start from an
# installed package so a config-file leftover cannot hide a failed remove.
docker run --rm \
  -v "${DEB_ABS}:/tmp/nesso.deb:ro" \
  -v "${ROOT}/test/fixtures:/data:ro" \
  "${IMAGE}" \
  bash -euo pipefail -c '
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y /tmp/nesso.deb
    nesso -V
    nesso grep "connection refused" /data/grep_sample.log -k 3
    test -x /usr/bin/nesso
    test -f /usr/share/nesso/model.onnx
    apt-get remove -y nesso
    if [[ -e /usr/bin/nesso || -e /usr/share/nesso ]]; then
      echo "error: apt-get remove left nesso files behind" >&2
      ls -la /usr/bin/nesso /usr/share/nesso >&2 || true
      exit 1
    fi
    apt-get install -y /tmp/nesso.deb
    apt-get purge -y nesso
    if [[ -e /usr/bin/nesso || -e /usr/share/nesso ]]; then
      echo "error: apt-get purge left nesso files behind" >&2
      ls -la /usr/bin/nesso /usr/share/nesso >&2 || true
      exit 1
    fi
    status="$(dpkg-query -W -f="\${Status}" nesso 2>/dev/null || true)"
    case "${status}" in
      ""|*"not-installed"*) ;;
      *)
        echo "error: dpkg status after purge: ${status}" >&2
        exit 1
        ;;
    esac
  '
