#!/usr/bin/env bash
# AFL++ fuzz of StorageEngine + searchTopKCosine via fuzz/fuzz_storage.cpp.
# Builds an AFL-instrumented + ASan binary with afl-clang-fast++.
# Requires: afl++ (afl-fuzz, afl-clang-fast++)
#
# Local / CI:
#   ./scripts/fuzz-test
#   MACH1_FUZZ_MAX_TOTAL_TIME=120 ./scripts/fuzz-test
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

for cmd in afl-fuzz afl-clang-fast++; do
  if ! command -v "${cmd}" >/dev/null 2>&1; then
    echo "error: ${cmd} not found. Install AFL++ (e.g. sudo apt install afl++)" >&2
    exit 2
  fi
done

OUT_DIR="${MACH1_FUZZ_OUT:-build/fuzz}"
SEEDS_DIR="${MACH1_FUZZ_SEEDS:-fuzz/seeds/storage}"
FINDINGS_DIR="${OUT_DIR}/afl-out"
MAX_TOTAL_TIME="${MACH1_FUZZ_MAX_TOTAL_TIME:-60}"
BIN="${OUT_DIR}/mach1_afl"

mkdir -p "${OUT_DIR}"

echo "fuzz-test: building AFL+ASan instrumented ${BIN}"
export AFL_USE_ASAN=1
unset ASAN_OPTIONS UBSAN_OPTIONS || true

# Harness targets StorageEngine + searchTopKCosine only — no CLI11, no LogIndex.
# This keeps the fuzz binary stable across CLI refactors.
afl-clang-fast++ -std=c++26 -O1 -g -fno-omit-frame-pointer \
  -I src/mach_core/include \
  fuzz/fuzz_storage.cpp \
  src/mach_core/storage_engine.cpp \
  src/mach_core/distance.cpp \
  src/mach_core/vector_search.cpp \
  -o "${BIN}"

export ASAN_OPTIONS="${ASAN_OPTIONS:-detect_leaks=0:abort_on_error=1:symbolize=0:allocator_may_return_null=1}"
export UBSAN_OPTIONS="${UBSAN_OPTIONS:-halt_on_error=1:print_stacktrace=1}"
export AFL_NO_UI="${AFL_NO_UI:-1}"
# GHA/containers: core_pattern is '|…' and not writable; ASan still reports crashes.
export AFL_I_DONT_CARE_ABOUT_MISSING_CRASHES="${AFL_I_DONT_CARE_ABOUT_MISSING_CRASHES:-1}"
# Avoid CPU governor abort in containers/VMs.
export AFL_SKIP_CPUFREQ="${AFL_SKIP_CPUFREQ:-1}"

rm -rf "${FINDINGS_DIR}"
mkdir -p "${FINDINGS_DIR}"

echo "fuzz-test: afl-fuzz -V ${MAX_TOTAL_TIME}s seeds=${SEEDS_DIR}"
afl-fuzz -V "${MAX_TOTAL_TIME}" -i "${SEEDS_DIR}" -o "${FINDINGS_DIR}" -m none -- \
  "${BIN}" @@

CRASH_DIR="${FINDINGS_DIR}/default/crashes"
mapfile -t crashes < <(find "${CRASH_DIR}" -type f -name 'id:*' 2>/dev/null | sort || true)
if ((${#crashes[@]} > 0)); then
  echo "error: fuzz-test found ${#crashes[@]} unique crash(es):" >&2
  printf '  %s\n' "${crashes[@]}" >&2
  exit 1
fi

echo "fuzz-test OK (0 crashes in ${MAX_TOTAL_TIME}s)"
