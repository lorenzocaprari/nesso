#!/usr/bin/env bash
# AFL++ library harnesses: StorageEngine, LogChunker, WordPieceTokenizer.
# Builds AFL-instrumented + ASan binaries via Conan + CMake.
# Requires: afl++ (afl-fuzz, afl-clang-fast++), Conan deps in cache.
#
# Local / CI:
#   ./scripts/fuzz-test
#   NESSO_FUZZ_MAX_TOTAL_TIME=120 ./scripts/fuzz-test
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

for cmd in afl-fuzz afl-clang-fast++; do
  if ! command -v "${cmd}" >/dev/null 2>&1; then
    echo "error: ${cmd} not found. Install AFL++ (e.g. sudo apt install afl++)" >&2
    exit 2
  fi
done

OUT_DIR="${NESSO_FUZZ_OUT:-build/fuzz}"
MAX_TOTAL_TIME="${NESSO_FUZZ_MAX_TOTAL_TIME:-60}"
CONAN_PROFILE="${NESSO_FUZZ_CONAN_PROFILE:-conan/profiles/gcc-26-fuzz}"
CMAKE_B="${OUT_DIR}/build/Release"
TOOLCHAIN="${CMAKE_B}/generators/conan_toolchain.cmake"
BIN_DIR="${CMAKE_B}/test/fuzz"

TARGETS=(nesso_fuzz_storage nesso_fuzz_parser nesso_fuzz_tokenizer)

mkdir -p "${OUT_DIR}"

echo "fuzz-test: Conan + CMake AFL+ASan build -> ${BIN_DIR}"
export AFL_USE_ASAN=1
unset ASAN_OPTIONS UBSAN_OPTIONS || true
export CC=afl-clang-fast
export CXX=afl-clang-fast++

conan_install() {
  conan install . -of "${OUT_DIR}" \
    -pr:h "${CONAN_PROFILE}" -pr:b default \
    --lockfile=conan.lock \
    --build=missing \
    "$@"
}

if ! conan_install --no-remote; then
  echo "fuzz-test: Conan cache miss with --no-remote; retrying with remotes" >&2
  conan_install
fi

cmake -S . -B "${CMAKE_B}" -G Ninja \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_CXX_COMPILER=afl-clang-fast++ \
  -DCMAKE_C_COMPILER=afl-clang-fast \
  -DCMAKE_TOOLCHAIN_FILE="${TOOLCHAIN}"

cmake --build "${CMAKE_B}" --target "${TARGETS[@]}"

export ASAN_OPTIONS="${ASAN_OPTIONS:-detect_leaks=0:abort_on_error=1:symbolize=0:allocator_may_return_null=1}"
export UBSAN_OPTIONS="${UBSAN_OPTIONS:-halt_on_error=1:print_stacktrace=1}"
export AFL_NO_UI="${AFL_NO_UI:-1}"
export AFL_I_DONT_CARE_ABOUT_MISSING_CRASHES="${AFL_I_DONT_CARE_ABOUT_MISSING_CRASHES:-1}"
export AFL_SKIP_CPUFREQ="${AFL_SKIP_CPUFREQ:-1}"

run_campaign() {
  local name="$1"
  local seeds="$2"
  local bin="${BIN_DIR}/nesso_fuzz_${name}"
  local findings="${OUT_DIR}/afl-out-${name}"

  rm -rf "${findings}"
  mkdir -p "${findings}"

  echo "fuzz-test: ${name} afl-fuzz -V ${MAX_TOTAL_TIME}s seeds=${seeds}"
  afl-fuzz -V "${MAX_TOTAL_TIME}" -i "${seeds}" -o "${findings}" -m none -- "${bin}" @@

  local crash_dir="${findings}/default/crashes"
  mapfile -t crashes < <(find "${crash_dir}" -type f -name 'id:*' 2>/dev/null | sort || true)
  if ((${#crashes[@]} > 0)); then
    echo "error: fuzz-test ${name} found ${#crashes[@]} unique crash(es):" >&2
    printf '  %s\n' "${crashes[@]}" >&2
    return 1
  fi
}

run_campaign storage test/fuzz/seeds/storage
run_campaign parser test/fuzz/seeds/parser
run_campaign tokenizer test/fuzz/seeds/tokenizer

echo "fuzz-test OK (0 crashes in ${MAX_TOTAL_TIME}s per target)"
