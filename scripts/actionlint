#!/usr/bin/env bash
# actionlint 1.7.12. shellcheck and pyflakes stay off: a runner image that
# ships either one would change the result, and this gate is actionlint's
# workflow checks. Checksums are the v1.7.12 release checksums file.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=download-pinned
source "${ROOT}/scripts/download-pinned"

version="1.7.12"
case "$(uname -m)" in
  x86_64)
    asset_arch="amd64"
    sha256="8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8"
    ;;
  aarch64 | arm64)
    asset_arch="arm64"
    sha256="325e971b6ba9bfa504672e29be93c24981eeb1c07576d730e9f7c8805afff0c6"
    ;;
  *)
    echo "error: unsupported architecture $(uname -m)" >&2
    exit 1
    ;;
esac

cache="${XDG_CACHE_HOME:-${HOME}/.cache}/nesso/actionlint/${version}-${asset_arch}"
url="https://github.com/rhysd/actionlint/releases/download/v${version}/actionlint_${version}_linux_${asset_arch}.tar.gz"
bin="$(download_pinned "${cache}" "${url}" "${sha256}" actionlint)"

cd "${ROOT}"
exec "${bin}" -no-color -shellcheck= -pyflakes= "$@"
