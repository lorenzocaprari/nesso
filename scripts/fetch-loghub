# Loghub 2.0 (ISSTA 2024), CC-BY-4.0. Its BGL and Thunderbird logs keep the
# original expert alert tag as the first token of each line: "-" for a normal
# line, else an alert category (Oliner & Stearley, DSN 2007).
LOGHUB2_RECORD = "8275861"
LOGHUB2_FILES = f"https://zenodo.org/records/{LOGHUB2_RECORD}/files"


@dataclass(frozen=True)
class LabelledSet:
    name: str
    url: str
    archive_sha256: str
    archive_md5: str
    member: str
    # File stem for windows: <stem>_<start>_<count>.log / .labels
    stem: str


