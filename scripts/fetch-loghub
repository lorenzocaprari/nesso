# (dataset, start, count) -> (sha256 of the stripped .log, sha256 of .labels).
# Windows used by the needle benchmark; any other window is written unpinned.
WINDOW_PINS: dict[tuple[str, int, int], tuple[str, str]] = {
    # 17 alert categories, 21,061 alert lines.
    ("bgl-loghub2", 4_100_001, 100_000): (
        "fbd0e8ead73f2980ebf2a691e0844c92cb815dd794e39b3c0b72a2c271af238a",
        "9fa23317eb5ffb54c2626584a3efc82690e48df1386170b44c9fe7eee776c655",
    ),
    # 27 alert categories, 72,300 alert lines.
    ("bgl-loghub2", 3_200_001, 1_000_000): (
        "df2665f262c49bc82034541109a3ebeffe51f3ba3a171eedc0830c25fb5c16b2",
        "70b0b19c1f33a06d64a7603e8fc5d4a17057cc704b7ce3da693c9004c2e95704",
    ),
    # 5 alert categories, 32 alert lines.
    ("thunderbird-loghub2", 8_550_001, 1_000_000): (
        "d106f820822de19f9e0a43e40e679a9a15c06a7a8bde1ac2708a0cdf41a4515b",
        "78efc6410e72f7893ae292f45090c7356ab6ab118849b3d4510ce7435a7ac046",
    ),
}


@dataclass(frozen=True)
class Window:
    start: int
    count: int


def parse_window(raw: str) -> Window:
    try:
        start_raw, count_raw = raw.split(":", 1)
        window = Window(start=int(start_raw), count=int(count_raw))
    except ValueError as exc:
        raise SystemExit(f"error: --window must be START:COUNT with integers, got {raw!r}") from exc
    if window.start < 1 or window.count < 1:
        raise SystemExit(f"error: --window needs START >= 1 and COUNT >= 1, got {raw!r}")
    return window


def window_paths(spec: LabelledSet, window: Window, dest_dir: Path) -> tuple[Path, Path]:
    base = f"{spec.stem}_{window.start}_{window.count}"
    return dest_dir / f"{base}.log", dest_dir / f"{base}.labels"


def split_label(raw: bytes, line_number: int) -> tuple[bytes, bytes]:
    """Split '<label> <rest>' into (label, rest). Rest keeps no trailing newline."""
    text = raw.rstrip(b"\r\n")
    label, sep, rest = text.partition(b" ")
    if not sep or not label:
        raise SystemExit(f"error: line {line_number} has no alert label token")
    if label != b"-" and not all(65 <= byte <= 90 or byte == 95 or 48 <= byte <= 57 for byte in label):
        raise SystemExit(f"error: line {line_number} label {label[:40]!r} is not '-' or an alert category")
    return label, rest


def write_windows(source, targets: list[tuple[Window, Path, Path]]) -> None:
    """Stream source once and write each window's stripped log and labels."""
    ordered = sorted(targets, key=lambda item: item[0].start)
    handles: dict[int, tuple[Window, object, object, list[int]]] = {}
    line_number = 0
    last = max(window.start + window.count - 1 for window, _log, _labels in ordered)
    try:
        for index, (window, log_path, labels_path) in enumerate(ordered):
            handles[index] = (window, log_path.open("wb"), labels_path.open("wb"), [0])
        while line_number < last:
            raw = source.readline()
            if not raw:
                break
            line_number += 1
            active = [
                entry
                for entry in handles.values()
                if entry[0].start <= line_number < entry[0].start + entry[0].count
            ]
            if not active:
                continue
            label, rest = split_label(raw, line_number)
            for _window, log_handle, labels_handle, written in active:
                log_handle.write(rest + b"\n")
                labels_handle.write(label + b"\n")
                written[0] += 1
    finally:
        for _window, log_handle, labels_handle, _written in handles.values():
            log_handle.close()
            labels_handle.close()
    for window, _log_handle, _labels_handle, written in handles.values():
        if written[0] != window.count:
            raise SystemExit(
                f"error: window {window.start}:{window.count} has {written[0]} lines, need {window.count}"
            )


def window_cached(spec: LabelledSet, window: Window, log_path: Path, labels_path: Path) -> bool:
    pin = WINDOW_PINS.get((spec.name, window.start, window.count))
    if pin is None or not log_path.is_file() or not labels_path.is_file():
        return False
    return sha256_file(log_path) == pin[0] and sha256_file(labels_path) == pin[1]


def fetch_labelled(
    spec: LabelledSet,
    windows: list[Window],
    dest_dir: Path,
    *,
    url: str | None = None,
    expected: str | None = None,
) -> list[tuple[Path, Path]]:
    """Download a Loghub 2.0 archive once and write each requested window."""
    outputs = [(window, *window_paths(spec, window, dest_dir)) for window in windows]
    pending = [item for item in outputs if not window_cached(spec, *item)]
    for window, log_path, _labels_path in outputs:
        if not any(item[0] == window for item in pending):
            print(f"fetch-loghub: cached {log_path}")
    if pending:
        dest_dir.mkdir(parents=True, exist_ok=True)
        archive = dest_dir / f"{spec.stem}.zip.archive"
        partials = [
            (window, log_path.with_name(log_path.name + ".partial"), labels_path.with_name(labels_path.name + ".partial"))
            for window, log_path, labels_path in pending
        ]
        archive_pin = normalize_sha256(expected if expected is not None else spec.archive_sha256)
        source_url = url or spec.url
        try:
            download(source_url, archive, timeout=600)
            actual = sha256_file(archive)
            if actual != archive_pin:
                raise SystemExit(f"error: sha256 mismatch for {source_url}: expected {archive_pin}, got {actual}")
            raw, handle = open_member(archive, "zip", spec.member)
            try:
                write_windows(raw, partials)
            finally:
                raw.close()
                handle.close()
            for (window, log_partial, labels_partial), (_w, log_path, labels_path) in zip(
                partials, pending, strict=True
            ):
                pin = WINDOW_PINS.get((spec.name, window.start, window.count))
                if pin is not None:
                    got = (sha256_file(log_partial), sha256_file(labels_partial))
                    if got != pin:
                        raise SystemExit(
                            f"error: window sha256 mismatch for {log_path.name}: expected {pin}, got {got}"
                        )
                log_partial.replace(log_path)
                labels_partial.replace(labels_path)
                print(f"fetch-loghub: wrote {log_path} and {labels_path.name}")
        finally:
            archive.unlink(missing_ok=True)
            for _window, log_partial, labels_partial in partials:
                log_partial.unlink(missing_ok=True)
                labels_partial.unlink(missing_ok=True)
    return [(log_path, labels_path) for _window, log_path, labels_path in outputs]


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def normalize_sha256(value: str) -> str:
    digest = value.strip().lower()
    if len(digest) != 64 or any(char not in "0123456789abcdef" for char in digest):
        raise SystemExit(f"error: sha256 must be 64 hex characters, got {value!r}")
    return digest


def download(url: str, dest: Path, timeout: int = 120) -> None:
    parsed = urllib.request.urlparse(url)
    if parsed.scheme not in {"https", "file"}:
        raise SystemExit(f"error: unsupported URL scheme: {parsed.scheme or url}")
    request = urllib.request.Request(url, headers={"User-Agent": "nesso-fetch-loghub"})
    last_error: Exception | None = None
    for attempt in range(3):
        try:
            with urllib.request.urlopen(request, timeout=timeout) as response, dest.open("wb") as handle:
                shutil.copyfileobj(response, handle)
            return
        except urllib.error.URLError as exc:
            last_error = exc
            if attempt == 2:
                break
            time.sleep(2)
    raise SystemExit(f"error: download failed for {url}: {last_error}")


def fetch(dest: Path, url: str = HDFS_URL, expected: str = HDFS_SHA256) -> Path:
    pin = normalize_sha256(expected)
    if dest.is_file() and sha256_file(dest) == pin:
        print(f"fetch-loghub: cached {dest}")
        return dest
    dest.parent.mkdir(parents=True, exist_ok=True)
    partial = dest.with_name(dest.name + ".partial")
    try:
        download(url, partial)
        actual = sha256_file(partial)
        if actual != pin:
            raise SystemExit(f"error: sha256 mismatch for {url}: expected {pin}, got {actual}")
        partial.replace(dest)
    finally:
        partial.unlink(missing_ok=True)
    print(f"fetch-loghub: wrote {dest}")
    return dest


def write_line_prefix(source, dest: Path, lines: int) -> int:
    if lines <= 0:
        raise SystemExit("error: --lines must be a positive integer")
    written = 0
    with dest.open("wb") as handle:
        while written < lines:
            raw = source.readline()
            if not raw:
                break
            if not raw.endswith(b"\n"):
                raw += b"\n"
            handle.write(raw)
            written += 1
    if written != lines:
        raise SystemExit(f"error: {dest.name} has {written} lines, need {lines}")
    return written


def _unique_member(names: list[str], member: str) -> str:
    if member in names:
        return member
    matches = [name for name in names if name.endswith("/" + member) or name.endswith(member)]
    if len(matches) == 1:
        return matches[0]
    raise SystemExit(f"error: member {member} not in {names}")


def open_member(archive: Path, kind: str, member: str):
    if kind == "zip":
        handle = zipfile.ZipFile(archive)
    elif kind == "tar":
        handle = tarfile.open(archive, "r:*")
    else:
        raise SystemExit(f"error: unsupported archive kind: {kind}")
    try:
        if kind == "zip":
            name = _unique_member(handle.namelist(), member)
            raw = handle.open(name, "r")
        else:
            names = [info.name for info in handle.getmembers() if info.isfile()]
            name = _unique_member(names, member)
            raw = handle.extractfile(name)
            if raw is None:
                raise SystemExit(f"error: cannot read tar member {name}")
    except BaseException:
        handle.close()
        raise
    return raw, handle


def count_lines(path: Path) -> int:
    with path.open("rb") as handle:
        return sum(1 for _ in handle)


def fetch_full(
    spec: FullSet,
    dest: Path,
    lines: int = DEFAULT_PREFIX_LINES,
    url: str | None = None,
    expected: str | None = None,
    prefix_expected: str | None = None,
    member: str | None = None,
    kind: str | None = None,
) -> Path:
    archive_pin = normalize_sha256(expected if expected is not None else spec.archive_sha256)
    explicit_prefix = prefix_expected is not None
    prefix_pin = prefix_expected if explicit_prefix else spec.prefix_sha256
    check_prefix = bool(prefix_pin) and (explicit_prefix or lines == DEFAULT_PREFIX_LINES)
    if (
        check_prefix
        and dest.is_file()
        and sha256_file(dest) == normalize_sha256(prefix_pin)
        and count_lines(dest) == lines
    ):
        print(f"fetch-loghub: cached {dest}")
        return dest
    dest.parent.mkdir(parents=True, exist_ok=True)
    archive = dest.with_name(dest.name + ".archive")
    partial = dest.with_name(dest.name + ".partial")
    source_url = url or spec.url
    try:
        download(source_url, archive, timeout=600)
        actual = sha256_file(archive)
        if actual != archive_pin:
            raise SystemExit(f"error: sha256 mismatch for {source_url}: expected {archive_pin}, got {actual}")
        raw, handle = open_member(archive, kind or spec.kind, member or spec.member)
        try:
            write_line_prefix(raw, partial, lines)
        finally:
            raw.close()
            handle.close()
        if check_prefix:
            prefix_actual = sha256_file(partial)
            pin = normalize_sha256(prefix_pin)
            if prefix_actual != pin:
                raise SystemExit(
                    f"error: prefix sha256 mismatch for {dest.name}: expected {pin}, got {prefix_actual}"
                )
        partial.replace(dest)
    finally:
        archive.unlink(missing_ok=True)
        partial.unlink(missing_ok=True)
    print(f"fetch-loghub: wrote {dest}")
    return dest


def default_dest(spec: FullSet, dest_dir: Path) -> Path:
    return dest_dir / spec.dest_name


def _reject_2k_full_flags(dataset: str, args: argparse.Namespace) -> None:
    if args.lines != DEFAULT_PREFIX_LINES:
        raise SystemExit(f"error: --lines applies to a full Loghub set, not {dataset}")
    if args.member is not None or args.kind is not None or args.prefix_sha256 is not None:
        raise SystemExit("error: --member, --kind, and --prefix-sha256 apply to a full Loghub set")


def fetch_sample_2k(
    spec: Sample2k,
    *,
    log_dest: Path,
    structured_dest: Path | None,
    url: str | None,
    sha256: str | None,
) -> None:
    fetch(log_dest, url or spec.log_url, sha256 or spec.log_sha256)
    # Unit tests override --url/--sha256 for the log only; keep that path offline.
    if url is None and sha256 is None and structured_dest is not None:
        fetch(structured_dest, spec.structured_url, spec.structured_sha256)


def main(argv: list[str] | None = None) -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--dataset",
        choices=DATASET_CHOICES,
        default="hdfs-2k",
        help="Pinned 2k sample (default hdfs-2k), all-2k, or a full Zenodo set",
    )
    parser.add_argument("--dest", type=Path, default=None, help="Output path for a single dataset")
    parser.add_argument(
        "--dest-dir",
        type=Path,
        default=BENCH_DIR,
        help="Directory for --dataset all-2k or all-full (default: build/bench)",
    )
    parser.add_argument("--lines", type=int, default=DEFAULT_PREFIX_LINES, help="Prefix length for a full set")
    parser.add_argument("--url", default=None, help="Override the pinned URL")
    parser.add_argument("--sha256", default=None, help="Override the pinned archive or sample sha256")
    parser.add_argument("--prefix-sha256", default=None, help="Override the pinned prefix sha256")
    parser.add_argument("--member", default=None, help="Override the archive member name")
    parser.add_argument("--kind", choices=("zip", "tar"), default=None, help="Override the archive kind")
    parser.add_argument(
        "--window",
        action="append",
        default=None,
        metavar="START:COUNT",
        help="Labelled Loghub 2.0 window (repeatable; bgl-loghub2 and thunderbird-loghub2 only)",
    )
    args = parser.parse_args(argv)

    if args.dataset in LABELLED_SETS:
        if not args.window:
            raise SystemExit(f"error: --dataset {args.dataset} needs at least one --window START:COUNT")
        if args.dest is not None or args.lines != DEFAULT_PREFIX_LINES:
            raise SystemExit("error: --dest and --lines do not apply to a labelled window; use --dest-dir")
        if args.member is not None or args.kind is not None or args.prefix_sha256 is not None:
            raise SystemExit("error: --member, --kind, and --prefix-sha256 do not apply to a labelled window")
        fetch_labelled(
            LABELLED_SETS[args.dataset],
            [parse_window(raw) for raw in args.window],
            args.dest_dir,
            url=args.url,
            expected=args.sha256,
        )
        return
    if args.window:
        raise SystemExit("error: --window applies to bgl-loghub2 and thunderbird-loghub2 only")

    if args.dataset in SAMPLES_2K or args.dataset == ALL_2K:
        _reject_2k_full_flags(args.dataset, args)
        if args.dataset == ALL_2K:
            if args.dest is not None:
                raise SystemExit("error: --dest applies to one dataset; use --dest-dir for all-2k")
            if args.url or args.sha256:
                raise SystemExit("error: URL and pin overrides apply to one dataset, not all-2k")
            for name in SAMPLES_2K:
                spec = SAMPLES_2K[name]
                log_dest = args.dest_dir / spec.log_name
                structured_dest = args.dest_dir / f"{spec.log_name}_structured.csv"
                fetch_sample_2k(
                    spec,
                    log_dest=log_dest,
                    structured_dest=structured_dest,
                    url=None,
                    sha256=None,
                )
            return
        spec = SAMPLES_2K[args.dataset]
        if args.dest is None:
            log_dest = args.dest_dir / spec.log_name
            structured_dest = args.dest_dir / f"{spec.log_name}_structured.csv"
        else:
            log_dest = args.dest
            structured_dest = log_dest.with_name(log_dest.name + "_structured.csv")
        fetch_sample_2k(
            spec,
            log_dest=log_dest,
            structured_dest=structured_dest,
            url=args.url,
            sha256=args.sha256,
        )
        return

    if args.lines <= 0:
        raise SystemExit("error: --lines must be a positive integer")
    names = list(FULL_SETS) if args.dataset == "all-full" else [args.dataset]
    if args.dataset == "all-full" and args.dest is not None:
        raise SystemExit("error: --dest applies to one dataset; use --dest-dir for all-full")
    if args.dataset == "all-full" and (args.url or args.sha256 or args.member or args.kind or args.prefix_sha256):
        raise SystemExit("error: URL and pin overrides apply to one dataset, not all-full")
    for name in names:
        spec = FULL_SETS[name]
        dest = args.dest if args.dataset != "all-full" and args.dest is not None else default_dest(spec, args.dest_dir)
        fetch_full(
            spec,
            dest,
            lines=args.lines,
            url=args.url,
            expected=args.sha256,
            prefix_expected=args.prefix_sha256,
            member=args.member,
            kind=args.kind,
        )


if __name__ == "__main__":
    try:
        main()
    except SystemExit as exc:
        code = exc.code
        if isinstance(code, str):
            print(code, file=sys.stderr)
            raise SystemExit(1) from exc
        raise
