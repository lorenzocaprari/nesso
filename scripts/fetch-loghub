#!/usr/bin/env python3
"""Download the Loghub HDFS_v1 2k sample into build/bench/.

The file is HDFS/HDFS_2k.log from logpai/loghub at a pinned commit. Loghub
data is for research use and must stay out of the repository. A file already
at the destination is kept when its sha256 matches the pin; otherwise it is
downloaded again and rejected when the bytes do not match.
"""

import argparse
import hashlib
import shutil
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
# Last commit that changed HDFS/HDFS_2k.log on logpai/loghub. Not a branch name.
HDFS_COMMIT = "374038faa4ca122dd7ca0730372c0b78f76f8597"
HDFS_URL = f"https://raw.githubusercontent.com/logpai/loghub/{HDFS_COMMIT}/HDFS/HDFS_2k.log"
HDFS_SHA256 = "7c967000980c086ed55fa6544ba4f05fe66d44622795e890c68caf8bbb635035"
DEFAULT_DEST = ROOT / "build" / "bench" / "HDFS_2k.log"


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def normalize_sha256(value: str) -> str:
    digest = value.strip().lower()
    if len(digest) != 64 or any(char not in "0123456789abcdef" for char in digest):
        raise SystemExit(f"error: sha256 must be 64 hex characters, got {value!r}")
    return digest


def download(url: str, dest: Path) -> None:
    parsed = urllib.request.urlparse(url)
    if parsed.scheme not in {"https", "file"}:
        raise SystemExit(f"error: unsupported URL scheme: {parsed.scheme or url}")
    request = urllib.request.Request(url, headers={"User-Agent": "nesso-fetch-loghub"})
    last_error: Exception | None = None
    for attempt in range(3):
        try:
            with urllib.request.urlopen(request, timeout=120) as response, dest.open("wb") as handle:
                shutil.copyfileobj(response, handle)
            return
        except urllib.error.URLError as exc:
            last_error = exc
            if attempt == 2:
                break
            time.sleep(2)
    raise SystemExit(f"error: download failed for {url}: {last_error}")


def fetch(dest: Path, url: str = HDFS_URL, expected: str = HDFS_SHA256) -> Path:
    pin = normalize_sha256(expected)
    if dest.is_file() and sha256_file(dest) == pin:
        print(f"fetch-loghub: cached {dest}")
        return dest
    dest.parent.mkdir(parents=True, exist_ok=True)
    partial = dest.with_name(dest.name + ".partial")
    try:
        download(url, partial)
        actual = sha256_file(partial)
        if actual != pin:
            raise SystemExit(f"error: sha256 mismatch for {url}: expected {pin}, got {actual}")
        partial.replace(dest)
    finally:
        partial.unlink(missing_ok=True)
    print(f"fetch-loghub: wrote {dest}")
    return dest


def main(argv: list[str] | None = None) -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--dest", type=Path, default=DEFAULT_DEST, help="Output path (default: build/bench/HDFS_2k.log)")
    parser.add_argument("--url", default=HDFS_URL, help="Pinned sample URL")
    parser.add_argument("--sha256", default=HDFS_SHA256, help="Expected sha256 of the sample")
    args = parser.parse_args(argv)
    fetch(args.dest, args.url, args.sha256)


if __name__ == "__main__":
    try:
        main()
    except SystemExit as exc:
        code = exc.code
        if isinstance(code, str):
            print(code, file=sys.stderr)
            raise SystemExit(1) from exc
        raise
