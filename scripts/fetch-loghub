        name="thunderbird-loghub2",
        url=f"{LOGHUB2_FILES}/Thunderbird.zip?download=1",
        archive_sha256="ee76bfb6a75126dbf137dcac00a3ebe0c61f90963334354a67c09df1ca1bf831",
        archive_md5="a8d365d003845c3bef61661375513910",
        member="Thunderbird/Thunderbird_full.log",
        stem="Thunderbird_loghub2",
    ),
