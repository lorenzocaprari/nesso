#!/usr/bin/env python3
"""Download pinned Loghub inputs into build/bench/.

The default dataset is the HDFS_v1 2k sample (HDFS/HDFS_2k.log) from
logpai/loghub at a pinned commit, plus the matching structured CSV
(HDFS_2k.log_structured.csv) with per-line EventId labels. Other pinned 2k
samples (BGL, Thunderbird, OpenSSH, Linux, Apache) share that commit. Full sets come
from Zenodo record 8196385:
HDFS_v1, BGL, and Thunderbird. Each full set is checked against a sha256 pin,
then the first N lines of the raw log are written and the archive is deleted.
Thunderbird is streamed from the tar member so the 29 GiB log is never
extracted. Loghub data is for research use and must stay out of the repository.

Labelled windows come from Loghub 2.0 (Zenodo record 8275861, CC-BY-4.0):
--dataset bgl-loghub2 or thunderbird-loghub2 with one or more
--window START:COUNT (1-based start line). Each window is written as
<Name>_loghub2_<start>_<count>.log, with the leading alert tag stripped, and a
matching .labels file with one tag per line ("-" or an alert category such as
KERNDTLB). The tags are the system administrators' labels from Oliner and
Stearley, "What Supercomputers Say" (DSN 2007). The archive is read once for
all windows and then deleted.

A file already at the destination is kept when its sha256 matches the pin.
The 2k sample pin is the file itself. A full set's cache pin is the sha256 of
the default 1_000_000-line prefix.
"""

import argparse
import hashlib
import shutil
import sys
import tarfile
import time
import urllib.error
import urllib.request
import zipfile
from dataclasses import dataclass
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
# Commit where HDFS/BGL/Thunderbird/OpenSSH/Linux/Apache *_2k.log samples are pinned.
LOGHUB_COMMIT = "374038faa4ca122dd7ca0730372c0b78f76f8597"
DEFAULT_PREFIX_LINES = 1_000_000
# Loghub full logs (ISSRE 2023). Not the concept DOI and not /latest.
ZENODO_RECORD = "8196385"
ZENODO_FILES = f"https://zenodo.org/records/{ZENODO_RECORD}/files"
BENCH_DIR = ROOT / "build" / "bench"


@dataclass(frozen=True)
class Sample2k:
    name: str
    folder: str
    log_name: str
    log_sha256: str
    structured_sha256: str

    @property
    def log_url(self) -> str:
        return (
            f"https://raw.githubusercontent.com/logpai/loghub/{LOGHUB_COMMIT}/"
            f"{self.folder}/{self.log_name}"
        )

    @property
    def structured_url(self) -> str:
        return (
            f"https://raw.githubusercontent.com/logpai/loghub/{LOGHUB_COMMIT}/"
            f"{self.folder}/{self.log_name}_structured.csv"
        )

    @property
    def default_log_dest(self) -> Path:
        return BENCH_DIR / self.log_name

    @property
    def default_structured_dest(self) -> Path:
        return BENCH_DIR / f"{self.log_name}_structured.csv"


