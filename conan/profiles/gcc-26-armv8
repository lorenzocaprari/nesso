# Native arm64 Release. Conan's arch name for aarch64 is armv8.
# -march=armv8-a is the portable baseline; the x86-64-v2 flag in gcc-26
# is invalid for this compiler.

[settings]
os=Linux
arch=armv8
compiler=gcc
compiler.version=15
compiler.libcxx=libstdc++11
compiler.cppstd=26
build_type=Release

[conf]
tools.build:compiler_executables={"c": "gcc-15", "cpp": "g++-15"}
user.nesso:cxxflags=["-O3", "-march=armv8-a", "-flto=auto", "-fvisibility=hidden", "-DNDEBUG"]
user.nesso:cflags=["-O3", "-march=armv8-a", "-flto=auto", "-fvisibility=hidden", "-DNDEBUG"]
user.nesso:sharedlinkflags=["-flto=auto", "-Wl,-O1", "-Wl,--as-needed"]
user.nesso:exelinkflags=["-flto=auto", "-Wl,-O1", "-Wl,--as-needed"]

[buildenv]
CC=gcc-15
CXX=g++-15
