[settings]
os=Linux
arch=x86_64
compiler=gcc
compiler.version=15
compiler.libcxx=libstdc++11
compiler.cppstd=26
build_type=Debug
# Same Release onnxruntime binary as gcc-26 and gcc-26-debug.
onnxruntime/*:build_type=Release

[conf]
# Consumer-only (other deps reuse the same Debug package ID as gcc-26-debug)
# inferAll runs infer on one thread per int8 session. Plain --coverage increments
# gcov arcs with a non-atomic add, so those threads lose updates and lcov aborts
# on a negative branch count in onnx_embedder.cpp.gcda. Atomic increments keep
# the arc totals consistent. The flag is consumer-only, same as --coverage.
user.nesso:cxxflags=["-g", "-O0", "-fno-omit-frame-pointer", "-Wall", "-Wextra", "-Wpedantic", "-Wshadow", "-Wconversion", "-Wsign-conversion", "-D_GLIBCXX_DEBUG", "-D_GLIBCXX_DEBUG_PEDANTIC", "--coverage", "-fprofile-update=atomic"]
user.nesso:cflags=["-g", "-O0", "-fno-omit-frame-pointer", "-Wall", "-Wextra", "--coverage", "-fprofile-update=atomic"]
user.nesso:sharedlinkflags=["--coverage"]
user.nesso:exelinkflags=["--coverage"]
