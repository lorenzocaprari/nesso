# EL9 arm64 Release. Conan's arch name for aarch64 is armv8.
# The system compiler stays GCC 11; GCC Toolset 15 lives under /opt/rh.
# -march=armv8-a matches gcc-26-armv8. The x86-64-v2 flag is invalid here.

[settings]
os=Linux
arch=armv8
compiler=gcc
compiler.version=15
compiler.libcxx=libstdc++11
compiler.cppstd=26
build_type=Release

[conf]
tools.build:compiler_executables={"c": "/opt/rh/gcc-toolset-15/root/usr/bin/gcc", "cpp": "/opt/rh/gcc-toolset-15/root/usr/bin/g++"}
user.nesso:cxxflags=["-O3", "-march=armv8-a", "-flto=auto", "-fvisibility=hidden", "-DNDEBUG"]
user.nesso:cflags=["-O3", "-march=armv8-a", "-flto=auto", "-fvisibility=hidden", "-DNDEBUG"]
user.nesso:sharedlinkflags=["-flto=auto", "-Wl,-O1", "-Wl,--as-needed"]
user.nesso:exelinkflags=["-flto=auto", "-Wl,-O1", "-Wl,--as-needed"]

[buildenv]
CC=/opt/rh/gcc-toolset-15/root/usr/bin/gcc
CXX=/opt/rh/gcc-toolset-15/root/usr/bin/g++
