# Clang 23.1.6 + libstdc++ (the GCC 15 ABI), C++26, ASan and UBSan.
#
# settings.compiler stays gcc/15/libstdc++11 on purpose, same as clang-23.
# nesso-build-env bakes Debug packages for that tuple (gcc-26-debug).
# libc++ is a different ABI and cannot link those static archives.
#
# No -flto. build_type=Debug so CMake does not append -O3 -DNDEBUG over
# -O1 -g. -Werror is not set here.
#
# implicit-integer-sign-change in libstdc++ <format> is ignored. The path
# is relative to the recipe root. conanfile.py rewrites it to an absolute
# path. See conan/sanitizer/libstdcxx-format.ignorelist.

[settings]
os=Linux
arch=x86_64
compiler=gcc
compiler.version=15
compiler.libcxx=libstdc++11
compiler.cppstd=26
build_type=Debug
onnxruntime/*:build_type=Release

[conf]
tools.build:compiler_executables={"c": "clang-23", "cpp": "clang++-23"}
user.nesso:cxxflags=["-O1", "-g", "-fno-omit-frame-pointer", "-D_GLIBCXX_ASSERTIONS", "-stdlib=libstdc++", "-fsanitize=address,undefined,float-divide-by-zero,implicit-conversion,local-bounds", "-fno-sanitize-recover=all", "-fsanitize-ignorelist=conan/sanitizer/libstdcxx-format.ignorelist"]
user.nesso:cflags=["-O1", "-g", "-fno-omit-frame-pointer", "-fsanitize=address,undefined,float-divide-by-zero,implicit-conversion,local-bounds", "-fno-sanitize-recover=all"]
user.nesso:sharedlinkflags=["-fsanitize=address,undefined,float-divide-by-zero,implicit-conversion,local-bounds"]
user.nesso:exelinkflags=["-stdlib=libstdc++", "-fsanitize=address,undefined,float-divide-by-zero,implicit-conversion,local-bounds"]

[buildenv]
CC=clang-23
CXX=clang++-23
