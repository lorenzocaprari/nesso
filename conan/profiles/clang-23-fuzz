# Clang 23.1.6 fuzz smoke. Package ids match clang-23 (gcc 15 Release).
# afl-clang-lto++ in the Ubuntu image is LLVM 21, so it is not this
# compiler. scripts/toolchain-preview-fuzz-smoke builds the file-input
# harnesses with clang++-23 and replays seeds under ASan and UBSan.
# No -flto. -Werror is not set here.

[settings]
os=Linux
arch=x86_64
compiler=gcc
compiler.version=15
compiler.libcxx=libstdc++11
compiler.cppstd=26
build_type=Release

[conf]
tools.build:compiler_executables={"c": "clang-23", "cpp": "clang++-23"}
user.nesso:cxxflags=["-O1", "-g", "-fno-omit-frame-pointer", "-march=x86-64-v2", "-D_GLIBCXX_ASSERTIONS", "-stdlib=libstdc++", "-fsanitize=address,undefined", "-fno-sanitize-recover=all"]
user.nesso:cflags=["-O1", "-g", "-fno-omit-frame-pointer", "-march=x86-64-v2", "-fsanitize=address,undefined", "-fno-sanitize-recover=all"]
user.nesso:sharedlinkflags=["-fsanitize=address,undefined"]
user.nesso:exelinkflags=["-stdlib=libstdc++", "-fsanitize=address,undefined"]

[buildenv]
CC=clang-23
CXX=clang++-23
