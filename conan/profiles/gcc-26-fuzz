[settings]
os=Linux
arch=x86_64
compiler=gcc
compiler.version=15
compiler.libcxx=libstdc++11
compiler.cppstd=26
build_type=Release

[conf]
# AFL++ uses afl-clang-fast++; no LTO (ORT static libs are gcc-built) and no profile ASan (AFL_USE_ASAN).
user.mach1:cxxflags=["-O1", "-g", "-fno-omit-frame-pointer", "-march=x86-64-v2"]
user.mach1:cflags=["-O1", "-g", "-fno-omit-frame-pointer", "-march=x86-64-v2"]
user.mach1:sharedlinkflags=[]
user.mach1:exelinkflags=[]
