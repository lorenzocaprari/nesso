[settings]
os=Linux
arch=x86_64
compiler=gcc
compiler.version=15
compiler.libcxx=libstdc++11
compiler.cppstd=26
build_type=Release

[conf]
# AFL++ uses afl-clang-lto++ (fuzz targets never link the gcc-built ORT).
# Sanitizers stay out of the profile: scripts/fuzz-test sets AFL_USE_ASAN and AFL_USE_UBSAN.
# _GLIBCXX_ASSERTIONS enables libstdc++ contract checks in this fuzz build.
user.nesso:cxxflags=["-O1", "-g", "-fno-omit-frame-pointer", "-march=x86-64-v2", "-D_GLIBCXX_ASSERTIONS"]
user.nesso:cflags=["-O1", "-g", "-fno-omit-frame-pointer", "-march=x86-64-v2"]
user.nesso:sharedlinkflags=[]
user.nesso:exelinkflags=[]
