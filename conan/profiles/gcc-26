[settings]
os=Linux
arch=x86_64
compiler=gcc
compiler.version=15
compiler.libcxx=libstdc++11
compiler.cppstd=26
build_type=Release

[conf]
user.mach1:cxxflags=["-O3", "-march=native", "-flto=auto", "-fvisibility=hidden", "-DNDEBUG"]
user.mach1:cflags=["-O3", "-march=native", "-flto=auto", "-fvisibility=hidden", "-DNDEBUG"]
user.mach1:sharedlinkflags=["-flto=auto", "-Wl,-O1", "-Wl,--as-needed"]
user.mach1:exelinkflags=["-flto=auto", "-Wl,-O1", "-Wl,--as-needed"]
