# EL9 amd64 Release. The system compiler stays GCC 11; GCC Toolset 16.2.1
# (gcc-toolset-16-gcc-16.2.1-1.4.el9_9) lives under /opt/rh. Absolute paths
# keep Conan off /usr/bin/g++. compiler.version=16 is the settings.yml value;
# g++ -dumpversion prints 16 and -dumpfullversion prints 16.2.1.
# -march=x86-64-v2 matches gcc-26. That is the EL9 ISA baseline.

[settings]
os=Linux
arch=x86_64
compiler=gcc
compiler.version=16
compiler.libcxx=libstdc++11
compiler.cppstd=26
build_type=Release

[conf]
tools.build:compiler_executables={"c": "/opt/rh/gcc-toolset-16/root/usr/bin/gcc", "cpp": "/opt/rh/gcc-toolset-16/root/usr/bin/g++"}
# Same consumer-only hardening as gcc-26, including -fcf-protection=full.
user.nesso:cxxflags=["-O3", "-march=x86-64-v2", "-flto=auto", "-fvisibility=hidden", "-DNDEBUG", "-U_FORTIFY_SOURCE", "-D_FORTIFY_SOURCE=3", "-fstack-protector-strong", "-fstack-clash-protection", "-fcf-protection=full", "-fPIE", "-ftrivial-auto-var-init=zero"]
user.nesso:cflags=["-O3", "-march=x86-64-v2", "-flto=auto", "-fvisibility=hidden", "-DNDEBUG", "-U_FORTIFY_SOURCE", "-D_FORTIFY_SOURCE=3", "-fstack-protector-strong", "-fstack-clash-protection", "-fcf-protection=full", "-fPIE", "-ftrivial-auto-var-init=zero"]
user.nesso:sharedlinkflags=["-flto=auto", "-Wl,-O1", "-Wl,--as-needed", "-fcf-protection=full", "-Wl,-z,relro,-z,now,-z,noexecstack"]
user.nesso:exelinkflags=["-flto=auto", "-Wl,-O1", "-Wl,--as-needed", "-pie", "-fcf-protection=full", "-Wl,-z,relro,-z,now,-z,noexecstack"]

[buildenv]
CC=/opt/rh/gcc-toolset-16/root/usr/bin/gcc
CXX=/opt/rh/gcc-toolset-16/root/usr/bin/g++
