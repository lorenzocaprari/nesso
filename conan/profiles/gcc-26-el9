# EL9 amd64 Release. The system compiler stays GCC 11; GCC Toolset 15
# lives under /opt/rh. Absolute paths keep Conan off /usr/bin/g++.
# -march=x86-64-v2 matches gcc-26. That is the EL9 ISA baseline.

[settings]
os=Linux
arch=x86_64
compiler=gcc
compiler.version=15
compiler.libcxx=libstdc++11
compiler.cppstd=26
build_type=Release

[conf]
tools.build:compiler_executables={"c": "/opt/rh/gcc-toolset-15/root/usr/bin/gcc", "cpp": "/opt/rh/gcc-toolset-15/root/usr/bin/g++"}
user.nesso:cxxflags=["-O3", "-march=x86-64-v2", "-flto=auto", "-fvisibility=hidden", "-DNDEBUG"]
user.nesso:cflags=["-O3", "-march=x86-64-v2", "-flto=auto", "-fvisibility=hidden", "-DNDEBUG"]
user.nesso:sharedlinkflags=["-flto=auto", "-Wl,-O1", "-Wl,--as-needed"]
user.nesso:exelinkflags=["-flto=auto", "-Wl,-O1", "-Wl,--as-needed"]

[buildenv]
CC=/opt/rh/gcc-toolset-15/root/usr/bin/gcc
CXX=/opt/rh/gcc-toolset-15/root/usr/bin/g++
