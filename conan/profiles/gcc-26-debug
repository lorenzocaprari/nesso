[settings]
os=Linux
arch=x86_64
compiler=gcc
compiler.version=15
compiler.libcxx=libstdc++11
compiler.cppstd=26
build_type=Debug

[conf]
tools.build:cxxflags=["-g3", "-O0", "-fno-omit-frame-pointer", "-Wall", "-Wextra", "-Wpedantic", "-Wshadow", "-Wconversion", "-Wsign-conversion", "-D_GLIBCXX_DEBUG", "-D_GLIBCXX_DEBUG_PEDANTIC", "-fsanitize=address,undefined"]

tools.build:cflags=["-g3", "-O0", "-fno-omit-frame-pointer", "-Wall", "-Wextra", "-Wpedantic", "-fsanitize=address,undefined"]

tools.build:sharedlinkflags=["-fsanitize=address,undefined"]
tools.build:exelinkflags=["-fsanitize=address,undefined"]
