[settings]
os=Linux
arch=x86_64
compiler=gcc
compiler.version=15
compiler.libcxx=libstdc++11
compiler.cppstd=26
build_type=Debug
# Release binary matches gcc-26, so Debug/ASan builds do not carry ORT's debug info.
onnxruntime/*:build_type=Release

[conf]
# Consumer-only (other deps share a stable Debug package ID with coverage)
user.nesso:cxxflags=["-g3", "-O0", "-fno-omit-frame-pointer", "-Wall", "-Wextra", "-Wpedantic", "-Wshadow", "-Wconversion", "-Wsign-conversion", "-D_GLIBCXX_DEBUG", "-D_GLIBCXX_DEBUG_PEDANTIC", "-fsanitize=address,undefined"]
user.nesso:cflags=["-g3", "-O0", "-fno-omit-frame-pointer", "-Wall", "-Wextra", "-Wpedantic", "-fsanitize=address,undefined"]
user.nesso:sharedlinkflags=["-fsanitize=address,undefined"]
user.nesso:exelinkflags=["-fsanitize=address,undefined"]
