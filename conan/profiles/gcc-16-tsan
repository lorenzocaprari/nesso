# GCC Toolset 16 ThreadSanitizer preview.
# settings match gcc-16 so --no-remote reuses the Release packages baked
# in the preview image. Dependencies are not instrumented. Run ctest -L tsan
# only. No -flto. -Werror is not set here.

[settings]
os=Linux
arch=x86_64
compiler=gcc
compiler.version=16
compiler.libcxx=libstdc++11
compiler.cppstd=26
build_type=Release

[conf]
tools.build:compiler_executables={"c": "/opt/rh/gcc-toolset-16/root/usr/bin/gcc", "cpp": "/opt/rh/gcc-toolset-16/root/usr/bin/g++"}
user.nesso:cxxflags=["-O3", "-g", "-march=x86-64-v2", "-fvisibility=hidden", "-DNDEBUG", "-fno-omit-frame-pointer", "-fsanitize=thread", "-fno-sanitize-recover=all"]
user.nesso:cflags=["-O3", "-g", "-march=x86-64-v2", "-fvisibility=hidden", "-DNDEBUG", "-fno-omit-frame-pointer", "-fsanitize=thread", "-fno-sanitize-recover=all"]
user.nesso:sharedlinkflags=["-fsanitize=thread", "-Wl,-O1", "-Wl,--as-needed"]
user.nesso:exelinkflags=["-fsanitize=thread", "-Wl,-O1", "-Wl,--as-needed"]

[buildenv]
CC=/opt/rh/gcc-toolset-16/root/usr/bin/gcc
CXX=/opt/rh/gcc-toolset-16/root/usr/bin/g++
