# Clang 23.1.6 + libstdc++ (the GCC 15 ABI), C++26, ThreadSanitizer.
#
# settings.compiler stays gcc/15/libstdc++11 on purpose, same as clang-23,
# so --no-remote reuses the gcc-26 Release cache. libc++ is a different ABI.
# No -flto. -Werror is not set here. Run ctest -L tsan only. Tests that
# open ONNX Runtime sessions stay out: those threads are not instrumented.

[settings]
os=Linux
arch=x86_64
compiler=gcc
compiler.version=15
compiler.libcxx=libstdc++11
compiler.cppstd=26
build_type=Release

[conf]
tools.build:compiler_executables={"c": "clang-23", "cpp": "clang++-23"}
user.nesso:cxxflags=["-O3", "-g", "-march=x86-64-v2", "-stdlib=libstdc++", "-fvisibility=hidden", "-DNDEBUG", "-fno-omit-frame-pointer", "-fsanitize=thread", "-fno-sanitize-recover=all"]
user.nesso:cflags=["-O3", "-g", "-march=x86-64-v2", "-fvisibility=hidden", "-DNDEBUG", "-fno-omit-frame-pointer", "-fsanitize=thread", "-fno-sanitize-recover=all"]
user.nesso:sharedlinkflags=["-fsanitize=thread", "-Wl,-O1", "-Wl,--as-needed"]
user.nesso:exelinkflags=["-stdlib=libstdc++", "-fsanitize=thread", "-Wl,-O1", "-Wl,--as-needed"]

[buildenv]
CC=clang-23
CXX=clang++-23
